{
	chapter_group.4CEE79D03F629AA8.title: "Start Here"
	chapter_group.577AA6560051154F.title: "Early Tech"
	chapter_group.487F9426BD01CD7B.title: "Industry"
	chapter_group.4DF6F75C72654E2C.title: "Branches"
	chapter_group.0B2239FCA45AFB0D.title: "Society"
	chapter.72088DC60A8C296A.title: "Welcome"
	chapter.72088DC60A8C296A.chapter_subtitle: ["How to read this book, where to look things up, and a map of the whole road."]
	quest.30CB4A45168F0D0D.title: "How This Book Works"
	quest.30CB4A45168F0D0D.quest_subtitle: "Read me first"
	quest.30CB4A45168F0D0D.quest_desc: ["Each chapter has a main line that runs from left to right. Follow it and you will not miss a step. Everything above and below the line is a side step, and most of it can wait.", "", "The shape tells you what a quest is. A &6large square&r is a milestone. A &6circle&r is a step. A &6diamond&r explains how something works, and you tick it once you have read it. A &6hexagon&r points to another chapter. A &6small square&r is optional. The &6gear&r at the end closes the chapter.", "", "Quests only look in your inventory and nothing is taken from you. A few steps make a liquid or a gas, which the book cannot see, so those are ticked by hand.", "", "Lines show what a quest needs, and along the main line they also give the order to work in. A quest with no line into it is open from the start: it sits beside the quest that needs it.", "", "The hexagons below this quest are the chapters, in the order they open.", "", "&7Tick this to start."]
	quest.343EF2C36FA226ED.title: "The Field Guide"
	quest.343EF2C36FA226ED.quest_subtitle: "Everything TFC, in one book"
	quest.343EF2C36FA226ED.quest_desc: ["TerraFirmaCraft's &6field guide&r explains every mechanic and multiblock in detail, with pictures. The &6Materialism Guide&r inside it covers what this pack changes: ore veins, metals, machines and the settlers.", "", "The quests tell you what to do next and why. The field guide tells you exactly how. When a quest says to see the field guide, this is where to look."]
	quest.5284FFE7C905956E.title: "Looking Up Recipes"
	quest.5284FFE7C905956E.quest_subtitle: "R for recipe, U for uses"
	quest.5284FFE7C905956E.quest_desc: ["Hover over any item and press R to see how it is made, or U to see what it is used for. Clicking an item in a quest task does the same.", "", "Many recipes here are long chains, so follow them back one step at a time. For any Create machine, hover it and hold [W] to watch a short demonstration."]
	quest.320B62CBA91D29EA.title: "Playing Together"
	quest.320B62CBA91D29EA.quest_subtitle: "Split the work"
	quest.320B62CBA91D29EA.quest_desc: ["On a server, nobody has to do everything. Early Tech is shared ground. After that, a town does better when one player takes up metals, another chemistry, another farming or trains.", "", "Quests are counted per team, so join a team to share progress."]
	quest.0800028CAC1608BE.title: "Stone Age"
	quest.0800028CAC1608BE.quest_subtitle: "Early Tech, chapter 1"
	quest.0800028CAC1608BE.quest_desc: ["Knapping, fire, food, clay and the pit kiln, with the survival mechanics where they first bite.", "", "&7Opens after How This Book Works, in Welcome. Tick this when you start the chapter."]
	quest.5E86C5B0155AC3BC.title: "Copper Age"
	quest.5E86C5B0155AC3BC.quest_subtitle: "Early Tech, chapter 2"
	quest.5E86C5B0155AC3BC.quest_desc: ["Surface tells, ore grades, molds, the first metal, cast tools, prospecting, the quern and ore powders.", "", "&7Opens after First Ceramics, in Stone Age. Tick this when you start the chapter."]
	quest.1F15DFD8AD1CE3B9.title: "Forge \\& Bronze"
	quest.1F15DFD8AD1CE3B9.quest_subtitle: "Early Tech, chapter 3"
	quest.1F15DFD8AD1CE3B9.quest_desc: ["Charcoal, the forge, flux and welding, the copper anvil, then alloying, the bronze anvil, fire clay and the crucible. First metal weapons and armour.", "", "&7Opens after A Copper Ingot, in Copper Age. Tick this when you start the chapter."]
	quest.57ADC6BFF6D90F0E.title: "Home \\& Workshop"
	quest.57ADC6BFF6D90F0E.quest_subtitle: "Early Tech, chapter 4"
	quest.57ADC6BFF6D90F0E.quest_desc: ["Lumber and the barrel, then leather step by step, with paper, cloth, flasks and carts on the side. It ends with the bellows your forge is waiting for.", "", "&7Opens after The Saw, in Copper Age. Tick this when you start the chapter."]
	quest.3152D4D0490E2E2F.title: "Farm \\& Kitchen"
	quest.3152D4D0490E2E2F.quest_subtitle: "Early Tech, chapter 5"
	quest.3152D4D0490E2E2F.quest_desc: ["A field and the road from grain to flatbread and then to real bread, with animals, wool and cheese below, and the ways to make food last.", "", "&7Opens after A Complete Toolkit, in Stone Age. Tick this when you start the chapter."]
	quest.2C5813BD42BA0502.title: "Iron \\& Steel"
	quest.2C5813BD42BA0502.quest_subtitle: "Early Tech, chapter 6"
	quest.2C5813BD42BA0502.quest_desc: ["One long line: the bloomery and wrought iron, the blast furnace and pig iron, then steel, its anvil and the first rods.", "", "&7Opens after The Bronze Anvil, in Forge \\& Bronze. Tick this when you start the chapter."]
	quest.0C7AE9B338FF1C99.title: "Machine Materials"
	quest.0C7AE9B338FF1C99.quest_subtitle: "Early Tech, chapter 7"
	quest.0C7AE9B338FF1C99.quest_desc: ["A real mine fans out into the deep veins. Follow each line to what the first machines are built from: rubber, aluminium casings, the electron tube, glass and brass.", "", "&7Opens after Finding Veins, in Copper Age. Tick this when you start the chapter."]
	quest.01C170325F6A5B98.title: "First Machines"
	quest.01C170325F6A5B98.quest_subtitle: "Early Tech, chapter 8"
	quest.01C170325F6A5B98.quest_desc: ["From the first shaft to a steam engine on a boiler.", "", "&7Opens after Steel Rods, in Iron \\& Steel. Tick this when you start the chapter."]
	quest.0D1A87ACA67D7CED.title: "Metallurgy"
	quest.0D1A87ACA67D7CED.quest_subtitle: "Industry, chapter 1"
	quest.0D1A87ACA67D7CED.quest_desc: ["The last of the hand work: black steel, red or blue steel and their anvils on the top line, tungsten from the bloomery below, meeting in tungsten steel.", "", "&7Opens after A Steel Ingot, in Iron \\& Steel. Tick this when you start the chapter."]
	quest.0202CF51CCBF270A.title: "Mechanical Engineering"
	quest.0202CF51CCBF270A.quest_subtitle: "Industry, chapter 2"
	quest.0202CF51CCBF270A.quest_desc: ["Springs and the precision mechanism, then the lathe, and behind it the press, pipes, the pump, the compressor and the drill.", "", "&7Opens after Engines on the Boiler, in First Machines. Tick this when you start the chapter."]
	quest.05DDC84517618FA1.title: "Oil \\& Heavy Industry"
	quest.05DDC84517618FA1.quest_subtitle: "Industry, chapter 3"
	quest.05DDC84517618FA1.quest_desc: ["Steel casings and the first chemical vat, coke and the industrial blast furnace, then oil: finding it, pumping it and distilling it.", "", "&7Opens after Engines on the Boiler, in First Machines. Tick this when you start the chapter."]
	quest.776BC27E26363F39.title: "Electricity"
	quest.776BC27E26363F39.quest_subtitle: "Industry, chapter 4"
	quest.776BC27E26363F39.quest_desc: ["Everything on this page feeds one quest. The converter and its parts come in from the left, the generator coil from below, brushes and magnets from the side, and they meet in your first current.", "", "&7Opens after The Compressor, in Mechanical Engineering. Tick this when you start the chapter."]
	quest.3964A93899BCD358.title: "Power Grid"
	quest.3964A93899BCD358.quest_subtitle: "Industry, chapter 5"
	quest.3964A93899BCD358.quest_desc: ["Carrying current: insulation, earthing, protection, storage and the transformer, with poles, lamps and heaters on the side.", "", "&7Opens after First Current, in Electricity. Tick this when you start the chapter."]
	quest.594E19B848BC5DFF.title: "Chemistry"
	quest.594E19B848BC5DFF.quest_subtitle: "Industry, chapter 6"
	quest.594E19B848BC5DFF.quest_desc: ["Sulfuric acid and what it opens on the top line, the gases that need electricity on the bottom one. They meet in tantalum, the steel vat and the first plastic.", "", "&7Opens after The Industrial Blast Furnace, in Oil \\& Heavy Industry. Tick this when you start the chapter."]
	quest.35E77205BB96E459.title: "Electronics \\& Magnets"
	quest.35E77205BB96E459.quest_subtitle: "Industry, chapter 7"
	quest.35E77205BB96E459.quest_desc: ["Silicon to the circuit board on the top line, resistors, capacitors and the stronger magnets on the bottom one. Together they build the fireproof vat.", "", "&7Opens after The Steel Chemical Vat, in Chemistry. Tick this when you start the chapter."]
	quest.2D72DECB106E563C.title: "Ore Processing"
	quest.2D72DECB106E563C.quest_subtitle: "Industry, chapter 8"
	quest.2D72DECB106E563C.quest_desc: ["The door to industrial metallurgy: why some ores defeat the forge, crushing, acid leaching and the arc furnace.", "", "&7Opens after Sulfuric Acid, in Chemistry. Tick this when you start the chapter."]
	quest.3726253373B8F091.title: "Light Metals"
	quest.3726253373B8F091.quest_subtitle: "Industry, chapter 9"
	quest.3726253373B8F091.quest_desc: ["Aluminium by the Bayer and Hall-Heroult processes, titanium by the Kroll process with its magnesium loop, then lithium and beryllium.", "", "&7Opens after Crushing Ore to Powder, in Ore Processing. Tick this when you start the chapter."]
	quest.783AAC21B793E1A9.title: "Rare Metals"
	quest.783AAC21B793E1A9.quest_subtitle: "Industry, chapter 10"
	quest.783AAC21B793E1A9.quest_desc: ["One short line per metal: tungsten, boron and cobalt from crushed ore, thorium, uranium and the platinum metals from the acids, then niobium and high alloy steel.", "", "&7Opens after Crushing Ore to Powder, in Ore Processing. Tick this when you start the chapter."]
	quest.6139F5006D4841F9.title: "Energy Sources"
	quest.6139F5006D4841F9.quest_subtitle: "Industry, chapter 11"
	quest.6139F5006D4841F9.quest_desc: ["Steam turbines and what to do with their exhaust on the top line, concentrated sunlight in the middle, photovoltaics at the bottom.", "", "&7Opens after Fluid Pipes, in Mechanical Engineering. Tick this when you start the chapter."]
	quest.618C52C266D993E0.title: "Nuclear Power"
	quest.618C52C266D993E0.quest_subtitle: "Industry, chapter 12"
	quest.618C52C266D993E0.quest_desc: ["Fission on the top lines, where thorium and zircaloy meet in the fuel. Fusion on the bottom one, by way of the particle accelerator.", "", "&7Opens after Zirconium Sponge, in Light Metals. Tick this when you start the chapter."]
	quest.3F920B998CF24A25.title: "Logistics"
	quest.3F920B998CF24A25.quest_subtitle: "A branch"
	quest.3F920B998CF24A25.quest_desc: ["Filters, arms and vaults, then packages: a warehouse that sends what you ask for.", "", "&7Opens after Depots, Funnels and Chutes, in First Machines. Tick this when you start the chapter."]
	quest.11A7133F6159B538.title: "Agriculture"
	quest.11A7133F6159B538.quest_subtitle: "A branch"
	quest.11A7133F6159B538.quest_desc: ["Three things beeswax opens at the top, the greenhouse and its irrigation in the middle, farming machines below.", "", "&7Opens after Beeswax, in Machine Materials. Tick this when you start the chapter."]
	quest.7FFA2E7EAE495CAF.title: "Transport"
	quest.7FFA2E7EAE495CAF.quest_subtitle: "A branch"
	quest.7FFA2E7EAE495CAF.quest_desc: ["Railways on the top line, with electric traction above them. Airship parts and road vehicles below.", "", "&7Opens after The Mechanical Press, in Mechanical Engineering. Tick this when you start the chapter."]
	quest.63E08BEE0D1D03B2.title: "Warfare"
	quest.63E08BEE0D1D03B2.quest_subtitle: "A branch"
	quest.63E08BEE0D1D03B2.quest_desc: ["Gunpowder, a cannon and its mount, shot and charges, and the first shot fired.", "", "&7Opens after The Mechanical Mixer, in First Machines. Tick this when you start the chapter."]
	quest.4201413A13803B27.title: "Settlers \\& Society"
	quest.4201413A13803B27.quest_subtitle: "A branch"
	quest.4201413A13803B27.quest_desc: ["The Leader's Staff, the first settlers and their needs, then workers, specialists, elites, trade and a leader.", "", "&7Opens after Gold, in Machine Materials. Tick this when you start the chapter."]
	chapter.5440D2BBA9D4F70D.title: "Stone Age"
	chapter.5440D2BBA9D4F70D.chapter_subtitle: ["Knapping, fire, food, clay and the pit kiln, with the survival mechanics where they first bite."]
	quest.63814592AC515CCC.title: "Loose Rocks"
	quest.63814592AC515CCC.quest_subtitle: "Everything starts on the ground"
	quest.63814592AC515CCC.quest_desc: ["Before you can make anything, you need stone. Loose rocks lie on the surface almost everywhere, so just pick them up. You need two in hand to knap."]
	task.33A9ACB9A84FDB1C.title: "Any Rock"
	quest.0A5AF9F61E8E9C5C.title: "Sticks"
	quest.0A5AF9F61E8E9C5C.quest_subtitle: "Handles for everything you knap"
	quest.0A5AF9F61E8E9C5C.quest_desc: ["A tool head is only half a tool. Pick up sticks from the ground, or break them off bushes and dead branches."]
	quest.3646D57E5E9C5992.title: "Mechanic: Thirst"
	quest.3646D57E5E9C5992.quest_subtitle: "Another bar to keep full"
	quest.3646D57E5E9C5992.quest_desc: ["You get thirsty, and faster in the heat. Drink from rivers and lakes with an empty hand, but not from the sea: salt water makes it worse. Carry water once you can."]
	quest.356052A1AF16E100.title: "A Knife Head"
	quest.356052A1AF16E100.quest_subtitle: "Rock in, tool head out"
	quest.356052A1AF16E100.quest_desc: ["Hold two rocks and strike away pieces in the knapping grid. A knife head is the simplest shape to start with.", "", "&7Press R on a knife head to see the pattern."]
	task.5D9F7B6E6878E928.title: "Any Stone Knife Head"
	quest.4210C888F8F9C9F7.title: "A Stone Knife"
	quest.4210C888F8F9C9F7.quest_subtitle: "Rock in, tool head out"
	quest.4210C888F8F9C9F7.quest_desc: ["Put a stick on the knife head. It cuts straw, skins hides and opens most of what follows."]
	task.4C527DA4EE8C5247.title: "Any Stone Knife"
	quest.59D5D30E0A271647.title: "Straw"
	quest.59D5D30E0A271647.quest_subtitle: "Cut from tall grass"
	quest.59D5D30E0A271647.quest_desc: ["Use your knife on tall grass and similar plants. Straw thatches roofs, lines pit kilns and starts fires."]
	quest.351E6F92F1937FD5.title: "Thatch"
	quest.351E6F92F1937FD5.quest_subtitle: "Four straw, woven together"
	quest.351E6F92F1937FD5.quest_desc: ["A light, quick building block, and half of a proper bed.", "", "It also makes a quick roof for a first shelter."]
	quest.6F785FFF439381C0.title: "A Place to Sleep"
	quest.6F785FFF439381C0.quest_subtitle: "Thatch and a hide"
	quest.6F785FFF439381C0.quest_desc: ["With thatch and a large hide, make a bed where you stand. Sleeping skips the most dangerous hours.", "", "The bed takes thatch and one large hide, so hunt before nightfall."]
	quest.282C02D8D811E088.title: "Mechanic: Sleep"
	quest.282C02D8D811E088.quest_subtitle: "A safe night"
	quest.282C02D8D811E088.quest_desc: ["Sleeping skips the most dangerous hours, but only in a bed. A thatch bed is the first, and a proper bed later is warmer and safer."]
	quest.30D0332D6C6AC8CE.title: "Dress for the Weather"
	quest.30D0332D6C6AC8CE.quest_subtitle: "Body heat matters"
	quest.30D0332D6C6AC8CE.quest_desc: ["Your body temperature counts here, so wear what suits the climate. A straw hat keeps the sun off, and insulated hide keeps the cold out."]
	quest.4B85810463430E6C.title: "Mechanic: Body Temperature"
	quest.4B85810463430E6C.quest_subtitle: "Hypo- and hyperthermia"
	quest.4B85810463430E6C.quest_desc: ["Your body temperature follows the weather, the season, the time of day and what you wear. Fires and shelter warm you, and shade and water cool you. Dress for where you live."]
	quest.3F366ACAF62928BC.title: "A Large Hide"
	quest.3F366ACAF62928BC.quest_subtitle: "Hunt, then skin"
	quest.3F366ACAF62928BC.quest_desc: ["Hunt a large animal and take its hide. This is also your first step towards leather."]
	quest.20EC2F4EC5239449.title: "Primitive Insulation"
	quest.20EC2F4EC5239449.quest_subtitle: "Raw hide, tied on"
	quest.20EC2F4EC5239449.quest_desc: ["Stuff a raw hide with straw into primitive insulation, then knap it into rough clothes. Better than nothing in the first winter."]
	task.4FFA87E68FF451B4.title: "Any Primitive Clothing"
	quest.1B09FBBAAEF21F2C.title: "A Javelin"
	quest.1B09FBBAAEF21F2C.quest_subtitle: "Stone, thrown"
	quest.1B09FBBAAEF21F2C.quest_desc: ["Knap a javelin head. It hits hard and you can pick it up again."]
	task.61CC8A990042EB5E.title: "Any Stone Javelin"
	quest.6B0B39E57650848D.title: "More Tool Heads"
	quest.6B0B39E57650848D.quest_subtitle: "Axe, shovel, hammer, hoe"
	quest.6B0B39E57650848D.quest_desc: ["Knap the other stone heads. Each one is a different pattern in the knapping grid."]
	task.17AA630459BBAADE.title: "Any Stone Axe Head"
	task.4DA9E7BC8246A4AB.title: "Any Stone Shovel Head"
	task.513D5F02CDE8DB37.title: "Any Stone Hammer Head"
	task.794D5EB5C11966E8.title: "Any Stone Hoe Head"
	quest.350143738DB87511.title: "A Complete Toolkit"
	quest.350143738DB87511.quest_subtitle: "Axe, shovel, hammer, hoe"
	quest.350143738DB87511.quest_desc: ["Fit each head with a stick. The axe fells trees, the shovel digs clay, the hammer makes anvils and flux, and the hoe works soil."]
	task.4453B0BA907DE840.title: "Any Stone Axe"
	task.51555550D24E250B.title: "Any Stone Shovel"
	task.7FD0049844710369.title: "Any Stone Hammer"
	task.7CA50BA72872A1A4.title: "Any Stone Hoe"
	quest.72BADFB09AEEFA67.title: "Logs"
	quest.72BADFB09AEEFA67.quest_subtitle: "Fell a tree"
	quest.72BADFB09AEEFA67.quest_desc: ["Fuel, lumber, charcoal and barrels all start here. Any tree will do.", "", "An axe fells the whole tree from its lowest log."]
	task.2BCAC9B998A910AF.title: "Any Logs"
	quest.0E535A484B38125D.title: "The Firestarter"
	quest.0E535A484B38125D.quest_subtitle: "Two sticks and patience"
	quest.0E535A484B38125D.quest_desc: ["Craft a firestarter from sticks. Fire is what everything else in this chapter is waiting for.", "", "Hold right-click on the ground with it. It can take several tries."]
	quest.2262D343D407FBEF.title: "The Firepit"
	quest.2262D343D407FBEF.quest_subtitle: "Your first real heat source"
	quest.2262D343D407FBEF.quest_desc: ["Drop sticks and straw on the ground with a log, and use the firestarter. A firepit cooks food, gives warmth and takes a pot or a grill later."]
	quest.49151E9FA8A685C2.title: "Cooking"
	quest.49151E9FA8A685C2.quest_subtitle: "Don't eat it raw"
	quest.49151E9FA8A685C2.quest_desc: ["Cook meat on a lit firepit. Cooked food is safer, keeps longer and feeds you better."]
	task.4E3C2726B7648B6A.title: "Any Cooked Meat"
	quest.19BCC26B32B625A4.title: "Mechanic: Nutrition"
	quest.19BCC26B32B625A4.quest_subtitle: "Steak alone won't do"
	quest.19BCC26B32B625A4.quest_desc: ["Food has five groups: grain, fruit, vegetables, protein and dairy. Your maximum health follows how balanced your diet is, so eat a bit of everything. Meals, sandwiches and soups pack several groups into one item."]
	quest.2E1D71A8F754F827.title: "Clay"
	quest.2E1D71A8F754F827.quest_subtitle: "Look for the surface tell"
	quest.2E1D71A8F754F827.quest_desc: ["Clay patches are marked by certain plants nearby. Dig them with your shovel, and take plenty.", "", "You will need far more clay than you expect: every mold and vessel in the next chapter is made of it."]
	quest.1DEFADF2F889EC02.title: "Shaping a Vessel"
	quest.1DEFADF2F889EC02.quest_subtitle: "Clay, worked by hand"
	quest.1DEFADF2F889EC02.quest_desc: ["Knap clay in your hand into an unfired vessel. It has to be fired before you can use it."]
	quest.5925F0B92EBEF6B3.title: "The Pit Kiln"
	quest.5925F0B92EBEF6B3.quest_subtitle: "Fire without a real kiln"
	quest.5925F0B92EBEF6B3.quest_desc: ["Dig a shallow pit, place your unfired clay in it, then cover it with straw and logs and light it. It is slow, but it gets hot enough to melt most metals in a vessel.", "", "Use the firestarter on the logs to light it. It burns for hours, and what is left in the pit is fired pottery.", "", "&7A pit kiln reaches almost 1600 °C. Later it melts copper, bronze and even iron in a vessel, long before you own a forge."]
	quest.6C5D7551D36973E9.title: "A Jug"
	quest.6C5D7551D36973E9.quest_subtitle: "Water you can carry"
	quest.6C5D7551D36973E9.quest_desc: ["You get thirsty here. A fired jug carries water with you, so you can leave the river behind."]
	quest.1E09D11E3BB760BE.title: "First Ceramics"
	quest.1E09D11E3BB760BE.quest_subtitle: "Vessels, jugs and molds"
	quest.1E09D11E3BB760BE.quest_desc: ["A fired vessel stores food, and it holds molten metal for casting.", "", "With a vessel in your hands the Stone Age is over. The next chapter, &6Copper Age&r, fills it with ore."]
	chapter.6FF7B79A48B3DB3D.title: "Copper Age"
	chapter.6FF7B79A48B3DB3D.chapter_subtitle: ["Surface tells, ore grades, molds, the first metal, cast tools, prospecting, the quern and ore powders."]
	quest.5F85A814E91061BD.title: "Surface Tells"
	quest.5F85A814E91061BD.quest_subtitle: "Ore lying on the ground"
	quest.5F85A814E91061BD.quest_desc: ["Small ore pieces on the surface are real ore, and they mean a vein lies somewhere below. Look for native copper, malachite or tetrahedrite. Ten pieces melt into exactly one ingot.", "", "The pieces weather out of the vein, so it usually lies below or close to where they are thickest."]
	task.3AF6D8A11D002493.title: "Any Small Copper Ore"
	quest.300538F0CC45A949.title: "Mechanic: Ore Grades"
	quest.300538F0CC45A949.quest_subtitle: "Small, poor, normal, rich"
	quest.300538F0CC45A949.quest_desc: ["Ore comes in grades. A small piece melts to 10 mB, and poor, normal and rich ore to more each step up: 35 mB for rich malachite. A propick reading tells you which grades are around."]
	quest.06A47D11DC61382D.title: "Panning"
	quest.06A47D11DC61382D.quest_subtitle: "Ore from river gravel"
	quest.06A47D11DC61382D.quest_desc: ["A fired clay pan, used on ore-bearing gravel deposits in rivers, sifts out small ore pieces."]
	quest.5D9CEC2405F911FD.title: "Shaping a Mold"
	quest.5D9CEC2405F911FD.quest_subtitle: "Clay, knapped"
	quest.5D9CEC2405F911FD.quest_desc: ["Knap clay into an ingot mold. Like a vessel, it must be fired before it holds metal."]
	quest.2BC103FC65D2E80F.title: "An Ingot Mold"
	quest.2BC103FC65D2E80F.quest_subtitle: "Shaped from clay, fired like a vessel"
	quest.2BC103FC65D2E80F.quest_desc: ["Knap clay into an ingot mold and fire it in a pit kiln.", "", "Each mold holds 100 mB, which is exactly one ingot."]
	quest.6BEC728503B8AF4B.title: "Mechanic: Hot Items"
	quest.6BEC728503B8AF4B.quest_subtitle: "Stop burning your hands"
	quest.6BEC728503B8AF4B.quest_desc: ["Hot metal, molds and vessels burn you if you hold them bare-handed. Mittens knapped from leather or a pair of tongs let you carry them safely."]
	quest.3C2CD841DDF4C6D4.title: "Tongs"
	quest.3C2CD841DDF4C6D4.quest_subtitle: "Better than mittens"
	quest.3C2CD841DDF4C6D4.quest_desc: ["Wooden tongs come first, and metal ones last much longer."]
	task.0BD8BF62FD3C2CC1.title: "Any Tongs"
	quest.252DCBC3CE3A5C33.title: "A Copper Ingot"
	quest.252DCBC3CE3A5C33.quest_subtitle: "Your first real metal"
	quest.252DCBC3CE3A5C33.quest_desc: ["Fill a vessel with ore and heat it in a pit kiln until it melts. Then pour the melt into your mold. Nearly all metal from here on starts the same way.", "", "Put the ore in the vessel, put the vessel in a pit kiln, and fire it. While the metal is still liquid, right-click the vessel in your hand and pour it into the mold.", "", "&7Ten small pieces make one ingot. A vessel takes four stacks, so fill it."]
	quest.77D5601EE082F689.title: "Melting Ore"
	quest.77D5601EE082F689.quest_subtitle: "The simplest way"
	quest.77D5601EE082F689.quest_desc: ["Ore melts straight into metal in a vessel or crucible. Most of your metal will come this way for a long time."]
	quest.1E99D0D162476EE7.title: "Tool Head Molds"
	quest.1E99D0D162476EE7.quest_subtitle: "One mold per tool shape"
	quest.1E99D0D162476EE7.quest_desc: ["Knap and fire a mold for each tool head you want. They work the same way as the ingot mold."]
	quest.339E594BB30A4498.title: "Casting Tool Heads"
	quest.339E594BB30A4498.quest_subtitle: "Pour into the mold"
	quest.339E594BB30A4498.quest_desc: ["Fill a tool mold with molten copper from a vessel and let it set. Break the mold open, or keep it if it survives, and you have a metal head.", "", "You need four heads in the end: pickaxe, prospector's pick, saw and chisel."]
	task.593159A18565F052.title: "Any Casting Tool Heads"
	quest.048F5A9A69345557.title: "The Chisel"
	quest.048F5A9A69345557.quest_subtitle: "Smooth stone and cut parts"
	quest.048F5A9A69345557.quest_desc: ["Chisels smooth rock, and much later they cut your first shafts.", "", "With a hammer in your other hand it shapes blocks into stairs, slabs and smooth stone."]
	task.6F02563047A1CD3F.title: "Any Chisel"
	quest.0D809F0F7EE56D13.title: "The Quern"
	quest.0D809F0F7EE56D13.quest_subtitle: "Three smooth stones, three raw"
	quest.0D809F0F7EE56D13.quest_desc: ["Grain, graphite and most minerals are ground here. Chisel smooth stone for it.", "", "Set the handstone on top and right-click to turn it. Besides flour it gives graphite powder, flux from borax and the ore powders at the end of this line."]
	quest.24FCCA662E4951DA.title: "Ore Powders"
	quest.24FCCA662E4951DA.quest_subtitle: "Ground on the quern"
	quest.24FCCA662E4951DA.quest_desc: ["Grinding ore gives powder: two for a small piece, up to seven for rich ore. Powders don't melt, but chemistry and the industrial blast furnace use them."]
	task.593900AD802E7355.title: "Any Powder"
	quest.704D22EC1A97FEC4.title: "Metal Dust"
	quest.704D22EC1A97FEC4.quest_subtitle: "An ingot, ground"
	quest.704D22EC1A97FEC4.quest_desc: ["Grind a metal ingot on a quern or crushing wheels into twenty dust. Carbon brushes, alloys and catalysts take dust instead of ingots."]
	quest.793D0625A66AE2A8.title: "The Saw"
	quest.793D0625A66AE2A8.quest_subtitle: "Unlocks lumber"
	quest.793D0625A66AE2A8.quest_desc: ["Nothing before this can make lumber: there is no stone saw.", "", "Lumber, support beams, barrels and looms all wait for it. &6Home \\& Workshop&r opens here."]
	task.7C01C5936030E984.title: "Any Saw"
	quest.5CC3E6CA07BE0312.title: "A Bow"
	quest.5CC3E6CA07BE0312.quest_subtitle: "Reach out"
	quest.5CC3E6CA07BE0312.quest_desc: ["Bows and arrows work as you'd expect, and they cost less metal."]
	quest.07E99D4D087CE8F0.title: "The Pickaxe"
	quest.07E99D4D087CE8F0.quest_subtitle: "Now you can mine"
	quest.07E99D4D087CE8F0.quest_desc: ["Cast a pickaxe head and add a stick. There is no stone pickaxe, so nothing below the surface can be mined until now."]
	task.1584DBF4B9504167.title: "Any Pickaxe"
	quest.73B4D7C54619B949.title: "The Prospector's Pick"
	quest.73B4D7C54619B949.quest_subtitle: "No more guessing"
	quest.73B4D7C54619B949.quest_desc: ["Right-click rock with it to read what ore lies nearby.", "", "The reading is rough: it tells you something is near, and how much, but not where. Take readings in a line and follow them as they get stronger."]
	task.556D923548D5C8B1.title: "Any Prospector's Pick"
	quest.5D3ADCC4ECED777F.title: "Finding Veins"
	quest.5D3ADCC4ECED777F.quest_subtitle: "Put the pick to work"
	quest.5D3ADCC4ECED777F.quest_desc: ["Each rock type carries its own minerals, and the layers you see on a cliff continue underground. Follow your readings until the pick reports a vein underfoot.", "", "Surface copper runs out quickly. A vein you have dug into feeds your forge for a long time, and every later metal is found the same way.", "", "&7Field guide: Materialism Guide, Ore Generation lists every vein, its rocks and its depth."]
	chapter.4F8D8F7E93FD13E7.title: "Forge \\& Bronze"
	chapter.4F8D8F7E93FD13E7.chapter_subtitle: ["Charcoal, the forge, flux and welding, the copper anvil, then alloying, the bronze anvil, fire clay and the crucible. First metal weapons and armour."]
	quest.511EABEA0E823FBC.title: "The Stone Anvil"
	quest.511EABEA0E823FBC.quest_subtitle: "Right-click, don't craft"
	quest.511EABEA0E823FBC.quest_desc: ["No recipe makes this. Right-click the top of raw igneous rock with a hammer and it becomes an anvil. It is too weak to forge metal, but it can weld two ingots into one."]
	quest.1975673D8698942D.title: "The Charcoal Pit"
	quest.1975673D8698942D.quest_subtitle: "Logs, buried and lit"
	quest.1975673D8698942D.quest_desc: ["Stack logs into a log pile, cover it completely with dirt or other blocks so no air gets in, and light it. Starved of air, it smoulders into a charcoal pile over several hours.", "", "Any gap lets the fire out and the logs burn to nothing, so check the corners."]
	quest.54DE10867CF49C2E.title: "Charcoal"
	quest.54DE10867CF49C2E.quest_subtitle: "Bury logs, then burn them slow"
	quest.54DE10867CF49C2E.quest_desc: ["Dig out the finished pile. Charcoal burns far hotter than wood, and every forge runs on it."]
	quest.6285A50D84BBC917.title: "The Charcoal Forge"
	quest.6285A50D84BBC917.quest_subtitle: "Five stones and a hot pile"
	quest.6285A50D84BBC917.quest_desc: ["Surround a deep charcoal pile with five stone blocks and light it. It needs open sky above it to draw properly.", "", "Dig a hole one block deep, fill it with at least seven layers of charcoal, and use the firestarter on it. The forge heats what you put in it and, unlike a pit kiln, you control it."]
	quest.74D154BE8FF2868F.title: "Mechanic: Working Temperature"
	quest.74D154BE8FF2868F.quest_subtitle: "Hot enough, not too hot"
	quest.74D154BE8FF2868F.quest_desc: ["Metal can only be worked on the anvil while it is above its working temperature, and welding needs it hotter. The tooltip colour tells you how hot an item is. Too hot and it melts in the forge."]
	quest.3D30067DA7362B13.title: "Flux"
	quest.3D30067DA7362B13.quest_subtitle: "Crushed fluxstone"
	quest.3D30067DA7362B13.quest_desc: ["Crush fluxstone with a hammer. Every weld needs flux, starting with your first double ingot, and limewater needs it too.", "", "Limestone, dolomite, chalk and marble are fluxstones. Borax works too."]
	quest.39C301D72E8E48BF.title: "A Double Ingot"
	quest.39C301D72E8E48BF.quest_subtitle: "Weld two into one"
	quest.39C301D72E8E48BF.quest_desc: ["Heat two copper ingots to welding temperature and weld them with flux on the stone anvil. This is the one job a stone anvil does well.", "", "Seven double ingots make an anvil, so this is fourteen ingots of copper."]
	quest.37503E08F44B82E2.title: "The Copper Anvil"
	quest.37503E08F44B82E2.quest_subtitle: "Seven double ingots"
	quest.37503E08F44B82E2.quest_desc: ["Craft a metal anvil from seven double ingots. It works at tier I.", "", "This is the first rung of the &6anvil ladder&r. Every metal is worked on an anvil of its own tier or better, and each new anvil is made on the one before."]
	quest.58AAD5A29308D38F.title: "Real Forging"
	quest.58AAD5A29308D38F.quest_subtitle: "Anvil plus forge"
	quest.58AAD5A29308D38F.quest_desc: ["With heat and a metal anvil, you can forge parts properly by following the hit rules the anvil shows you. Start with a copper sheet.", "", "Place the hot metal on the anvil, pick the item, and bring the green marker onto the red one. The last three hits must match the rules shown at the top."]
	quest.026EECE401439DB5.title: "A Metal Weapon"
	quest.026EECE401439DB5.quest_subtitle: "Copper, cast"
	quest.026EECE401439DB5.quest_desc: ["A mace or sword from your first anvil. Every weapon here has a damage type, and some creatures resist it."]
	task.5972FC763E59BFFF.title: "Any Sword or Mace"
	quest.21734D0CC9C13EB8.title: "A Shield"
	quest.21734D0CC9C13EB8.quest_subtitle: "Block, then strike"
	quest.21734D0CC9C13EB8.quest_desc: ["Forge a shield. In this world, a shield is what keeps a bear from ending your run."]
	task.1E9C37F8373AF7F2.title: "Any Shield"
	quest.7B50FDAF814170F8.title: "A Full Suit"
	quest.7B50FDAF814170F8.quest_subtitle: "Helmet to boots"
	quest.7B50FDAF814170F8.quest_desc: ["Any metal counts. Armour takes real metal and a good anvil, and your guards will want the same."]
	task.3EBA7392469F63CA.title: "Any Helmet"
	task.60EB1300FA18EF5B.title: "Any Chestplate"
	task.7607DDFE8C8F93F7.title: "Any Greaves"
	task.7B8217852A027762.title: "Any Boots"
	quest.708071FC9FC41E46.title: "Mechanic: Recycling Metal"
	quest.708071FC9FC41E46.quest_subtitle: "Nothing is wasted"
	quest.708071FC9FC41E46.quest_desc: ["Broken tools and scraps can be melted back down in a vessel or crucible. You get back roughly what went into them, so keep old tools instead of throwing them away."]
	quest.0E03EF51188423A6.title: "Alloying Metals"
	quest.0E03EF51188423A6.quest_subtitle: "Tin, bismuth or zinc"
	quest.0E03EF51188423A6.quest_desc: ["Bronze needs a second metal: tin for bronze, bismuth and zinc for bismuth bronze, or silver and gold for black bronze. Look for their small ores and veins."]
	task.51CE9A82150D42DF.title: "Any Ingot"
	quest.00D2ECE08990E88F.title: "A Bronze Ingot"
	quest.00D2ECE08990E88F.quest_subtitle: "Hit the ratio, get the alloy"
	quest.00D2ECE08990E88F.quest_desc: ["Melt metals together in a vessel, and they alloy if the ratio is right. Bronze is about nine parts copper to one part tin. Bismuth bronze and black bronze work just as well, so use what your region gives you.", "", "&7The vessel shows the mix when you open it. Hover the alloy in JEI for the exact ranges."]
	task.24411895EA9D838C.title: "Any Bronze Ingot"
	quest.3F5F75D9CD82D6FC.title: "Bronze Double Ingots"
	quest.3F5F75D9CD82D6FC.quest_subtitle: "Weld at tier I"
	quest.3F5F75D9CD82D6FC.quest_desc: ["Weld ingots of one bronze on your copper anvil.", "", "Seven double ingots again, so fourteen ingots of the same bronze."]
	task.530D8840FA8FBE48.title: "Any Bronze Double Ingot"
	quest.543A21150BF1147D.title: "The Bronze Anvil"
	quest.543A21150BF1147D.quest_subtitle: "Tier II"
	quest.543A21150BF1147D.quest_desc: ["Seven double ingots of any one bronze. The anvil ladder goes up one metal at a time from here.", "", "With a tier II anvil you can make bronze sheets, and those build the bloomery. &6Iron \\& Steel&r starts here."]
	task.5B505210D3133A13.title: "Any Bronze Anvil"
	quest.3D02D1AA0305AAD1.title: "Kaolin Clay"
	quest.3D02D1AA0305AAD1.quest_subtitle: "A rarer clay"
	quest.3D02D1AA0305AAD1.quest_desc: ["Kaolin clay is found in some regions instead of ordinary clay. Dig it like clay.", "", "It forms in warm, rainy highlands, and may be a long trip from home. Bring back as much as you can carry."]
	task.47F8220549F3E6E7.title: "Any Kaolin Clay"
	quest.517F0D9EBE97DBAA.title: "Kaolinite"
	quest.517F0D9EBE97DBAA.quest_subtitle: "Heat kaolin clay"
	quest.517F0D9EBE97DBAA.quest_desc: ["Heat kaolin clay to get kaolinite powder, though only part of it survives.", "", "It needs 500 °C, which a firepit or a pit kiln reaches easily."]
	quest.6556C2658162F2C6.title: "Graphite"
	quest.6556C2658162F2C6.quest_subtitle: "Mined from its vein"
	quest.6556C2658162F2C6.quest_desc: ["Graphite comes from its own mineral vein. Mine some and take it to the quern."]
	quest.223C2D959E62E53A.title: "Graphite Powder"
	quest.223C2D959E62E53A.quest_subtitle: "From the quern"
	quest.223C2D959E62E53A.quest_desc: ["Mine graphite and grind it on a quern.", "", "Each piece of ore gives four powder."]
	quest.624694ACBF6DD012.title: "Fire Clay"
	quest.624694ACBF6DD012.quest_subtitle: "Kaolinite and graphite"
	quest.624694ACBF6DD012.quest_desc: ["Combine kaolinite powder, graphite powder and clay. Crucibles and fire bricks are both made from it.", "", "Four kaolinite powder, four graphite powder and one clay. A crucible takes five fire clay."]
	quest.4CF5920CF36A5940.title: "An Unfired Crucible"
	quest.4CF5920CF36A5940.quest_subtitle: "Fire clay, knapped"
	quest.4CF5920CF36A5940.quest_desc: ["Knap fire clay into an unfired crucible.", "", "It takes five fire clay, like every large clay piece."]
	quest.3098513E73B5CE56.title: "The Crucible"
	quest.3098513E73B5CE56.quest_subtitle: "Alloying in bulk"
	quest.3098513E73B5CE56.quest_desc: ["Knap fire clay into an unfired crucible and fire it. It holds far more metal than a vessel, and it goes inside your blast furnace.", "", "Put it on a forge, or under a blast furnace later. It keeps metal liquid, mixes alloys for you and pours into molds without a vessel."]
	chapter.543EA60029029B01.title: "Home \\& Workshop"
	chapter.543EA60029029B01.chapter_subtitle: ["Lumber and the barrel, then leather step by step, with paper, cloth, flasks and carts on the side. It ends with the bellows your forge is waiting for."]
	quest.31B23627907F36F6.title: "Lumber"
	quest.31B23627907F36F6.quest_subtitle: "Eight per log"
	quest.31B23627907F36F6.quest_desc: ["Saw a log into lumber. Chests, barrels and bellows are all built from it, and every wood works the same.", "", "Put a log and the saw in the crafting grid. The saw is not used up, only worn."]
	task.73CB8F40F92EEF93.title: "Any Lumber"
	quest.5076AF82F0111C47.title: "Support Beams"
	quest.5076AF82F0111C47.quest_subtitle: "Keep the mine from collapsing"
	quest.5076AF82F0111C47.quest_desc: ["Saw logs into support beams. Large open spaces underground cave in without them, so carry a stack before you dig out a real mine."]
	task.2BE15FA967E0E240.title: "Any Support Beam"
	quest.7826110CFC255730.title: "The Sluice"
	quest.7826110CFC255730.quest_subtitle: "Panning, but lazier"
	quest.7826110CFC255730.quest_desc: ["A sluice in flowing water processes deposit gravel for you."]
	task.02F85CF5DF984454.title: "Any Sluice"
	quest.49835B8360B2D056.title: "A Boat"
	quest.49835B8360B2D056.quest_subtitle: "Lumber and water"
	quest.49835B8360B2D056.quest_desc: ["Rivers are the first highways."]
	task.15E9559293EB31C5.title: "Any Boat"
	quest.4D4C158B5D8B3AE2.title: "Planks"
	quest.4D4C158B5D8B3AE2.quest_subtitle: "Four lumber, one plank"
	quest.4D4C158B5D8B3AE2.quest_desc: ["Craft lumber into planks. Workbenches need planks, not lumber."]
	task.07066F22E92F283A.title: "Any Planks"
	quest.1CCE2C7C8777DD37.title: "A Wheel"
	quest.1CCE2C7C8777DD37.quest_subtitle: "The great invention"
	quest.1CCE2C7C8777DD37.quest_desc: ["Make a pair of wooden wheels for your first cart."]
	task.0DE668D0E5F6523F.title: "Any Wheel"
	quest.1B89205B4BC579CA.title: "The Hand Cart"
	quest.1B89205B4BC579CA.quest_subtitle: "You pull"
	quest.1B89205B4BC579CA.quest_desc: ["Enough for the walk from the mine to the base."]
	task.3947C0BA4DE93167.title: "Any Hand Cart"
	quest.10DCD5B43DCE0D45.title: "The Supply Cart"
	quest.10DCD5B43DCE0D45.quest_subtitle: "An animal pulls"
	quest.10DCD5B43DCE0D45.quest_desc: ["A big rolling chest for a horse or donkey. This is how goods move between settlements until you have rails."]
	task.147CE73B0113BFE8.title: "Any Supply Cart"
	quest.54DD2DE3607D8EC7.title: "The Workbench"
	quest.54DD2DE3607D8EC7.quest_subtitle: "Your real crafting table"
	quest.54DD2DE3607D8EC7.quest_desc: ["Craft a workbench from four planks. Many recipes from here on need a full crafting grid."]
	task.7338FC97D8D52795.title: "Any Workbench"
	quest.5C2FAC7D9412BA57.title: "A Chest"
	quest.5C2FAC7D9412BA57.quest_subtitle: "Storage, finally"
	quest.5C2FAC7D9412BA57.quest_desc: ["Eight lumber in a ring.", "", "Size matters in this world: very large items such as logs and anvils do not fit in a chest."]
	task.5444B2E00663D1C3.title: "Any Chest"
	quest.5A4EC917D21631FF.title: "A Proper Road"
	quest.5A4EC917D21631FF.quest_subtitle: "Base course and hoggin"
	quest.5A4EC917D21631FF.quest_desc: ["Crush gravel and rock into base course, then top it with hoggin mix. Roads speed you up and tell people where you are."]
	quest.5E74EF2D4B10681C.title: "The Barrel"
	quest.5E74EF2D4B10681C.quest_subtitle: "A whole crafting system in a box"
	quest.5E74EF2D4B10681C.quest_desc: ["Craft a barrel from lumber. Sealing ingredients in one unlocks leather, alcohol, mortar, paper and food preservation.", "", "Open it, add a fluid and an item, and seal it. Some recipes are instant and others take hours, and the barrel must stay sealed the whole time.", "", "&7JEI lists these under Barrel and Sealed Barrel."]
	task.4FB2E3F2121B91C3.title: "Any Barrel"
	quest.47B7093E4198F340.title: "Brewing \\& Aging"
	quest.47B7093E4198F340.quest_subtitle: "Sealed and left alone"
	quest.47B7093E4198F340.quest_desc: ["Seal a food in a water barrel and let it sit. Grain, fruit and sugar give different drinks, and upper classes pay attention to which."]
	quest.7F2AA28BA5AF974D.title: "Preserving Food"
	quest.7F2AA28BA5AF974D.quest_subtitle: "Vinegar and brine"
	quest.7F2AA28BA5AF974D.quest_desc: ["Make vinegar from alcohol and fruit, and brine from salt water and vinegar. Then brine and pickle your food. Pickled food barely decays."]
	quest.2738C2CE3A49BEB2.title: "The Loom"
	quest.2738C2CE3A49BEB2.quest_subtitle: "For weaving"
	quest.2738C2CE3A49BEB2.quest_desc: ["Build a loom. Paper, burlap and wool cloth are all woven on it.", "", "Put the fibre in, then hold right-click until the piece is woven."]
	task.690C4E62ECBD87F1.title: "Any Loom"
	quest.00048F2DD49C6BBD.title: "Soaked Strips"
	quest.00048F2DD49C6BBD.quest_subtitle: "A day in water"
	quest.00048F2DD49C6BBD.quest_desc: ["Seal the strips in a barrel of water until they soften."]
	quest.3A436660ABA39FCB.title: "Papyrus Strips"
	quest.3A436660ABA39FCB.quest_subtitle: "Cut with a knife"
	quest.3A436660ABA39FCB.quest_desc: ["Papyrus grows wild in warm wetlands. Cut it into strips with a knife."]
	quest.2DC4462E15648C6E.title: "Unrefined Paper"
	quest.2DC4462E15648C6E.quest_subtitle: "Woven on the loom"
	quest.2DC4462E15648C6E.quest_desc: ["Weave four soaked strips on the loom into a sheet of unrefined paper."]
	quest.48412BC30AEB1948.title: "Paper"
	quest.48412BC30AEB1948.quest_subtitle: "Papyrus, soaked and woven"
	quest.48412BC30AEB1948.quest_desc: ["Place the unrefined paper on a log and scrape it smooth with your knife.", "", "Paper is asked for again and again later: blueprints, filters, schedules, cartridges and insulation all use it."]
	quest.772F1D0CEA65D09C.title: "Burlap Cloth"
	quest.772F1D0CEA65D09C.quest_subtitle: "Jute, retted and woven"
	quest.772F1D0CEA65D09C.quest_desc: ["Soak jute in water to get its fibre, then weave the fibre into burlap on a loom."]
	quest.5AC513F8190A0635.title: "Burlap Clothes"
	quest.5AC513F8190A0635.quest_subtitle: "Light for the heat"
	quest.5AC513F8190A0635.quest_desc: ["Burlap woven from jute is cool and airy, for hot climates."]
	quest.2B3B12B366113980.title: "A Bone Needle"
	quest.2B3B12B366113980.quest_subtitle: "For sewing"
	quest.2B3B12B366113980.quest_desc: ["Knap a bone into a needle. You need it to sew cloth into clothing and to work leather."]
	quest.07F91E6A7A070CA6.title: "Limewater"
	quest.07F91E6A7A070CA6.quest_subtitle: "Flux in water"
	quest.07F91E6A7A070CA6.quest_desc: ["Seal flux in a barrel of water. It is the base of tanning and mortar.", "", "This is a liquid, so tick it yourself once the barrel is full."]
	quest.370C92049CA43A45.title: "Mortar"
	quest.370C92049CA43A45.quest_subtitle: "Sand and limewater"
	quest.370C92049CA43A45.quest_desc: ["Seal sand in limewater. Mortar binds stone bricks into proper walls.", "", "One sealing of sand in 100 mB of limewater gives sixteen mortar."]
	quest.67984E8502C74506.title: "A Soaked Hide"
	quest.67984E8502C74506.quest_subtitle: "Step one: limewater"
	quest.67984E8502C74506.quest_desc: ["Seal a raw hide in a barrel of limewater. It loosens the hair and flesh."]
	task.057E0F5412091BE5.title: "Any Soaked Hide"
	quest.694678634177023D.title: "A Scraped Hide"
	quest.694678634177023D.quest_subtitle: "Step two: the knife"
	quest.694678634177023D.quest_desc: ["Place the soaked hide on top of a log and scrape it with your knife."]
	task.7F88C288EA8185C6.title: "Any Scraped Hide"
	quest.7E5FCCD4563CB672.title: "A Prepared Hide"
	quest.7E5FCCD4563CB672.quest_subtitle: "Step three: rinse"
	quest.7E5FCCD4563CB672.quest_desc: ["Seal the scraped hide in a barrel of fresh water to wash the lime out."]
	task.3AD41A4F0967D1FE.title: "Any Prepared Hide"
	quest.082DF653AD565BCB.title: "Tannin"
	quest.082DF653AD565BCB.quest_subtitle: "Bark, soaked in water"
	quest.082DF653AD565BCB.quest_desc: ["Seal bark from a tannin-rich tree in a barrel of water. Birch and chestnut both work, among others.", "", "Sealing takes several hours, so start the tannin barrel while the hides are still soaking."]
	quest.0C39832773AC1714.title: "Leather"
	quest.0C39832773AC1714.quest_subtitle: "Soak, scrape, soak, soak"
	quest.0C39832773AC1714.quest_desc: ["Seal the prepared hide in tannin. What comes out is real leather, the last step of four.", "", "A large hide gives more leather than a small one. Keep a few hides moving through the barrels, because leather goes into bellows, flasks, saddles and armour."]
	quest.2C2029B24D797B67.title: "A Bladder"
	quest.2C2029B24D797B67.quest_subtitle: "From the butcher"
	quest.2C2029B24D797B67.quest_desc: ["Butchering an animal gives a bladder, the waterproof heart of a flask."]
	quest.58397AD9BE386676.title: "The Leather Flask"
	quest.58397AD9BE386676.quest_subtitle: "Water for the road"
	quest.58397AD9BE386676.quest_desc: ["Two leather sides, a bladder and string, stitched with a knife. It holds far more than a jug."]
	quest.542826EFD29183A5.title: "Insulated Leather"
	quest.542826EFD29183A5.quest_subtitle: "For the cold"
	quest.542826EFD29183A5.quest_desc: ["Leather armour lined with string keeps the cold out."]
	quest.56CCEB2F6FE95F04.title: "Predator Furs"
	quest.56CCEB2F6FE95F04.quest_subtitle: "Hardcore fur coats"
	quest.56CCEB2F6FE95F04.quest_desc: ["Furs from bears, big cats, wolves, caribou and bison make the warmest clothes. Each animal's fur is sewn onto leather armour with string."]
	task.0C492FC00C341178.title: "Any Fur Clothing"
	quest.0B3BF61984FAB761.title: "A Saddle"
	quest.0B3BF61984FAB761.quest_subtitle: "Tame a horse"
	quest.0B3BF61984FAB761.quest_desc: ["Tame a horse, then saddle it. A horse makes long prospecting trips possible."]
	quest.543612623D157B8E.title: "Bellows"
	quest.543612623D157B8E.quest_subtitle: "More air, more heat"
	quest.543612623D157B8E.quest_desc: ["Six lumber and three leather. Pumping bellows on a forge adds up to 600 °C, which you will need much sooner than you think.", "", "Set it beside the forge, facing it, and right-click to pump. The fuel burns faster while you do.", "", "Plain charcoal stops at 1350 °C. The blast furnace cannot run without bellows, and bauxite and rose quartz need a forge pushed past 1600 °C. &6Iron \\& Steel&r is next."]
	chapter.6F16368DBECD0DF0.title: "Farm \\& Kitchen"
	chapter.6F16368DBECD0DF0.chapter_subtitle: ["A field and the road from grain to flatbread and then to real bread, with animals, wool and cheese below, and the ways to make food last."]
	quest.3E5FC387D3058DB7.title: "Mechanic: Food Decay"
	quest.3E5FC387D3058DB7.quest_subtitle: "Nothing keeps forever"
	quest.3E5FC387D3058DB7.quest_desc: ["Food rots over time. Cooking, salting, smoking, drying, brining and sealing it in jars or vessels all slow that down. Check the tooltip to see how long something has left."]
	quest.16C281753A784D0E.title: "Beekeeping"
	quest.16C281753A784D0E.quest_subtitle: "Frames, hives and patience"
	quest.16C281753A784D0E.quest_desc: ["Build a beehive, put frames in it and leave it near flowers. Frames fill over time.", "", "Bees give you beeswax, which the first electron tubes need, and raw honey, which sweetens bread dough.", "", "&7Field guide: Firmalife, Beekeeping."]
	quest.57368A5DB1A6E55F.title: "Your First Field"
	quest.57368A5DB1A6E55F.quest_subtitle: "Hoe, seeds and water"
	quest.57368A5DB1A6E55F.quest_desc: ["Till soil near water and plant what you find growing wild. Crops care about climate, so look at what grows nearby before you plant.", "", "&7The field guide lists what each crop needs."]
	quest.01C50AEAAF53CA9B.title: "The Composter"
	quest.01C50AEAAF53CA9B.quest_subtitle: "Soil needs feeding"
	quest.01C50AEAAF53CA9B.quest_desc: ["Crops use up nutrients. A composter turns scraps and straw into fertilizer.", "", "Fill it with greens, such as plants and food scraps, and browns, such as straw, then wait."]
	quest.2EE2F7AA4FE6D7A6.title: "The Watering Can"
	quest.2EE2F7AA4FE6D7A6.quest_subtitle: "Rain on demand"
	quest.2EE2F7AA4FE6D7A6.quest_desc: ["A wooden bucket and lumber, filled with water."]
	quest.19FA383D4136EC01.title: "The Plow"
	quest.19FA383D4136EC01.quest_subtitle: "Fields, faster"
	quest.19FA383D4136EC01.quest_desc: ["A plow pulled by an animal tills a whole row at once."]
	task.0B2BA31F733A1BC2.title: "Any Plow"
	quest.632860AB69C89D7A.title: "The Drying Mat"
	quest.632860AB69C89D7A.quest_subtitle: "Sun-dried food keeps"
	quest.632860AB69C89D7A.quest_desc: ["Three fruit leaves make a drying mat. Leave fruit or other food on it in the sun and it dries, which slows decay.", "", "Dried fruit is also what starts your yeast, further along the line.", "", "&7Field guide: Firmalife, Drying."]
	quest.00692C25ECDC24CF.title: "Grain"
	quest.00692C25ECDC24CF.quest_subtitle: "Threshed from the crop"
	quest.00692C25ECDC24CF.quest_desc: ["Harvest a grain crop and use a knife on it, or a scythe in the field, to get grain."]
	task.175E0E0966B0C3BD.title: "Any Grain"
	quest.5083D752EE15991F.title: "Flour"
	quest.5083D752EE15991F.quest_subtitle: "Grain, ground down"
	quest.5083D752EE15991F.quest_desc: ["Grind grain on the quern. Wheat, barley, rye, oat, rice and maize all work the same way."]
	task.4E2C069A74F524C1.title: "Any Flour"
	quest.2CC8FC77F958A017.title: "Flatbread Dough"
	quest.2CC8FC77F958A017.quest_subtitle: "Flour and water"
	quest.2CC8FC77F958A017.quest_desc: ["Craft flour with a jug or bucket of water. Each flour gives one dough, and up to four fit in one craft.", "", "There is no yeast in it, so it will not rise. It bakes into flatbread, which is where every baker starts."]
	task.2C935DA2690FE346.title: "Any Flatbread Dough"
	quest.2C65EDAB655EA590.title: "Flatbread"
	quest.2C65EDAB655EA590.quest_subtitle: "Bread without yeast"
	quest.2C65EDAB655EA590.quest_desc: ["Cook the dough over a firepit or in an oven. Flatbread is plain, but it is a grain food that keeps for days, and it is what your first settlers eat.", "", "Real bread needs two more things: yeast and something sweet. They are the next steps on this line."]
	task.06D751939BEAE9AF.title: "Any Flatbread"
	quest.3EDE7C41BD17EF02.title: "The Pot"
	quest.3EDE7C41BD17EF02.quest_subtitle: "One fire, many ingredients"
	quest.3EDE7C41BD17EF02.quest_desc: ["A fired clay pot sits on a firepit. Fill it with water and up to five ingredients to cook a soup. Soups mix food groups, so they help your nutrition more than a single food."]
	quest.47126BE81ECEF098.title: "A Pot of Soup"
	quest.47126BE81ECEF098.quest_subtitle: "Five ingredients, one bowl"
	quest.47126BE81ECEF098.quest_desc: ["Cook a soup in the pot and take it out with a bowl."]
	task.53EDFEFF1AAA1770.title: "Any Soup"
	quest.6C082622A7E0F297.title: "Yeast Starter"
	quest.6C082622A7E0F297.quest_subtitle: "Fruit, water and three days"
	quest.6C082622A7E0F297.quest_desc: ["Seal a piece of &6dried fruit&r in a barrel with 100 mB of water and leave it for three days. The water turns into yeast starter.", "", "You only do this once. Seal the starter with flour and half a day later 100 mB has become 600 mB, so always keep some back and feed it.", "", "&7Fruit dries on the Drying Mat, below the field. This is a liquid, so tick it yourself. Field guide: Firmalife, Bread."]
	quest.552159A3BB45BCDD.title: "Bread Dough"
	quest.552159A3BB45BCDD.quest_subtitle: "Flour, yeast and something sweet"
	quest.552159A3BB45BCDD.quest_desc: ["Craft flour with a bucket of yeast starter and a sweetener. One craft gives four dough.", "", "This is the dough that rises. A mechanical mixer makes the same thing later, from 100 mB of starter a batch."]
	task.2C90543F5B454958.title: "Any Dough"
	quest.0A253AABD7DDBB64.title: "A Sweetener"
	quest.0A253AABD7DDBB64.quest_subtitle: "Sugar, honey or tree sugar"
	quest.0A253AABD7DDBB64.quest_desc: ["Yeast needs something sweet to work on. Sugar, raw honey, birch sugar and maple sugar all count.", "", "Sugar comes from sugar cane sealed in a barrel of water, or from beets boiled with salt in a pot. Raw honey comes from your beehives."]
	task.326F44382AEE5347.title: "Any Sweetener"
	quest.678487C51E9C1F84.title: "The Oven"
	quest.678487C51E9C1F84.quest_subtitle: "Clay, assembled and fired"
	quest.678487C51E9C1F84.quest_desc: ["Knap and fire the bottom, top and chimney of a clay oven. Add a hopper later for automatic fuel.", "", "Stack them in that order: bottom, top, chimney. Fuel goes in the bottom and the dough in the top.", "", "&7Field guide: Firmalife, Ovens."]
	quest.2EB8CBC82AC8B5A2.title: "Bread"
	quest.2EB8CBC82AC8B5A2.quest_subtitle: "Actual bread, not flatbread"
	quest.2EB8CBC82AC8B5A2.quest_desc: ["Bake the bread dough in the top of a lit oven.", "", "Bread feeds better than flatbread and it is what the higher classes of settlers ask for, so a working oven and a fed yeast barrel are the start of feeding more than yourself."]
	task.3849BC61F299946A.title: "Any Bread"
	quest.0514543B6C3575DB.title: "A Sandwich"
	quest.0514543B6C3575DB.quest_subtitle: "Bread, a filling and a knife"
	quest.0514543B6C3575DB.quest_desc: ["Two slices of bread and a filling. It packs more nutrition into one food slot.", "", "Cut the bread with a knife in the crafting grid, then add up to three fillings. Meat, cheese and vegetables together cover most of your food groups in one meal."]
	task.6560715183F3A91D.title: "Any Sandwich"
	quest.32AAC8F2AA2C2E0B.title: "Chickens"
	quest.32AAC8F2AA2C2E0B.quest_subtitle: "A nest box and patience"
	quest.32AAC8F2AA2C2E0B.quest_desc: ["Build a nest box and tame a chicken. Familiarity grows with daily feeding.", "", "Feed an animal every day and its familiarity rises. Only a familiar animal can be milked, sheared or bred."]
	quest.14BF9FB7BE332D67.title: "Wool Yarn"
	quest.14BF9FB7BE332D67.quest_subtitle: "Spun on a spindle"
	quest.14BF9FB7BE332D67.quest_desc: ["Shear wool from a familiar sheep or alpaca and spin it into yarn with a spindle."]
	quest.3613EF037DEC492E.title: "Wool Cloth"
	quest.3613EF037DEC492E.quest_subtitle: "Woven on the loom"
	quest.3613EF037DEC492E.quest_desc: ["Weave yarn into wool cloth on a loom.", "", "Sixteen yarn make one cloth."]
	quest.57DAA56B0E0620FE.title: "Wool Clothes"
	quest.57DAA56B0E0620FE.quest_subtitle: "Knitted for winter"
	quest.57DAA56B0E0620FE.quest_desc: ["Shear a sheep or alpaca, spin the wool into yarn and weave it into cloth for a sweater, hat, trousers and boots."]
	quest.0BF1D0DDE255A8AD.title: "The Butcher's Table"
	quest.0BF1D0DDE255A8AD.quest_subtitle: "Waste nothing"
	quest.0BF1D0DDE255A8AD.quest_desc: ["Hang a carcass and break it down: meat, fat, hide and offal all come from here. Stomachs give rennet, and fat gives tallow."]
	task.2DEDB24A99721BBF.title: "Any Butchers Table"
	quest.29B24E7CD08803F7.title: "Rennet"
	quest.29B24E7CD08803F7.quest_subtitle: "A stomach and a knife"
	quest.29B24E7CD08803F7.quest_desc: ["Cut a stomach with a knife to get four rennet. It is what curdles your milk."]
	quest.2AD2369395C5D0F7.title: "Cheesecloth"
	quest.2AD2369395C5D0F7.quest_subtitle: "Woven for straining"
	quest.2AD2369395C5D0F7.quest_desc: ["Two pieces of good cloth make eight cheesecloth, for straining your curds."]
	quest.5E4C2E7116AF4C33.title: "Milk Curds"
	quest.5E4C2E7116AF4C33.quest_subtitle: "Curdled milk, strained"
	quest.5E4C2E7116AF4C33.quest_desc: ["Seal milk with rennet in a barrel to curdle it, then strain the curdled milk through cheesecloth in a barrel. Whey is left over."]
	task.60C58D85D3E217E0.title: "Any Curd"
	quest.5520E413C1D06631.title: "A Cheese Wheel"
	quest.5520E413C1D06631.quest_subtitle: "Curds, salt and time"
	quest.5520E413C1D06631.quest_desc: ["Pack milk curds and salt into a wheel. Cheddar takes three curds and six salt, and every milk has its own cheese. Upper classes in your settlement will ask for it.", "", "Place the wheel and let it age. The longer it sits in a cellar, the better the cheese.", "", "&7Field guide: Firmalife, Cheese."]
	task.45EB131EB7946901.title: "Any Cheese Wheel"
	quest.21D7D3F69C69CE68.title: "Brine"
	quest.21D7D3F69C69CE68.quest_subtitle: "Salt water and vinegar"
	quest.21D7D3F69C69CE68.quest_desc: ["Mix nine parts salt water with one part vinegar in a barrel to get brine. Vinegar comes from fruit soaked in alcohol."]
	quest.70D012101DBA240F.title: "Brined Food"
	quest.70D012101DBA240F.quest_subtitle: "The first step to smoking"
	quest.70D012101DBA240F.quest_desc: ["Seal meat, fish, fruit or vegetables in a barrel of brine. Brined food decays slower, and only brined meat can be smoked."]
	quest.70E133B60DB03C45.title: "Smoked Meat"
	quest.70E133B60DB03C45.quest_subtitle: "Over a smoky fire"
	quest.70E133B60DB03C45.quest_desc: ["Hang brined raw meat over a firepit that burns logs, with a chimney above. Smoked meat keeps much longer.", "", "&7Field guide: Firmalife, Smoking."]
	quest.49A7FEC73A8756E3.title: "Preserves"
	quest.49A7FEC73A8756E3.quest_subtitle: "Fruit in a jar"
	quest.49A7FEC73A8756E3.quest_desc: ["Cook fruit with sugar and seal it in a jar. It keeps almost forever.", "", "A jar is blown from glass and closed with a tin lid."]
	task.61649104D8225A14.title: "Any Jam"
	chapter.206BF17A869EA55D.title: "Iron \\& Steel"
	chapter.206BF17A869EA55D.chapter_subtitle: ["One long line: the bloomery and wrought iron, the blast furnace and pig iron, then steel, its anvil and the first rods."]
	quest.1BD74C2523FA6F4D.title: "Bronze Sheets"
	quest.1BD74C2523FA6F4D.quest_subtitle: "Forged from double ingots"
	quest.1BD74C2523FA6F4D.quest_desc: ["Forge double ingots of one bronze into sheets on your bronze anvil.", "", "A sheet is a double ingot hammered flat, so each one costs two ingots."]
	task.467EF5B6C0A6D3BB.title: "Any Bronze Sheet"
	quest.72DA1B57FB553B41.title: "Bronze Double Sheets"
	quest.72DA1B57FB553B41.quest_subtitle: "Eight for one bloomery"
	quest.72DA1B57FB553B41.quest_desc: ["Weld pairs of sheets into double sheets. Any bronze works.", "", "Eight double sheets are thirty two ingots of bronze. The bloomery is the most expensive thing you have built so far."]
	task.4D5A162FD5A5445C.title: "Any Bronze Double Sheet"
	quest.06A497A9698F0A20.title: "A Grill"
	quest.06A497A9698F0A20.quest_subtitle: "Cooking over the fire"
	quest.06A497A9698F0A20.quest_desc: ["A wrought iron grill on a firepit cooks several foods at once. A cast iron grill does the same, made from cast iron double sheets."]
	task.1C04C3BE787A421B.title: "Any Iron Grill"
	quest.74B5420D54FC7AB0.title: "The Bloomery"
	quest.74B5420D54FC7AB0.quest_subtitle: "Eight double sheets"
	quest.74B5420D54FC7AB0.quest_desc: ["Craft the bloomery, and build it into a stone chimney as the field guide shows. It takes ore directly, and it doesn't care how high a metal's melting point is. Remember that later."]
	quest.161CE790D0FAAAE4.title: "A Working Bloomery"
	quest.161CE790D0FAAAE4.quest_subtitle: "Chimney and all"
	quest.161CE790D0FAAAE4.quest_desc: ["Set the bloomery into a stone chimney, as the field guide shows, so it can draw air.", "", "The chimney is a column of stone blocks behind the bloomery door, open at the top. A taller chimney takes more ore in one firing.", "", "&7To finish, look at the placed bloomery."]
	quest.6EB21F335F326CCF.title: "Iron Ore"
	quest.6EB21F335F326CCF.quest_subtitle: "Hematite, magnetite or limonite"
	quest.6EB21F335F326CCF.quest_desc: ["Find an iron vein: hematite, magnetite or limonite, each in its own rocks.", "", "Any grade will do, and richer ore fills the bloomery with fewer pieces."]
	task.1F69B6FFEEB79BFB.title: "Any Iron Ore"
	quest.6DC8766ED1D35EC9.title: "A Raw Iron Bloom"
	quest.6DC8766ED1D35EC9.quest_subtitle: "Ore and charcoal"
	quest.6DC8766ED1D35EC9.quest_desc: ["Fill the bloomery with iron ore and charcoal, light it and wait. You get a spongy, impure lump.", "", "Drop ore and charcoal into the top of the chimney in equal number, then light the bloomery block. When the fire dies, break the bloom out with a pickaxe."]
	quest.156CE7CBAD2CEA8F.title: "A Refined Bloom"
	quest.156CE7CBAD2CEA8F.quest_subtitle: "Hammered clean"
	quest.156CE7CBAD2CEA8F.quest_desc: ["Work the raw bloom on your anvil to knock out the slag.", "", "It works like any forging: heat the bloom and hit the marks. A bronze anvil is enough."]
	quest.5BDD335BAEB5D3CD.title: "Wrought Iron"
	quest.5BDD335BAEB5D3CD.quest_subtitle: "A real structural metal"
	quest.5BDD335BAEB5D3CD.quest_desc: ["Work the refined bloom into an ingot.", "", "Wrought iron is the first metal you cannot simply melt and cast. Every ingot is hammered out by hand, which is why the trip hammer later feels like such a relief.", "", "&7The same bloomery later gives you tungsten, titanium and the other metals no forge can melt."]
	quest.53A23DA10B9AE5AD.title: "A Crossbow"
	quest.53A23DA10B9AE5AD.quest_subtitle: "A harder pull"
	quest.53A23DA10B9AE5AD.quest_desc: ["More force, slower reload."]
	quest.3CE77F6BCCEEE09C.title: "The Wrought Iron Anvil"
	quest.3CE77F6BCCEEE09C.quest_subtitle: "Tier III"
	quest.3CE77F6BCCEEE09C.quest_desc: ["Seven double ingots, welded on your bronze anvil.", "", "That is fourteen ingots, each one hammered out of a bloom. Tier III forges the tuyere, the tree tap and the brass hand, and it welds aluminium and steel."]
	quest.6AB4B307DCBBFB20.title: "The Tuyere"
	quest.6AB4B307DCBBFB20.quest_subtitle: "Air into the furnace"
	quest.6AB4B307DCBBFB20.quest_desc: ["Forge a tuyere from a wrought iron double sheet. Fitted to a bellows, it feeds the blast furnace."]
	quest.4ED20B4EF02B8802.title: "The Iron Flask"
	quest.4ED20B4EF02B8802.quest_subtitle: "Hard to break"
	quest.4ED20B4EF02B8802.quest_desc: ["A wrought iron flask lasts a long time and holds more."]
	quest.0D31BC2ECF34F22A.title: "Unfired Fire Bricks"
	quest.0D31BC2ECF34F22A.quest_subtitle: "Fire clay, shaped"
	quest.0D31BC2ECF34F22A.quest_desc: ["Knap fire clay into unfired fire bricks.", "", "One knapping gives three bricks."]
	quest.72C9588819852E5B.title: "Fire Bricks"
	quest.72C9588819852E5B.quest_subtitle: "They take the heat"
	quest.72C9588819852E5B.quest_desc: ["Fire clay bricks, bound with mortar. The blast furnace is lined with them.", "", "Fire the bricks first, then craft five with four mortar for four blocks."]
	quest.6A5F453B1A0438B4.title: "The Blast Furnace"
	quest.6A5F453B1A0438B4.quest_subtitle: "A crucible in iron"
	quest.6A5F453B1A0438B4.quest_desc: ["Eight wrought iron double sheets around a crucible. Build the tower as the field guide shows, with your tuyere and bellows.", "", "The furnace block sits on top of a crucible, with a chimney of fire brick blocks above it, each layer wrapped in wrought iron sheets. More layers hold more ore."]
	quest.773E83F816EEC773.title: "A Working Blast Furnace"
	quest.773E83F816EEC773.quest_subtitle: "Built and fed with air"
	quest.773E83F816EEC773.quest_desc: ["Build the furnace tower as the field guide shows, with the tuyere and bellows feeding it air.", "", "&7To finish, look at the placed blast furnace."]
	quest.16B0A12678349853.title: "Pig Iron"
	quest.16B0A12678349853.quest_subtitle: "The bridge to steel"
	quest.16B0A12678349853.quest_desc: ["Feed iron ore, flux and charcoal into the running furnace, then cast what comes out.", "", "Put the tuyere in the furnace and keep the bellows going. The molten pig iron collects in the crucible below, and you cast it from there."]
	quest.6187B209B3F521B4.title: "High Carbon Steel"
	quest.6187B209B3F521B4.quest_subtitle: "Pig iron, beaten thin"
	quest.6187B209B3F521B4.quest_desc: ["Heat pig iron to working temperature and work it on your anvil. Most of the carbon is still in there, so it isn't steel yet."]
	quest.782C0FFB11135737.title: "A Steel Ingot"
	quest.782C0FFB11135737.quest_subtitle: "Beaten once more"
	quest.782C0FFB11135737.quest_desc: ["Work the high carbon steel again to drive out the last of the excess carbon. Everything mechanical in this world grows from this ingot.", "", "From here on steel is in almost everything: every shaft, most machine parts and the next two anvils."]
	quest.372486FB41C10615.title: "Steel Double Ingots"
	quest.372486FB41C10615.quest_subtitle: "Weld two into one"
	quest.372486FB41C10615.quest_desc: ["Weld two steel ingots with flux. Welding needs one anvil tier less than forging, so a wrought iron anvil can do this."]
	quest.700F8CEBF647415B.title: "The Steel Anvil"
	quest.700F8CEBF647415B.quest_subtitle: "Tier IV"
	quest.700F8CEBF647415B.quest_desc: ["Seven double ingots make the steel anvil. Forging any steel part needs one, and so does aluminium sheet."]
	quest.5D2B6C6FCDDA8B93.title: "Steel Sheets"
	quest.5D2B6C6FCDDA8B93.quest_subtitle: "Machines eat these"
	quest.5D2B6C6FCDDA8B93.quest_desc: ["Forge double ingots into sheets. Keep a stock: crushing wheels alone need sixteen."]
	quest.03C81B844D0C3F38.title: "Steel Double Sheets"
	quest.03C81B844D0C3F38.quest_subtitle: "For the heavy work"
	quest.03C81B844D0C3F38.quest_desc: ["Weld two sheets together. Later, a press and solder can do the same job without you."]
	quest.5A3D4F7F6C304F1C.title: "Steel Tools"
	quest.5A3D4F7F6C304F1C.quest_subtitle: "Better, not required"
	quest.5A3D4F7F6C304F1C.quest_desc: ["Every metal pickaxe mines every ore here, so steel tools buy you durability and speed, not access."]
	quest.20654EEC7D64AB53.title: "Steel Rods"
	quest.20654EEC7D64AB53.quest_subtitle: "The first shaft starts here"
	quest.20654EEC7D64AB53.quest_desc: ["Forge steel rods. A pair of rods and a chisel gives you a shaft, and nothing turns without shafts.", "", "This is where hand metalwork meets machines. The parts those machines are built from are gathered in &6Machine Materials&r, and &6First Machines&r begins with two of these rods."]
	chapter.458F48ADB244F047.title: "Machine Materials"
	chapter.458F48ADB244F047.chapter_subtitle: ["A real mine fans out into the deep veins. Follow each line to what the first machines are built from: rubber, aluminium casings, the electron tube, glass and brass."]
	quest.0460407FB725556B.title: "A Real Mine"
	quest.0460407FB725556B.quest_subtitle: "Signposts point down"
	quest.0460407FB725556B.quest_desc: ["Small ores on the surface tell you what lies below, but they won't feed a factory. Follow them down with your prospector's pick, and shore up your tunnels with support beams.", "", "Each line leaving this quest is one thing the deep veins give you. None of them waits for another.", "", "&7Field guide: Materialism Guide, Ore Generation lists every vein with its rocks and its depth."]
	quest.4C23FBD65921720F.title: "Mechanic: Collapses"
	quest.4C23FBD65921720F.quest_subtitle: "Thought the surface was hard?"
	quest.4C23FBD65921720F.quest_desc: ["Raw rock or ore with air below it is unsupported, and mining near it can start a cave-in. Cave roofs of hardened stone are safe. Support beams hold up the rock around them, so place them as you dig."]
	quest.208D27F30FA1D14F.title: "Sulfur"
	quest.208D27F30FA1D14F.quest_subtitle: "Rubber and gunpowder"
	quest.208D27F30FA1D14F.quest_desc: ["Grind sulfur ore on a quern. It vulcanises rubber now and becomes acid much later.", "", "Sulfur vulcanises the rubber on the line above this one."]
	quest.72D7A1330C6A3D2E.title: "Magnesium"
	quest.72D7A1330C6A3D2E.quest_subtitle: "Magnesite, smelted hot"
	quest.72D7A1330C6A3D2E.quest_desc: ["Magnesite smelts only in a hot forge, and poorly. Airship envelopes and traction motors want a little magnesium long before the electrolysis line."]
	quest.02509A4F39B4C224.title: "Aluminium"
	quest.02509A4F39B4C224.quest_subtitle: "Bauxite melts easily"
	quest.02509A4F39B4C224.quest_desc: ["Bauxite veins sit between Y -40 and 40. Bauxite ore only melts at 1600 °C, which needs a forge with bellows, and it gives just 2 to 7 mB by grade. You need a lot of ore for a little aluminium until the Bayer and Hall–Héroult line. Its forged parts need a tier IV anvil."]
	quest.479178035CB8D3ED.title: "Aluminium Double Ingots"
	quest.479178035CB8D3ED.quest_subtitle: "Tier III is enough to weld"
	quest.479178035CB8D3ED.quest_desc: ["Weld aluminium ingots on your wrought iron anvil."]
	quest.4A9A9BDDD4400F8D.title: "The Aluminium Anvil"
	quest.4A9A9BDDD4400F8D.quest_subtitle: "A second way to tier IV"
	quest.4A9A9BDDD4400F8D.quest_desc: ["An aluminium anvil works at tier IV, just like steel. Useful if your bauxite turns up before your steel does."]
	quest.450365DB1F257FFF.title: "Aluminium Sheets"
	quest.450365DB1F257FFF.quest_subtitle: "Machines start as casings"
	quest.450365DB1F257FFF.quest_desc: ["Forge aluminium sheets at tier IV. Almost every Create machine sits in a casing made from these."]
	quest.5A8D6EAEB53794F6.title: "Andesite Casing"
	quest.5A8D6EAEB53794F6.quest_subtitle: "Aluminium over wood"
	quest.5A8D6EAEB53794F6.quest_desc: ["Right-click a stripped log with an aluminium sheet. Andesite alloy doesn't exist here: aluminium takes its place almost everywhere.", "", "Strip a log with an axe, place it, and right-click it with the sheet. One sheet makes one casing, and nearly every machine in the next chapter takes one."]
	quest.47E432D0FA44F238.title: "The Tree Tap"
	quest.47E432D0FA44F238.quest_subtitle: "Wrought iron, tier III"
	quest.47E432D0FA44F238.quest_desc: ["Forge a tree tap from a wrought iron sheet. Latex comes from hevea trees, and at half the rate from rubber figs."]
	quest.7DB2EE2840BB029A.title: "Latex"
	quest.7DB2EE2840BB029A.quest_subtitle: "Tapped from a hevea"
	quest.7DB2EE2840BB029A.quest_desc: ["Put the tap on a hevea log, or a rubber fig, and collect the latex in a barrel or bucket below it.", "", "This is a liquid, so tick it yourself once you have collected some.", "", "&7Field guide: ArborFirmaCraft, Tapping Trees and Making Rubber."]
	quest.385F2C711E0C9E42.title: "Rubber"
	quest.385F2C711E0C9E42.quest_subtitle: "Latex, sulfur and heat"
	quest.385F2C711E0C9E42.quest_desc: ["Hevea only taps between 14 and 50 °C, so a cold base has to import latex or rubber. Cook 1000 mB of latex with sulfur in a pot at 600 °C.", "", "Each bar takes one sulfur powder and 1000 mB of latex. Belts, spouts and funnels are all made with rubber bars, so plan for a steady supply of both."]
	quest.73A58EBD0FE94273.title: "Redstone"
	quest.73A58EBD0FE94273.quest_subtitle: "Cinnabar or cryolite"
	quest.73A58EBD0FE94273.quest_desc: ["There is no redstone ore here. Grind cinnabar or cryolite on a quern: a full ore gives 8 redstone, and a small one gives 1.", "", "Six redstone go into every imbued quartz powder, on the line below."]
	quest.3DEE7B23096092E6.title: "Certus Quartz"
	quest.3DEE7B23096092E6.quest_subtitle: "Keep it for later"
	quest.3DEE7B23096092E6.quest_desc: ["Mine certus quartz from its vein. Ground and imbued with redstone, it is the first step towards rose quartz."]
	quest.0F254FB358D48BF4.title: "Certus Powder"
	quest.0F254FB358D48BF4.quest_subtitle: "Ground on the quern"
	quest.0F254FB358D48BF4.quest_desc: ["Grind certus quartz on the quern."]
	quest.05B6B23713DC8B26.title: "Imbued Quartz Powder"
	quest.05B6B23713DC8B26.quest_subtitle: "Certus, redstone and wax"
	quest.05B6B23713DC8B26.quest_desc: ["Grind certus quartz on a quern, then mix the powder with 6 redstone and beeswax.", "", "It takes three things: the certus powder, six redstone and one beeswax."]
	quest.7DE994478C778AEC.title: "Beeswax"
	quest.7DE994478C778AEC.quest_subtitle: "A knife on a full frame"
	quest.7DE994478C778AEC.quest_desc: ["Use a knife on a filled beehive frame. Beeswax binds the quartz powder and seals your cellar.", "", "The hives are in Farm \\& Kitchen."]
	quest.5FFEFB0DF6C16F9F.title: "Rose Quartz"
	quest.5FFEFB0DF6C16F9F.quest_subtitle: "1800 °C, 40% of the time"
	quest.5FFEFB0DF6C16F9F.quest_desc: ["Heat imbued powder to 1800 °C. A charcoal forge only gets there with bellows running, and only 40% of attempts succeed, so bring spares."]
	quest.7C57F831181D8E8E.title: "Polished Rose Quartz"
	quest.7C57F831181D8E8E.quest_subtitle: "A costly hand job"
	quest.7C57F831181D8E8E.quest_desc: ["Polish rose quartz with sandpaper. The first sandpaper is an expensive hand recipe, because the cheap one needs deployers."]
	quest.201B77EE75BE5DCC.title: "Nickel"
	quest.201B77EE75BE5DCC.quest_subtitle: "Garnierite, far below"
	quest.201B77EE75BE5DCC.quest_desc: ["Garnierite only generates deep, from Y -180 to -10. Electron tubes need nickel sheet, so this mine comes before any serious machine.", "", "Forge it into a sheet: each electron tube takes one."]
	quest.3BA7D54018B8DA09.title: "The Electron Tube"
	quest.3BA7D54018B8DA09.quest_subtitle: "The heart of a smart machine"
	quest.3BA7D54018B8DA09.quest_desc: ["Three parts make a tube: &6polished rose quartz&r, &6lamp glass&r and a &6nickel sheet&r. Each of the three lines that meet here is one of them.", "", "Each deployer and each set of three mechanical crafters takes one tube, so the thirteen crafters of the steam engine alone take five.", "", "With casings, tubes, rubber and glass panes in hand, &6First Machines&r can be built from end to end."]
	quest.0938534D1B173701.title: "A Glass Batch"
	quest.0938534D1B173701.quest_subtitle: "Sand, lime and an alkali"
	quest.0938534D1B173701.quest_desc: ["Mix silica sand with lime and saltpeter or soda ash. Glass here is worked, never just smelted."]
	task.04A37DE43E4F5523.title: "Any Glass Batch"
	quest.53DE53289A7E9A53.title: "The Blowpipe"
	quest.53DE53289A7E9A53.quest_subtitle: "Holds the batch"
	quest.53DE53289A7E9A53.quest_desc: ["Heat a batch on a blowpipe until it glows faint red. A ceramic blowpipe does the job at first."]
	task.39B514F17D88F048.title: "Any Blowpipe"
	quest.75CA15FE92C5FED1.title: "Glass on the Pipe"
	quest.75CA15FE92C5FED1.quest_subtitle: "Gather a gob"
	quest.75CA15FE92C5FED1.quest_desc: ["Put a glass batch on the blowpipe and heat it in a forge until it glows faint red. It is ready to be worked or poured."]
	task.14FF266B39C7F41A.title: "Any Blowpipe With Glass"
	quest.45E755A928CFBE4F.title: "Lamp Glass"
	quest.45E755A928CFBE4F.quest_subtitle: "Glass for vacuum tubes"
	quest.45E755A928CFBE4F.quest_desc: ["Glasswork a batch into lamp glass. Your first electron tubes are built around it.", "", "It goes up the page from here, into the electron tube."]
	quest.4F75BAA3E75E2139.title: "Glass Panes"
	quest.4F75BAA3E75E2139.quest_subtitle: "Pour, wait, cut"
	quest.4F75BAA3E75E2139.quest_desc: ["Pour a hot batch onto the table and collect the pane with a gem saw. Fluid tanks need panes. A press and saw can make these in bulk later.", "", "You need the pouring table to pour onto and the gem saw to lift the pane off it.", "", "&7Pouring is done in the world, so JEI does not show it. The field guide explains glassworking and the pouring table."]
	quest.5B9EC2C565E27DDD.title: "Brass"
	quest.5B9EC2C565E27DDD.quest_subtitle: "Copper and zinc"
	quest.5B9EC2C565E27DDD.quest_desc: ["Alloy copper with zinc. Brass goes into hands, casings, mechanisms and your glass table.", "", "It is about nine parts copper to one part zinc, mixed in a vessel or a crucible."]
	quest.0BCCF8E580290C51.title: "A Pouring Table"
	quest.0BCCF8E580290C51.quest_subtitle: "Brass plated blocks"
	quest.0BCCF8E580290C51.quest_desc: ["Plate planks with brass sheets to build a pouring table. One craft gives 8 blocks, and a table can use up to sixteen."]
	quest.7EDC10CBD2F47713.title: "The Gem Saw"
	quest.7EDC10CBD2F47713.quest_subtitle: "Cuts poured glass free"
	quest.7EDC10CBD2F47713.quest_desc: ["A brass rod and any gem powder make a gem saw. Without one you can't collect what you pour."]
	quest.21ED8DF6429A34A8.title: "Brass Casing"
	quest.21ED8DF6429A34A8.quest_subtitle: "For the clever machines"
	quest.21ED8DF6429A34A8.quest_desc: ["Right-click a stripped log with a brass sheet.", "", "Mechanical crafters and brass funnels and tunnels are built on it."]
	quest.688C9952BD7DAC7A.title: "The Brass Hand"
	quest.688C9952BD7DAC7A.quest_subtitle: "Tier III"
	quest.688C9952BD7DAC7A.quest_desc: ["Forge a brass hand from a double sheet of brass. It becomes the working end of the deployer."]
	quest.54336AEB6B41ECF4.title: "Copper Casing"
	quest.54336AEB6B41ECF4.quest_subtitle: "For fluids"
	quest.54336AEB6B41ECF4.quest_desc: ["Right-click a stripped log with a copper sheet.", "", "Spouts, item drains and hose pulleys are built on it."]
	quest.6605E3F65F40421B.title: "Gold"
	quest.6605E3F65F40421B.quest_subtitle: "Not only for show"
	quest.6605E3F65F40421B.quest_desc: ["Gold sheets go into goggles and wrenches, and later into resistors.", "", "Its sheet is forged from a double ingot, like any other metal."]
	quest.2924A19257733F39.title: "The Basin"
	quest.2924A19257733F39.quest_subtitle: "Cast iron and a crucible"
	quest.2924A19257733F39.quest_desc: ["Five cast iron sheets around a crucible. Mixers and presses work on whatever sits in it.", "", "Cast iron is plain iron ore melted and cast, without the bloomery."]
	chapter.637A6CD809833B85.title: "First Machines"
	chapter.637A6CD809833B85.chapter_subtitle: ["From the first shaft to a steam engine on a boiler. Follow the big squares from left to right; everything above and below them is a side step."]
	quest.4383FE6DC9F10A57.title: "From the Workshop"
	quest.4383FE6DC9F10A57.quest_subtitle: "What this chapter is built from"
	quest.4383FE6DC9F10A57.quest_desc: ["Every machine on this page is made from steel and a short list of parts from &6Machine Materials&r: the three casings, electron tubes, rubber bars and glass panes.", "", "You do not need them all to start. The shaft and the water wheel only take steel and planks, so begin there and come back as each part is ready.", "", "&7Click any item in the task list to see its recipe."]
	quest.065283DD8C9428F0.title: "The Shaft"
	quest.065283DD8C9428F0.quest_subtitle: "Steel, cut to length"
	quest.065283DD8C9428F0.quest_desc: ["The &6shaft&r carries rotation from one block to the next, and every machine in this chapter has one in its recipe or on its side.", "", "Craft two &6steel rods&r with a chisel for eight shafts. There is no other metal for it: this is why steel had to come first.", "", "&7Later, a mechanical saw cuts four shafts from every rod."]
	quest.1F7DA261318DF2E3.title: "Cogwheels"
	quest.1F7DA261318DF2E3.quest_subtitle: "Turn corners, change speed"
	quest.1F7DA261318DF2E3.quest_desc: ["A shaft with planks is a &6cogwheel&r, and one more plank makes it a &6large cogwheel&r. Any wood will do.", "", "Cogwheels pass rotation sideways. A large one driving a small one doubles the speed, and the other way round halves it.", "", "&7Hover a cogwheel and hold [W] to ponder it. This works for every machine in the chapter."]
	quest.1ABA3964159A1EC6.title: "The Water Wheel"
	quest.1ABA3964159A1EC6.quest_subtitle: "Your first rotation"
	quest.1ABA3964159A1EC6.quest_desc: ["A shaft ringed with eight planks. Set it in flowing water and it turns for as long as the river runs.", "", "This is the first power source you can leave alone, and it is enough for a millstone, a rolling mill or a saw. It is slow and weak, so keep the machine close to the wheel.", "", "&7No river nearby? The Windmill, above the shaft, is the other way."]
	quest.7631670D49729B75.title: "The Rolling Mill"
	quest.7631670D49729B75.quest_subtitle: "Your belts come from here"
	quest.7631670D49729B75.quest_desc: ["Four steel rods, an &6andesite casing&r, two wrought iron sheets and two shafts.", "", "It is on the main path for one reason: in this pack a mechanical belt can only be made by rolling a rubber bar. No rolling mill, no belts.", "", "&7The casing is a stripped log with an aluminium sheet. See From the Workshop at the start of the chapter."]
	quest.0F4FFCC553754E01.title: "Mechanical Belts"
	quest.0F4FFCC553754E01.quest_subtitle: "Rubber, rolled"
	quest.0F4FFCC553754E01.quest_desc: ["Feed a &6rubber bar&r through the rolling mill to get a belt.", "", "Stretch a belt between two shafts and it carries both rotation and items. From here a workshop stops being a row of single machines.", "", "&7Rubber needs latex, and hevea trees only give it in a warm climate. A cold base has to import it."]
	quest.5F6A5DF1DDB369D0.title: "The Mechanical Crafter"
	quest.5F6A5DF1DDB369D0.quest_subtitle: "Recipes too big for a table"
	quest.5F6A5DF1DDB369D0.quest_desc: ["An &6electron tube&r, a &6brass casing&r and a crafting table give three crafters.", "", "Crafters are set side by side as a grid, one per filled slot of the recipe, all turned by the same rotation. The steam engine fills thirteen slots and a pair of crushing wheels twenty one.", "", "&7Use a wrench to point each crafter at its neighbour, so the items end up in one place."]
	quest.77E8FEE3CFB51FA9.title: "The Mechanical Mixer"
	quest.77E8FEE3CFB51FA9.quest_subtitle: "Stirring at scale"
	quest.77E8FEE3CFB51FA9.quest_desc: ["An andesite casing, a cogwheel and a &6whisk&r. Forge the whisk from a steel double sheet on the steel anvil.", "", "Set the mixer two blocks above a &6basin&r, leaving a gap between them, and give it rotation. It mixes whatever the basin holds, which replaces hand alloying and a good deal of barrel work.", "", "&7The basin is five cast iron sheets around a crucible, from Machine Materials."]
	quest.6A3528EA5BB423AA.title: "Lubrication Oil"
	quest.6A3528EA5BB423AA.quest_subtitle: "Tallow bridges the gap"
	quest.6A3528EA5BB423AA.quest_desc: ["An engine will not run dry, and oil wells are a long way off. Until then the oil comes from animal fat.", "", "Boil five &6blubber&r or &6animal fat&r with water in a pot to get 1000 mB of &6tallow&r. A heated mixer reduces 1000 mB of tallow to 100 mB of lubrication oil.", "", "One engine takes 1000 mB of oil, which is ten pots of tallow. Plan a hunt, or a herd.", "", "&7Heating a Basin, above the mixer, explains the heat."]
	quest.30A6BBEA21F07CA4.title: "The Engine, Dry"
	quest.30A6BBEA21F07CA4.quest_subtitle: "Thirteen parts in a grid"
	quest.30A6BBEA21F07CA4.quest_desc: ["Build the engine in mechanical crafters, three wide and five tall: a brass gear, two brass sheets, a copper block, two steel rods, two lead rings, two steel rivets and three brass screws.", "", "The gear, rings, rivets and screws are all forged on the anvil.", "", "&7Beryllium copper sheets in place of brass give two engines from the same parts."]
	quest.1F03424E9E9A8B8E.title: "The Steam Engine"
	quest.1F03424E9E9A8B8E.quest_subtitle: "Filled, not just built"
	quest.1F03424E9E9A8B8E.quest_desc: ["Put the dry engine on a depot under a &6spout&r holding 1000 mB of lubrication oil. The spout fills it and the engine is ready to mount.", "", "A spout cannot be filled from a bucket. Place it one block lower than the basin, on the side the basin pours from, and the oil runs straight in as the mixer makes it."]
	quest.7897D552FAE9A14E.title: "Engines on the Boiler"
	quest.7897D552FAE9A14E.quest_subtitle: "Water and heat in, rotation out"
	quest.7897D552FAE9A14E.quest_desc: ["Mount the engine on the side of the boiler and attach a shaft. With water in the tank and a hot firebox below, it turns.", "", "A steam engine gives far more than any wheel, and it works anywhere you can bring fuel and water. More engines share the same boiler, and its size and heat decide how many it can drive.", "", "This is the end of Early Tech. &6Metallurgy&r and &6Mechanical Engineering&r open the Industry chapters, and Oil \\& Heavy Industry can start alongside them.", "", "&7To finish, look at an engine mounted on your boiler."]
	quest.2FEC50E9A71B3FBC.title: "The Hand Crank"
	quest.2FEC50E9A71B3FBC.quest_subtitle: "Rotation by hand"
	quest.2FEC50E9A71B3FBC.quest_desc: ["A steel rod and three planks. Hold right-click to turn it.", "", "It is tiring and weak, but it lets you try a machine before any wheel is built."]
	quest.485CEE43F9D39852.title: "Gearboxes and Clutches"
	quest.485CEE43F9D39852.quest_subtitle: "Turning corners, cutting power"
	quest.485CEE43F9D39852.quest_desc: ["A &6gearbox&r is an andesite casing with four cogwheels, and it turns rotation through a corner. A &6clutch&r is a casing, a shaft and redstone dust, and it cuts the rotation while it has a redstone signal.", "", "A gearshift, made the same way with a cogwheel, reverses the direction instead."]
	quest.254A16FDA4A555D4.title: "The Wrench"
	quest.254A16FDA4A555D4.quest_subtitle: "Turn it, or take it down"
	quest.254A16FDA4A555D4.quest_desc: ["Three gold sheets, a cogwheel and a stick.", "", "Right-click a machine to rotate it. Sneak and right-click to pick it up in one piece, which is much kinder than breaking it."]
	quest.2F4E592525401308.title: "The Large Water Wheel"
	quest.2F4E592525401308.quest_subtitle: "Slower, stronger"
	quest.2F4E592525401308.quest_desc: ["A water wheel ringed with eight more planks.", "", "It turns slower and carries more stress, so it suits a line of several machines."]
	quest.4B06ABE5A6B0A401.title: "The Windmill"
	quest.4B06ABE5A6B0A401.quest_subtitle: "Power where there is no river"
	quest.4B06ABE5A6B0A401.quest_desc: ["The &6windmill bearing&r is a wooden slab, a steel block and a shaft. Each pair of &6sails&r is a steel ingot, two sticks and wool cloth.", "", "Build a frame of sails on the face of the bearing and right-click it to start. Eight sails is the least that will turn, and every sail after that adds power."]
	quest.1F2C3D0C968F75B1.title: "Mechanic: Stress"
	quest.1F2C3D0C968F75B1.quest_subtitle: "Every part has a cost"
	quest.1F2C3D0C968F75B1.quest_desc: ["A source gives a fixed amount of &6stress capacity&r, and each machine takes some while it runs. Ask for more than the source gives and the whole network stops.", "", "In this pack shafts, cogwheels and belts take a little stress too. A long line of shafts eats into a water wheel, so keep the runs short or add another wheel.", "", "&7A stressometer shows the load. Right-click an andesite casing with a compass for a speedometer, and craft that alone to switch between the two."]
	quest.33F33D58AF0AA6F0.title: "Engineer's Goggles"
	quest.33F33D58AF0AA6F0.quest_subtitle: "See the numbers"
	quest.33F33D58AF0AA6F0.quest_desc: ["Two lenses, a gold sheet and string.", "", "Wear them and look at any machine to read its speed and the stress it takes."]
	quest.2FCB684255DD8D98.title: "The Millstone"
	quest.2FCB684255DD8D98.quest_subtitle: "The quern, automated"
	quest.2FCB684255DD8D98.quest_desc: ["A cogwheel, a stone and an andesite casing.", "", "Drop grain or minerals on top and it grinds them while you do something else. It is the first machine worth leaving on a water wheel."]
	quest.0B85165F94CCC4AF.title: "Mechanic: Mechanical Grinding"
	quest.0B85165F94CCC4AF.quest_subtitle: "No more querning"
	quest.0B85165F94CCC4AF.quest_desc: ["A millstone takes over most of the work of the quern, from grain into flour to ore into powder. JEI lists the rest under Milling.", "", "Crushing wheels, further along, do the same work much faster and give more from each piece of ore."]
	quest.4AD09C6146FF79BC.title: "The Encased Fan"
	quest.4AD09C6146FF79BC.quest_subtitle: "Air that moves and washes"
	quest.4AD09C6146FF79BC.quest_desc: ["An andesite casing, a shaft and a &6propeller&r. Forge the propeller from a steel double sheet on the steel anvil.", "", "A fan blows items along and pushes them up chutes. Put water in front of it and everything in the stream is washed."]
	quest.2585EB3228FFD403.title: "The Mechanical Saw"
	quest.2585EB3228FFD403.quest_subtitle: "Logs in, planks out"
	quest.2585EB3228FFD403.quest_desc: ["An andesite casing, a shaft and a &6circular saw&r blade, forged from a steel double sheet on the steel anvil.", "", "It cuts whatever passes over it. It also cuts a steel rod into four shafts, twice what the chisel gives."]
	quest.6C243AC6C9FA913E.title: "Depots, Funnels and Chutes"
	quest.6C243AC6C9FA913E.quest_subtitle: "Items that move themselves"
	quest.6C243AC6C9FA913E.quest_desc: ["A &6depot&r holds one stack under a machine: right-click an andesite casing with a steel sheet.", "", "A &6funnel&r puts items into a container or takes them out: a steel sheet and a rubber bar make two.", "", "A &6chute&r drops items straight down: two wrought iron sheets and a steel ingot make four."]
	quest.272C1911E1E9063D.title: "Next: Logistics"
	quest.272C1911E1E9063D.quest_subtitle: "When the belts multiply"
	quest.272C1911E1E9063D.quest_desc: ["Sorting, filtering, mechanical arms, vaults and the package network have their own chapter, &6Logistics&r, under Branches.", "", "Nothing there is needed for the steam engine. Go when your workshop needs it."]
	quest.497468962FF86FCD.title: "Crushing Wheels"
	quest.497468962FF86FCD.quest_subtitle: "Sixteen steel sheets a pair"
	quest.497468962FF86FCD.quest_desc: ["Sixteen steel sheets, four planks and a stone, laid out in twenty one mechanical crafters, give a pair.", "", "Set the two wheels side by side, turning towards each other, and drop ore between them. You get more metal from each piece than a quern or millstone gives, and crushed ore is where ore processing starts."]
	quest.691D8F0502F34896.title: "The Deployer"
	quest.691D8F0502F34896.quest_subtitle: "A hand on a stick"
	quest.691D8F0502F34896.quest_desc: ["An electron tube, an andesite casing and a &6brass hand&r. Forge the hand from a brass double sheet on a wrought iron anvil or better.", "", "A deployer uses the item it holds on whatever is in front of it. Most multi-step assemblies later in the book are built by deployers."]
	quest.18B4684E3F8C9877.title: "The Spout"
	quest.18B4684E3F8C9877.quest_subtitle: "Liquid by the drop"
	quest.18B4684E3F8C9877.quest_desc: ["Right-click a &6copper casing&r with a rubber bar.", "", "A spout fills whatever sits on the depot or belt below it. It holds 1000 mB."]
	quest.6B1350672DA428E6.title: "Mechanic: Heating a Basin"
	quest.6B1350672DA428E6.quest_subtitle: "No blazes here"
	quest.6B1350672DA428E6.quest_desc: ["Some recipes ask for a heated basin. There are no blaze burners in this pack: build a &6charcoal forge&r directly under the basin and light it.", "", "The hotter the forge, the higher the heat level the basin sees, so work the bellows for recipes that ask for more.", "", "&7JEI marks these recipes as Heated Mixing."]
	quest.3826E43611E2B8D8.title: "The Fluid Tank"
	quest.3826E43611E2B8D8.quest_subtitle: "Copper and glass"
	quest.3826E43611E2B8D8.quest_desc: ["Two copper sheets and a &6glass pane&r. Tanks placed next to each other join into one.", "", "A tank is storage, and it is also the body of a boiler. Four make a small one."]
	quest.68384EB76EE3579A.title: "The Firebox"
	quest.68384EB76EE3579A.quest_subtitle: "The fire under the boiler"
	quest.68384EB76EE3579A.quest_desc: ["Four cast iron ingots and five double sheets of any bronze.", "", "Place a firebox directly under every column of the bottom layer of the tank, and light it. A wider boiler needs one for each column."]
	quest.75DD8B7801E6729C.title: "Mechanic: Boiler Heat"
	quest.75DD8B7801E6729C.quest_subtitle: "Hotter fire, more power"
	quest.75DD8B7801E6729C.quest_desc: ["The boiler reads the real temperature of the firebox.", "", "Below 200 °C it gives nothing. Wood, at 200 to 599 °C, gives passive heat. Charcoal, at 600 to 1199 °C, gives active heat. Coal, at 1200 °C or more, gives the most.", "", "Keep the firebox fed and work its bellows. The boiler cools as soon as the fire does.", "", "&7Field guide: Materialism Guide, Tech Progression, Firing a Boiler with a Firebox."]
	quest.4B64E1860F0CD56E.title: "The Steam Whistle"
	quest.4B64E1860F0CD56E.quest_subtitle: "Let everyone know"
	quest.4B64E1860F0CD56E.quest_desc: ["A copper ingot and a gold sheet. Place it on the boiler and give it a redstone signal.", "", "It is mostly for show. The pitch tells you how big the boiler is."]
	chapter.4CA18033E9918C81.title: "Metallurgy"
	chapter.4CA18033E9918C81.chapter_subtitle: ["The last of the hand work: black steel, red or blue steel and their anvils on the top line, tungsten from the bloomery below, meeting in tungsten steel."]
	quest.55A62CA035142BA9.title: "Weak Steel"
	quest.55A62CA035142BA9.quest_subtitle: "Steel, nickel, black bronze"
	quest.55A62CA035142BA9.quest_desc: ["Melt steel, nickel and black bronze together in a crucible. Three metals you already know make the base for every high steel.", "", "Black bronze is copper with silver and gold. If you made your tools from plain bronze, this is the time to find those two veins."]
	quest.7A367B3899281334.title: "Stainless Steel"
	quest.7A367B3899281334.quest_subtitle: "Chromium in the mix"
	quest.7A367B3899281334.quest_desc: ["Chromite gives chromium, and steel with chromium and nickel gives stainless steel. Your coke oven will need its rivets."]
	quest.71CD783A51AEFCC4.title: "Invar"
	quest.71CD783A51AEFCC4.quest_subtitle: "Cast iron and nickel"
	quest.71CD783A51AEFCC4.quest_desc: ["Alloy cast iron with nickel. This pack's invar has no wrought iron in it."]
	quest.434880CE96E79C78.title: "Constantan"
	quest.434880CE96E79C78.quest_subtitle: "Copper and nickel"
	quest.434880CE96E79C78.quest_desc: ["Alloy copper with nickel. Precision work and resistors both call for it."]
	quest.267B50313C33A0EC.title: "High Carbon Black Steel"
	quest.267B50313C33A0EC.quest_subtitle: "Weak steel and pig iron"
	quest.267B50313C33A0EC.quest_desc: ["Weld weak steel with pig iron.", "", "Welding needs flux and both ingots at welding heat."]
	quest.03DF4AC069B1A20C.title: "Black Steel"
	quest.03DF4AC069B1A20C.quest_subtitle: "Weak steel and pig iron"
	quest.03DF4AC069B1A20C.quest_desc: ["Work the high carbon ingot on your anvil until it is black steel.", "", "Seven double ingots for the anvil means fourteen of these."]
	quest.4D4B16AFB6009132.title: "The Black Steel Anvil"
	quest.4D4B16AFB6009132.quest_subtitle: "Tier V"
	quest.4D4B16AFB6009132.quest_desc: ["Seven double ingots of black steel. Tungsten steel double ingots weld at this tier.", "", "From here the road forks. Red steel and blue steel both lead to a tier VI anvil, and you only need one of them."]
	quest.2980CA10DCF53649.title: "Weak Red Steel"
	quest.2980CA10DCF53649.quest_subtitle: "An alloy for red steel"
	quest.2980CA10DCF53649.quest_desc: ["Melt black steel, steel, brass and rose gold together in a crucible.", "", "Rose gold is copper and gold."]
	quest.4BCCF3B12084EC6A.title: "High Carbon Red Steel"
	quest.4BCCF3B12084EC6A.quest_subtitle: "Welded with black steel"
	quest.4BCCF3B12084EC6A.quest_desc: ["Weld weak red steel with black steel."]
	quest.57A1E2E5DE8C94CE.title: "Red Steel"
	quest.57A1E2E5DE8C94CE.quest_subtitle: "One of two roads"
	quest.57A1E2E5DE8C94CE.quest_desc: ["Work the high carbon ingot into red steel. Red and blue steel both give tier VI, so you only need one. Pick whichever your ores make easier."]
	quest.73CEAE28B75BA2AF.title: "The Red Steel Flask"
	quest.73CEAE28B75BA2AF.quest_subtitle: "The last flask you will need"
	quest.73CEAE28B75BA2AF.quest_desc: ["A red steel flask is the best there is."]
	quest.4AFD46C4E17B9865.title: "The Red Steel Anvil"
	quest.4AFD46C4E17B9865.quest_subtitle: "Tier VI"
	quest.4AFD46C4E17B9865.quest_desc: ["Seven double ingots of red steel.", "", "Tier VI is the top of the ladder. Tungsten steel sheet and titanium sheet are forged here."]
	quest.6C5AC5683C78CC9F.title: "Weak Blue Steel"
	quest.6C5AC5683C78CC9F.quest_subtitle: "An alloy for blue steel"
	quest.6C5AC5683C78CC9F.quest_desc: ["Melt black steel, steel, bismuth bronze and sterling silver together in a crucible.", "", "Sterling silver is copper and silver."]
	quest.345DF35067603A81.title: "High Carbon Blue Steel"
	quest.345DF35067603A81.quest_subtitle: "Welded with black steel"
	quest.345DF35067603A81.quest_desc: ["Weld weak blue steel with black steel."]
	quest.4FC842DE27267E85.title: "Blue Steel"
	quest.4FC842DE27267E85.quest_subtitle: "One of two roads"
	quest.4FC842DE27267E85.quest_desc: ["Work the high carbon ingot into blue steel. Red and blue steel both give tier VI, so you only need one."]
	quest.357C35069EB133F7.title: "The Blue Steel Anvil"
	quest.357C35069EB133F7.quest_subtitle: "Tier VI"
	quest.357C35069EB133F7.quest_desc: ["Seven double ingots of blue steel.", "", "Tier VI is the top of the ladder. Tungsten steel sheet and titanium sheet are forged here."]
	quest.6534CE408E2080AD.title: "The Top of the Ladder"
	quest.6534CE408E2080AD.quest_subtitle: "Either anvil counts"
	quest.6534CE408E2080AD.quest_desc: ["This is the finest forging a hand can do. Either tier VI anvil unlocks this quest."]
	quest.1762504B49554E6B.title: "Titanium"
	quest.1762504B49554E6B.quest_subtitle: "Rutile through the bloomery"
	quest.1762504B49554E6B.quest_desc: ["Bloom rutile as you did tungsten, then forge the sheet at tier VI. Train casings and vaults are built from it."]
	quest.3271499464BB0C03.title: "Tungsten Steel Sheet"
	quest.3271499464BB0C03.quest_subtitle: "Tier VI"
	quest.3271499464BB0C03.quest_desc: ["Weld double ingots at tier V, then forge the sheet at tier VI.", "", "Two of these sheets go into the lathe, and the lathe is what lets machines take over from your hammer. &6Mechanical Engineering&r picks up from here."]
	quest.606AD540FA05AE36.title: "Beyond Any Forge"
	quest.606AD540FA05AE36.quest_subtitle: "The bloomery has no limit"
	quest.606AD540FA05AE36.quest_desc: ["No forge melts tungsten, iridium or osmium. You don't need to: a bloomery takes ore directly, at any melting point. Put in the ore and charcoal, wait, and work the bloom on an anvil, as you did with iron."]
	quest.459EE57E293E0ADD.title: "Platinum from the Bloomery"
	quest.459EE57E293E0ADD.quest_subtitle: "A precious catalyst"
	quest.459EE57E293E0ADD.quest_desc: ["Native platinum blooms like any other high-melting metal. Nitric acid needs a platinum catalyst, so you need some long before the aqua regia line."]
	quest.1D8FD1AC6F542028.title: "Cobalt Dust"
	quest.1D8FD1AC6F542028.quest_subtitle: "Bloomed, then ground"
	quest.1D8FD1AC6F542028.quest_desc: ["Bloom cobaltite and grind the ingot into dust on a quern. Drill bits are hardened with it."]
	quest.160A7DD20448F875.title: "A Raw Tungsten Bloom"
	quest.160A7DD20448F875.quest_subtitle: "Wolframite and charcoal"
	quest.160A7DD20448F875.quest_desc: ["Fill the bloomery with wolframite and charcoal.", "", "It works exactly as it did for iron: ore and charcoal in equal number, light it, and wait."]
	quest.77C5FA79B18F9D00.title: "A Refined Tungsten Bloom"
	quest.77C5FA79B18F9D00.quest_subtitle: "First anvil step"
	quest.77C5FA79B18F9D00.quest_desc: ["Work the raw bloom on a bronze anvil or better."]
	quest.2463197EDED2ACB9.title: "Tungsten"
	quest.2463197EDED2ACB9.quest_subtitle: "Two anvil steps"
	quest.2463197EDED2ACB9.quest_desc: ["Work the raw bloom into a refined bloom, then into an ingot. A bronze anvil is enough. Tungsten only needs about 921 °C to work, so an ordinary forge will do."]
	quest.0326AE0B5D645FB7.title: "High Carbon Tungsten Steel"
	quest.0326AE0B5D645FB7.quest_subtitle: "Weld at tier IV"
	quest.0326AE0B5D645FB7.quest_desc: ["Weld a tungsten ingot with weak steel.", "", "This weld needs a steel anvil, and the weak steel from the top line."]
	quest.2C8242A31D05E2FE.title: "Tungsten Steel"
	quest.2C8242A31D05E2FE.quest_subtitle: "The last hand-made metal"
	quest.2C8242A31D05E2FE.quest_desc: ["Work the high carbon ingot at tier IV. Nothing past this point can be made with TFC technology alone."]
	chapter.68CDBBC22E837421.title: "Mechanical Engineering"
	chapter.68CDBBC22E837421.chapter_subtitle: ["Springs and the precision mechanism, then the lathe, and behind it the press, pipes, the pump, the compressor and the drill."]
	quest.267036718EDC9182.title: "Marble"
	quest.267036718EDC9182.quest_subtitle: "A geology gate"
	quest.267036718EDC9182.quest_desc: ["The coiling wheel is cut from marble, so you need to find some. It is a metamorphic rock: check your map and prospect further afield if your region has none."]
	quest.262C3A51009AD09E.title: "The Trip Hammer"
	quest.262C3A51009AD09E.quest_subtitle: "Your arm gets a rest"
	quest.262C3A51009AD09E.quest_desc: ["A TFC trip hammer works an anvil from axle power. It is a taste of what rotation can do, long before Create."]
	quest.66E69C32CEF4A545.title: "Encased Chain Drives"
	quest.66E69C32CEF4A545.quest_subtitle: "Rotation in a straight run"
	quest.66E69C32CEF4A545.quest_desc: ["Chain drives carry rotation along a line without a run of loose shafts."]
	quest.10C466C5DA1ABC34.title: "The Coiling Wheel"
	quest.10C466C5DA1ABC34.quest_subtitle: "Smooth marble, shaped"
	quest.10C466C5DA1ABC34.quest_desc: ["Four smooth marble and a marble slab.", "", "Chisel the raw marble smooth first. This wheel is the only reason the chapter starts with a rock."]
	quest.49704F8B066BA61F.title: "The Spring Coiling Machine"
	quest.49704F8B066BA61F.quest_subtitle: "Wire into springs"
	quest.49704F8B066BA61F.quest_desc: ["Coiling wheel, iron ingots and a casing.", "", "Give it rotation and feed it rods or wire. Each kind of spring has its own recipe in JEI under Coiling."]
	quest.3A2ACC6AD0E5453C.title: "Steel Springs"
	quest.3A2ACC6AD0E5453C.quest_subtitle: "Everything ahead needs these"
	quest.3A2ACC6AD0E5453C.quest_desc: ["Feed steel rods to the coiling machine.", "", "Springs go into the curving press, the helve hammer, the centrifuge, the vibrating table, the lathe and the compressor."]
	quest.73252B2E2A39FF75.title: "The Centrifuge"
	quest.73252B2E2A39FF75.quest_subtitle: "Separate by weight"
	quest.73252B2E2A39FF75.quest_desc: ["Four steel springs, a shaft, logs and a casing.", "", "Neodymium magnets and the better motors pass through it later."]
	quest.7F15FEEA3DD4D462.title: "The Curving Press"
	quest.7F15FEEA3DD4D462.quest_subtitle: "Bends sheet to shape"
	quest.7F15FEEA3DD4D462.quest_desc: ["Casing, two steel springs and a shaft.", "", "Each of its heads bends a different profile. Connectors, insulators and turbine blades are all curved here."]
	quest.0422EDAE0A58A0ED.title: "The Helve Hammer"
	quest.0422EDAE0A58A0ED.quest_subtitle: "An anvil that works itself"
	quest.0422EDAE0A58A0ED.quest_desc: ["Built with mechanical crafters. It works blooms and ingots at their forging temperature, so high carbon steel stops being hand work."]
	quest.5B164516F84AD257.title: "Blooms by Machine"
	quest.5B164516F84AD257.quest_subtitle: "The helve hammer"
	quest.5B164516F84AD257.quest_desc: ["The helve hammer works raw and refined blooms at forging heat, so the bloomery line can run without you."]
	quest.182D4D62DB0D6C95.title: "The Vibrating Table"
	quest.182D4D62DB0D6C95.quest_subtitle: "Shakes things apart"
	quest.182D4D62DB0D6C95.quest_desc: ["Four steel springs, a mechanical piston and a slab.", "", "Rose quartz, ferrite magnets and several late assemblies have a vibrating step."]
	quest.1EB407D7875A2867.title: "The Mechanical Piston"
	quest.1EB407D7875A2867.quest_subtitle: "Pushing blocks"
	quest.1EB407D7875A2867.quest_desc: ["A mechanical piston moves whole structures in a straight line. Add extension poles to reach further."]
	quest.72141227F2942F30.title: "Small Invar Springs"
	quest.72141227F2942F30.quest_subtitle: "Roll, then coil"
	quest.72141227F2942F30.quest_desc: ["Roll invar into wire, then coil the wire into small springs.", "", "The precision mechanism and the steel mechanism both take them."]
	quest.25C333920E309964.title: "The Precision Mechanism"
	quest.25C333920E309964.quest_subtitle: "Your first big assembly"
	quest.25C333920E309964.quest_desc: ["Build a sequenced assembly line with deployers, starting from a brass sheet. It is the first thing here you can't make by hand.", "", "The assembly loops five times and sometimes fails, giving back a part instead. Set the deployers along a belt so the sheet passes each one in order.", "", "&7Hold [W] on the mechanism to see the sequence."]
	quest.4198BE0839E346F3.title: "The Lathe"
	quest.4198BE0839E346F3.quest_subtitle: "The door out of hand metalworking"
	quest.4198BE0839E346F3.quest_desc: ["Built with mechanical crafters from tungsten steel sheet, a precision mechanism, steel springs and a steel block. Everything you've done with a hammer can now start to run by itself.", "", "The tungsten steel is the reason for the whole Metallurgy chapter. Nothing softer will do for the tool that cuts every other part."]
	quest.73A51CF0E0021564.title: "The Concave Curving Head"
	quest.73A51CF0E0021564.quest_subtitle: "A block, turned"
	quest.73A51CF0E0021564.quest_desc: ["Turn a steel block on the lathe.", "", "This one part is what the mechanical press was waiting for."]
	quest.641F53332629C0AE.title: "The Mechanical Press"
	quest.641F53332629C0AE.quest_subtitle: "Finally"
	quest.641F53332629C0AE.quest_desc: ["Casing, curving head and shaft. Plated blocks, tracks and any sequenced assembly with a pressing step open up now.", "", "Set it two blocks above a depot, a belt or a basin, like the mixer. Over a basin it compacts, and with a heated basin it does the hot pressing recipes too."]
	quest.2972B973AE95E687.title: "Fluid Pipes"
	quest.2972B973AE95E687.quest_subtitle: "Turned from copper rod"
	quest.2972B973AE95E687.quest_desc: ["Turn copper rods on the lathe. Cast iron and steel pipes come from the same machine."]
	quest.1D6059AD73D48F2A.title: "The Fluid Scanner"
	quest.1D6059AD73D48F2A.quest_subtitle: "A filter for liquids"
	quest.1D6059AD73D48F2A.quest_desc: ["Two copper rods around a glass bottle. Right-click a fluid source or a tank with it, and it remembers that fluid.", "", "A scanner that holds a fluid works as a filter for it: put it in a filter slot and only that fluid passes. It does for liquids what a filter does for items.", "", "&7It does not find oil. For that, see Oil Seeps in Oil \\& Heavy Industry."]
	quest.0680614F100F1452.title: "The Mechanical Pump"
	quest.0680614F100F1452.quest_subtitle: "Pipe and cogwheel"
	quest.0680614F100F1452.quest_desc: ["Apply a cogwheel to a fluid pipe. Fluids move at last.", "", "A pump only pushes a few blocks either way, and faster rotation reaches further. Until now every fluid in this book was moved by bucket or by a basin pouring into its neighbour."]
	quest.6CF2CE946DFD4FDC.title: "The Compressor"
	quest.6CF2CE946DFD4FDC.quest_subtitle: "Pressure and vacuum"
	quest.6CF2CE946DFD4FDC.quest_desc: ["Pump, steel springs and a casing. Sulfur, rubber and acids all pass through this.", "", "JEI lists its recipes as pressurizing and vacuumizing. Many of them also need heat under the machine, as a basin does."]
	quest.7D633BB109B733B5.title: "The Drill Bit"
	quest.7D633BB109B733B5.quest_subtitle: "Tungsten steel, cobalt-hardened"
	quest.7D633BB109B733B5.quest_desc: ["A sequenced assembly starting from a tungsten steel rod, with cobalt dust pressed in and a belt grinder to finish."]
	quest.5AFE1596BDF4C963.title: "The Belt Grinder"
	quest.5AFE1596BDF4C963.quest_subtitle: "Fine finishing"
	quest.5AFE1596BDF4C963.quest_desc: ["A grinder belt on a casing and a shaft. Terne plate and the drill bit both finish here."]
	quest.715DEDD536238E8F.title: "The Mechanical Drill"
	quest.715DEDD536238E8F.quest_subtitle: "Mining without arms"
	quest.715DEDD536238E8F.quest_desc: ["Drill bit, casing and shaft.", "", "With pressing, pipes and pressure, the workshop can become a plant. &6Oil \\& Heavy Industry&r is next on the main road, and Logistics, Transport and Warfare have all opened on the side."]
	chapter.349B3624F5718ADC.title: "Oil \\& Heavy Industry"
	chapter.349B3624F5718ADC.chapter_subtitle: ["Steel casings and the first chemical vat, coke and the industrial blast furnace, then oil: finding it, pumping it and distilling it."]
	quest.525BFFAF21C13104.title: "Steel Casing"
	quest.525BFFAF21C13104.quest_subtitle: "Steel over wood"
	quest.525BFFAF21C13104.quest_desc: ["Right-click a stripped log with a steel sheet.", "", "TFMG's machines are built on it, and so are carbon brushes and the polarizer."]
	quest.481BE4A7DDA74CB8.title: "The Steel Fluid Tank"
	quest.481BE4A7DDA74CB8.quest_subtitle: "Bulk storage"
	quest.481BE4A7DDA74CB8.quest_desc: ["Two steel sheets and a glass pane.", "", "It is also the body of the steel chemical vat and a part of the pumpjack."]
	quest.72F7FFB6EAFABC67.title: "The Cast Iron Chemical Vat"
	quest.72F7FFB6EAFABC67.quest_subtitle: "Your first reactor"
	quest.72F7FFB6EAFABC67.quest_desc: ["Four cast iron sheets, eight cast iron rivets, four pewter sheets and a cast iron fluid tank, built in mechanical crafters.", "", "A vat is a tank that reacts what you put in it. The machines mounted on it, such as a mixer or electrodes, and the heat under it decide which recipes it can run.", "", "&7Some recipes later insist on a steel or a fireproof vat. JEI shows which vats each recipe accepts."]
	quest.53667460FB59917C.title: "The Steel Mechanism"
	quest.53667460FB59917C.quest_subtitle: "The precision of the big machines"
	quest.53667460FB59917C.quest_desc: ["A sequenced assembly on steel sheet, with steel cogwheels and small invar springs.", "", "It loops five times, like the precision mechanism, and can fail the same way."]
	quest.553C132D558BF2E0.title: "Heavy Machinery Casing"
	quest.553C132D558BF2E0.quest_subtitle: "Black steel over wood"
	quest.553C132D558BF2E0.quest_desc: ["Right-click a stripped log with a black steel sheet.", "", "The distillation controller, the pumpjack, the electrode holder and the fireproof vat all start from one."]
	quest.424A36670604FA40.title: "The Coke Oven"
	quest.424A36670604FA40.quest_subtitle: "Stainless rivets, industrial iron"
	quest.424A36670604FA40.quest_desc: ["Eight stainless steel rivets around an industrial iron block. Rivets press out of stamens, which turn on the lathe.", "", "The recipe gives nine oven blocks, and they are built into one multiblock. Hold [W] on a block to see its shape."]
	quest.0456EB0CE1ABAAC7.title: "Coal Coke"
	quest.0456EB0CE1ABAAC7.quest_subtitle: "Bituminous coal, baked"
	quest.0456EB0CE1ABAAC7.quest_desc: ["Bake bituminous coal in the coke oven. Coke also gives you graphite electrodes later on."]
	quest.6B558D63E1943040.title: "Electrodes"
	quest.6B558D63E1943040.quest_subtitle: "For splitting water"
	quest.6B558D63E1943040.quest_desc: ["Build an electrode holder and cut a graphite electrode from a block of coal coke. Fitted to a vat, they split water and brine."]
	quest.6131B6489C98424E.title: "The Industrial Blast Furnace"
	quest.6131B6489C98424E.quest_subtitle: "A tower of fireproof brick"
	quest.6131B6489C98424E.quest_desc: ["Build the tower around a blast furnace output, with fireproof bricks and a hatch. It runs ore, flux and coke into molten iron, and leaves slag behind.", "", "&7Hold [W] on the blast furnace output to see the tower."]
	quest.125CA15540D4B2CE.title: "The Casting Basin"
	quest.125CA15540D4B2CE.quest_subtitle: "Molten metal, shaped"
	quest.125CA15540D4B2CE.quest_desc: ["Fire bricks, cast iron and a cast iron pipe.", "", "Slag from the blast furnace, and later silicon and polyethylene, are cast into shape here."]
	quest.64CAB6A19D0597BE.title: "Oil Seeps"
	quest.64CAB6A19D0597BE.quest_subtitle: "The deposit is underneath"
	quest.64CAB6A19D0597BE.quest_desc: ["Oil lies at the very bottom of the world, in pockets in the bedrock. Where there is a pocket, &6oil seeps&r mark the surface above it.", "", "So you find oil with your eyes, not with a tool. Walk, look for seeps on the ground, and mark the place: the deposit is straight below.", "", "Heating a piece of seep gives 10 mB of crude oil, enough for a first look before any drilling.", "", "&7To finish, look at an oil seep."]
	quest.146D1F996AA15438.title: "The Pumpjack"
	quest.146D1F996AA15438.quest_subtitle: "Oil from near bedrock"
	quest.146D1F996AA15438.quest_desc: ["Base, hammer and crank, built over the seeps you found. This is what your fuel, plastics and resistors depend on.", "", "The base takes a heavy machinery casing, two steel mechanisms, steel and industrial pipes, rope and a steel fluid tank.", "", "&7Hold [W] on the pumpjack base to see how the three parts go together."]
	quest.7BFBBF1AECE1685A.title: "Crude Oil"
	quest.7BFBBF1AECE1685A.quest_subtitle: "The black river"
	quest.7BFBBF1AECE1685A.quest_desc: ["Pump crude oil from a deposit near bedrock. Heat and pressure made it once, and they won't make more: plan your use."]
	quest.36F1DB5800AFAB91.title: "The Distillation Tower"
	quest.36F1DB5800AFAB91.quest_subtitle: "Crude to everything"
	quest.36F1DB5800AFAB91.quest_desc: ["Build the controller, then a tower on top of it. Crude gives heavy oil, and heavy oil gives lubrication oil without any tallow.", "", "From here the road is &6Electricity&r, then &6Chemistry&r. Both lean on what this chapter built."]
	quest.415471748924E2BC.title: "The Oil Firebox"
	quest.415471748924E2BC.quest_subtitle: "Heat without stoking"
	quest.415471748924E2BC.quest_desc: ["TFMG's firebox burns liquid fuel instead of wood. It is the way to keep a boiler hot without anyone feeding it."]
	chapter.5B80C2E21F80F61B.title: "Electricity"
	chapter.5B80C2E21F80F61B.chapter_subtitle: ["Everything on this page feeds one quest. The converter and its parts come in from the left, the generator coil from below, brushes and magnets from the side, and they meet in your first current."]
	quest.769AE59AEDC4D448.title: "Mechanic: Three Mods, One Grid"
	quest.769AE59AEDC4D448.quest_subtitle: "Who does what"
	quest.769AE59AEDC4D448.quest_desc: ["New Age generates power and turns it back into rotation. Electro Energetics carries it: wires, poles, transformers, meters, lamps and heaters. TFMG machines consume it. The Converter translates between them, and every watt starts as rotation turning a generator."]
	quest.1002FC2978C93276.title: "Copper Wire"
	quest.1002FC2978C93276.quest_subtitle: "Rolled from rod"
	quest.1002FC2978C93276.quest_desc: ["Roll copper rods into wire. Nearly every wire in the pack comes from the rolling mill."]
	quest.24C7CB06BECAA84D.title: "Empty Spools"
	quest.24C7CB06BECAA84D.quest_subtitle: "Turned from lumber"
	quest.24C7CB06BECAA84D.quest_desc: ["Turn lumber on the lathe into empty spools. Wire is always handled on a spool."]
	quest.1DC0C707DDC8A17D.title: "A Copper Wire Spool"
	quest.1DC0C707DDC8A17D.quest_subtitle: "Wound by deployers"
	quest.1DC0C707DDC8A17D.quest_desc: ["Deployers wind copper wire onto an empty spool on a sequenced assembly line. Use the spool on one connector, then on another, to string a wire between them."]
	quest.42A35D1AB65873B0.title: "Connectors"
	quest.42A35D1AB65873B0.quest_subtitle: "Fired clay, copper terminal"
	quest.42A35D1AB65873B0.quest_desc: ["A clay block curved twice by the W-shaped head, fired by heated pressurizing, fitted with a copper rod and pressed. Every wire runs between connectors."]
	quest.520876E156CDA0F2.title: "Core Laminations"
	quest.520876E156CDA0F2.quest_subtitle: "Thin iron, cut to shape"
	quest.520876E156CDA0F2.quest_desc: ["Cut wrought iron sheet into laminations, or make silicon steel ones from steel sheet. Converters, transformers and motors are built around them."]
	quest.301F3ABE79A6E71C.title: "The Converter"
	quest.301F3ABE79A6E71C.quest_subtitle: "The interpreter"
	quest.301F3ABE79A6E71C.quest_desc: ["Four connectors, two electron tubes, two wire spools and a lamination. Its facing side bridges to the block in front of it. A wrench switches it between input, which feeds the grid, and output, which draws from it."]
	quest.415B059787BCE3D5.title: "Silicon"
	quest.415B059787BCE3D5.quest_subtitle: "From the blast furnace"
	quest.415B059787BCE3D5.quest_desc: ["Run silica sand through the industrial blast furnace, then cast the liquid silicon. Magnetic alloy needs it."]
	quest.66528BEC40683B2B.title: "Magnetic Alloy"
	quest.66528BEC40683B2B.quest_subtitle: "Nickel, steel and silicon"
	quest.66528BEC40683B2B.quest_desc: ["Two nickel, two steel and a silicon ingot in a heated mixer give two magnetic alloy ingots."]
	quest.33CE7FE82A19CE7B.title: "Electromagnetic Coils"
	quest.33CE7FE82A19CE7B.quest_subtitle: "Wound with copper"
	quest.33CE7FE82A19CE7B.quest_desc: ["Magnetic alloy and two steel rings give unfinished coils. Wind them with a copper spool in TFMG's winding machine.", "", "The copper spool is wound from the copper wire at the start of the top line."]
	quest.47900981E1A6F408.title: "The Generator Coil"
	quest.47900981E1A6F408.quest_subtitle: "Rotation into current"
	quest.47900981E1A6F408.quest_desc: ["Built with mechanical crafters from a shaft, manganese rods, tungsten steel and stainless sheets and eight electromagnetic coils. A coil only generates when magnets surround it, and it never makes rotation itself."]
	quest.0DE36789532A32C8.title: "Carbon Brushes"
	quest.0DE36789532A32C8.quest_subtitle: "Collecting the current"
	quest.0DE36789532A32C8.quest_desc: ["Graphite and copper pressed in a steel casing, sintered and ground to size. Brushes on the coil line push the current into the block next to them."]
	quest.0EF1C3B4B0ECAD4A.title: "Magnetite Blocks"
	quest.0EF1C3B4B0ECAD4A.quest_subtitle: "The natural magnet"
	quest.0EF1C3B4B0ECAD4A.quest_desc: ["Compact forty magnetite powder into a block. It is the weakest magnet, and the first one you can make."]
	quest.1C87D51F077F0648.title: "First Current"
	quest.1C87D51F077F0648.quest_subtitle: "Rotation into the grid"
	quest.1C87D51F077F0648.quest_desc: ["Line coils along a driven shaft, surround them with magnet blocks and put carbon brushes on the line. Face a converter in input mode to the brushes. Goggles on a coil show what it generates.", "", "Nothing here makes rotation. A steam engine or a wheel still does the work, and the coils turn part of its stress into current.", "", "&7Field guide: Materialism Guide, Electricity. To finish, look at a placed generator coil."]
	quest.10B98D1834C794B2.title: "Mechanic: Powering TFMG Machines"
	quest.10B98D1834C794B2.quest_subtitle: "One converter per machine"
	quest.10B98D1834C794B2.quest_desc: ["TFMG cables are gone. A converter in output mode joins TFMG's electrical network on its facing side, and each machine needs a converter touching it. That is how the freezer, the polarizer and vat electrodes run."]
	quest.3B50A4885DD5601D.title: "The Energiser"
	quest.3B50A4885DD5601D.quest_subtitle: "Charging parts"
	quest.3B50A4885DD5601D.quest_desc: ["Apply a soldered copper lightning rod to a casing, and feed the energiser from a converter in output mode. Capacitors, resistors and better magnets all finish under it."]
	quest.34526F2A32AD50EF.title: "Weak Ferrite Magnets"
	quest.34526F2A32AD50EF.quest_subtitle: "A better magnet"
	quest.34526F2A32AD50EF.quest_desc: ["Loop a magnetite block four times through zinc powder, vibration, pressing and energising. Better magnets turn more of the shaft's stress into current."]
	quest.012191E920B74F40.title: "The Voltmeter"
	quest.012191E920B74F40.quest_subtitle: "For the polarizer"
	quest.012191E920B74F40.quest_desc: ["Steel screws, a compass and aluminium parts around a weak ferrite magnet.", "", "The polarizer in Electronics \\& Magnets is built around one."]
	quest.3AFD6C20F2812B0C.title: "Motor Extensions"
	quest.3AFD6C20F2812B0C.quest_subtitle: "More stress capacity"
	quest.3AFD6C20F2812B0C.quest_desc: ["An extension raises a motor's stress capacity without a bigger motor."]
	quest.580A43FA01E8D98A.title: "The Basic Motor"
	quest.580A43FA01E8D98A.quest_subtitle: "Current back into rotation"
	quest.580A43FA01E8D98A.quest_desc: ["Built with mechanical crafters. Feed it from a converter in output mode facing it, and set its speed with a wrench. A redstone signal stops it.", "", "With a generator at one end and a motor at the other, power can leave the engine house. &6Power Grid&r carries it, and &6Chemistry&r puts it to work in the vats."]
	chapter.140DECE8B8D1EB61.title: "Power Grid"
	chapter.140DECE8B8D1EB61.chapter_subtitle: ["Carrying current: insulation, earthing, protection, storage and the transformer, with poles, lamps and heaters on the side."]
	quest.5A32AE66513D4EC2.title: "Mechanic: Real Circuits"
	quest.5A32AE66513D4EC2.quest_subtitle: "Out and back"
	quest.5A32AE66513D4EC2.quest_desc: ["Like real circuits, every load needs a path out and back. Run two wires, or send the current back through the ground with a ground rod. Every wire has resistance, and its losses grow with the square of the current."]
	quest.51A427A469BA737E.title: "Rubber Strips"
	quest.51A427A469BA737E.quest_subtitle: "Cut from the bar"
	quest.51A427A469BA737E.quest_desc: ["Cut rubber bars into strips. Insulation starts here.", "", "Insulated wire and, later, computers use them."]
	quest.0C99B6A0089FB629.title: "Insulated Wire"
	quest.0C99B6A0089FB629.quest_subtitle: "Safe to touch"
	quest.0C99B6A0089FB629.quest_desc: ["Copper wire wrapped in a rubber strip, curved shut. Wind it onto a spool for a wire you can run where people walk."]
	quest.0F3DC65FB68165F8.title: "Pole Mounts"
	quest.0F3DC65FB68165F8.quest_subtitle: "Lines up high"
	quest.0F3DC65FB68165F8.quest_desc: ["Steel sheet and rods. Overhead lines hang from pole mounts."]
	quest.57B7A443029C4D63.title: "Porcelain Insulators"
	quest.57B7A443029C4D63.quest_subtitle: "Fired onto a stainless rod"
	quest.57B7A443029C4D63.quest_desc: ["Clay discs curved and fired onto a stainless steel rod, four sheds deep. They keep the line off the pole."]
	quest.24BE5BDD0EF344D2.title: "ACSR Conductor"
	quest.24BE5BDD0EF344D2.quest_subtitle: "For long overhead lines"
	quest.24BE5BDD0EF344D2.quest_desc: ["Aluminium strands laid around a steel core: light, strong and cheap per metre of line."]
	quest.4D85698FC147F28A.title: "Glass Insulator Strings"
	quest.4D85698FC147F28A.quest_subtitle: "For the highest voltages"
	quest.4D85698FC147F28A.quest_desc: ["Glass discs strung on a steel rod with wire ties. Hang them in strings for high-voltage lines."]
	quest.2CAE2CF069EBC1C2.title: "Concrete Poles"
	quest.2CAE2CF069EBC1C2.quest_subtitle: "Rebar and concrete"
	quest.2CAE2CF069EBC1C2.quest_desc: ["Rebar concrete with a wire spool through it. Poles carry your lines across the land."]
	quest.5DA6B795E01FC291.title: "The Ground Rod"
	quest.5DA6B795E01FC291.quest_subtitle: "Earth the return"
	quest.5DA6B795E01FC291.quest_desc: ["Copper rods soldered onto a connector. Connect your negative to it, and the earth carries the return current."]
	quest.61F3825395213EFA.title: "The Resistive Heater"
	quest.61F3825395213EFA.quest_subtitle: "Current into heat"
	quest.61F3825395213EFA.quest_desc: ["A constantan coil packed in magnesia, bent into a horseshoe on a casing. It heats boilers, basins and TFMG vats placed above it, just like a burner.", "", "This is the heat source that needs no stoking: where a quest earlier told you to light a forge under a basin, a heater now does the same job from the grid."]
	quest.0120F3539E65904F.title: "Electric Light"
	quest.0120F3539E65904F.quest_subtitle: "Tungsten in a brass socket"
	quest.0120F3539E65904F.quest_desc: ["A tungsten-filament lamp in a brass socket, built with mechanical crafters. Bulbs stop mobs spawning even when switched off, and a burnt-out bulb is repaired with new tungsten wire."]
	quest.22B49234755C04AF.title: "Fuses"
	quest.22B49234755C04AF.quest_subtitle: "A short circuit draws enormous current"
	quest.22B49234755C04AF.quest_desc: ["Silver wire in a glass tube with brass caps. A fuse melts when overloaded: set its rating by holding Ctrl and scrolling, and replace it when it blows."]
	quest.3C6A4736CBB85D4E.title: "Switching"
	quest.3C6A4736CBB85D4E.quest_subtitle: "Cut it off"
	quest.3C6A4736CBB85D4E.quest_desc: ["Cut-off switches, relays and potentiometers control the circuit. Redstone versions let contraptions do the switching."]
	quest.6137DA88F404CDCA.title: "Circuit Breakers"
	quest.6137DA88F404CDCA.quest_subtitle: "Trip and reset"
	quest.6137DA88F404CDCA.quest_desc: ["A miniature circuit breaker trips like a fuse but can be reset."]
	quest.29527B589DA406BB.title: "Measuring"
	quest.29527B589DA406BB.quest_subtitle: "Know your current"
	quest.29527B589DA406BB.quest_desc: ["An ammeter goes in series along the wire. A clamp meter reads any wire you point it at."]
	task.5B2317850217A849.title: "Any Measuring"
	quest.529D80B9E7D2EDA1.title: "The Voltmeter"
	quest.529D80B9E7D2EDA1.quest_subtitle: "Across two wires"
	quest.529D80B9E7D2EDA1.quest_desc: ["A voltmeter goes in parallel, across two wires, and reads the voltage between them."]
	quest.3E6DBBC64CC3DDC8.title: "Nickel-Iron Accumulators"
	quest.3E6DBBC64CC3DDC8.quest_subtitle: "Edison cells"
	quest.3E6DBBC64CC3DDC8.quest_desc: ["Nickel and steel plates in lye, in an aluminium case. Each stores energy at 24 V, and ten in series charge at 240 V."]
	quest.6419E40213E96F82.title: "The Electric Pump"
	quest.6419E40213E96F82.quest_subtitle: "A pump with its own motor"
	quest.6419E40213E96F82.quest_desc: ["A mechanical pump with a small built-in motor. It runs straight off the grid."]
	quest.457B13554BABAED7.title: "Transformer Oil"
	quest.457B13554BABAED7.quest_subtitle: "Hydrotreated or vegetable"
	quest.457B13554BABAED7.quest_desc: ["Heat heavy oil with hydrogen, or soybean oil, in a mixer. Transformers and paper-insulated cable both need it."]
	quest.344D06A670281885.title: "Paper-Insulated Cable"
	quest.344D06A670281885.quest_subtitle: "For high voltage near people"
	quest.344D06A670281885.quest_desc: ["Paper soaked in transformer oil under a lead sheath. Run it where high voltage passes close to people."]
	quest.0B39E1A1A5256A14.title: "The Transformer Core"
	quest.0B39E1A1A5256A14.quest_subtitle: "Stacked and wound"
	quest.0B39E1A1A5256A14.quest_desc: ["Stack laminations, press them, then wind paper and coils around them.", "", "It is the heart of the transformer at the end of this line."]
	quest.73794CFAE794A739.title: "The Transformer"
	quest.73794CFAE794A739.quest_subtitle: "Step it up, step it down"
	quest.73794CFAE794A739.quest_desc: ["Fit connectors and a steel shell, then fill it with transformer oil. The turns ratio sets the voltage ratio. Step the voltage up at the plant and down again near the machines: same power, less current, far smaller losses.", "", "&7Field guide: Materialism Guide, Electricity explains voltage, current and losses with worked numbers."]
	quest.7DA23E682C2EF89A.title: "The SF6 Breaker"
	quest.7DA23E682C2EF89A.quest_subtitle: "Smothering the arc"
	quest.7DA23E682C2EF89A.quest_desc: ["An evacuated stainless tank filled with sulfur hexafluoride switches high-voltage lines without an arc."]
	quest.5E176F660AA5F2F3.title: "Cooling the Transformer"
	quest.5E176F660AA5F2F3.quest_subtitle: "Radiators and oil"
	quest.5E176F660AA5F2F3.quest_desc: ["Surround the core with radiator panels and cover it in transformer oil to raise its rating. An overloaded transformer gets damaged."]
	chapter.6CEAC98F667A3FC6.title: "Chemistry"
	chapter.6CEAC98F667A3FC6.chapter_subtitle: ["Sulfuric acid and what it opens on the top line, the gases that need electricity on the bottom one. They meet in tantalum, the steel vat and the first plastic."]
	quest.01F1A23F32EF34B3.title: "Slag"
	quest.01F1A23F32EF34B3.quest_subtitle: "The blast furnace leftovers"
	quest.01F1A23F32EF34B3.quest_desc: ["Your blast furnace leaves molten slag. Cast it into blocks, then crush them. Don't throw it away: this pack has no vanadium ore."]
	quest.45855358BC584855.title: "Vanadium"
	quest.45855358BC584855.quest_subtitle: "A catalyst from waste"
	quest.45855358BC584855.quest_desc: ["Pressurize slag with salt, saltpeter and water in a heated compressor. It only gives vanadium 10% of the time, or 30% once you have sulfuric acid."]
	quest.29F12A51E7A13B5A.title: "Sulfur Dioxide"
	quest.29F12A51E7A13B5A.quest_subtitle: "Burn it under pressure"
	quest.29F12A51E7A13B5A.quest_desc: ["Pressurize sulfur powder in a heated compressor."]
	quest.72FA8D26A907117F.title: "Sulfur Trioxide"
	quest.72FA8D26A907117F.quest_subtitle: "Vanadium does the work"
	quest.72FA8D26A907117F.quest_desc: ["Pressurize sulfur dioxide with a vanadium nugget.", "", "This is the contact process, the way sulfuric acid is really made."]
	quest.3B8D69CA5AD743F7.title: "Sulfuric Acid"
	quest.3B8D69CA5AD743F7.quest_subtitle: "The king of chemicals"
	quest.3B8D69CA5AD743F7.quest_desc: ["Pressurize sulfur trioxide with water. A chemical vat can also make it from sulfur and saltpeter powder.", "", "Almost every line after this one starts with a splash of it: sulfates, hydrochloric and hydrofluoric acid, leaching, etching circuit boards."]
	quest.1D7F69AC334C7B2F.title: "Copper Sulfate"
	quest.1D7F69AC334C7B2F.quest_subtitle: "Blue crystals"
	quest.1D7F69AC334C7B2F.quest_desc: ["Pressurize copper powder with sulfuric acid and water.", "", "It is one half of the galvanic cell above."]
	quest.334C3814FAD890A1.title: "Zinc Sulfate"
	quest.334C3814FAD890A1.quest_subtitle: "One half of a battery"
	quest.334C3814FAD890A1.quest_desc: ["Pressurize sphalerite powder with sulfuric acid and water.", "", "With copper sulfate, it makes the galvanic cell."]
	quest.359E833B6CEA1DDD.title: "The Galvanic Cell"
	quest.359E833B6CEA1DDD.quest_subtitle: "A battery you assemble"
	quest.359E833B6CEA1DDD.quest_desc: ["A Daniell cell on an assembly line: steel casing, large vessel, water, both sulfates, salt, zinc and copper rods, copper wire, then a press. It powers TFMG machines directly, without a generator, until it runs out."]
	quest.641AD4D1666F216F.title: "Hydrochloric Acid"
	quest.641AD4D1666F216F.quest_subtitle: "Salt and sulfuric acid"
	quest.641AD4D1666F216F.quest_desc: ["Salt in a vat of sulfuric acid gives hydrochloric acid, with sodium bisulfate left over. Hydrogen burnt in chlorine makes it too."]
	quest.05589774C48B40A3.title: "Fluorite"
	quest.05589774C48B40A3.quest_subtitle: "From the pack's own ore"
	quest.05589774C48B40A3.quest_desc: ["Crush fluorite ore into dust. It is the key to hydrofluoric acid.", "", "Fluorite is one of the ores this pack adds. The field guide lists where it forms."]
	quest.267282D570010FB1.title: "Hydrofluoric Acid"
	quest.267282D570010FB1.quest_subtitle: "Fluorite in sulfuric acid"
	quest.267282D570010FB1.quest_desc: ["Fluorite dust in sulfuric acid gives hydrofluoric acid. Handle it with care: it etches glass and much else."]
	quest.2D5A7B5C8AE69F70.title: "Tantalum"
	quest.2D5A7B5C8AE69F70.quest_subtitle: "Fluorotantalate, reduced by sodium"
	quest.2D5A7B5C8AE69F70.quest_desc: ["Hot hydrofluoric acid dissolves tantalite powder. Sylvite crystallises potassium fluorotantalate, and sodium reduces it under argon to tantalum dust.", "", "The argon comes from Liquid Air, on the line below. JEI shows the route to the sodium."]
	quest.5B441F4906DCBB40.title: "The Steel Chemical Vat"
	quest.5B441F4906DCBB40.quest_subtitle: "Reactions in bulk"
	quest.5B441F4906DCBB40.quest_desc: ["Four stainless steel sheets, eight stainless rivets, two molybdenum sheets and two tantalum sheets around a steel fluid tank, built in mechanical crafters, give two vats.", "", "Molybdenum melts in a forge and its sheet is forged on a black steel anvil. Tantalum is the hard part, and it is why this vat comes so late.", "", "The heavy processes open here: titanium tetrachloride, the Bayer and Kroll lines and polysilicon all ask for steel."]
	quest.65FB2BEEF17B63F8.title: "Rutile Dust"
	quest.65FB2BEEF17B63F8.quest_subtitle: "Titanium ore, crushed"
	quest.65FB2BEEF17B63F8.quest_desc: ["Crush rutile ore into dust. One dust carries 5 mB of titanium."]
	quest.7ADA597F285D8A92.title: "Titanium Tetrachloride"
	quest.7ADA597F285D8A92.quest_subtitle: "Carbochlorination"
	quest.7ADA597F285D8A92.quest_desc: ["Two rutile dust, one coal coke dust and 500 mB of chlorine in a heated vat with a mixer give 250 mB of titanium tetrachloride."]
	quest.0A50238BB214541A.title: "Polyethylene"
	quest.0A50238BB214541A.quest_subtitle: "Ethylene, polymerized"
	quest.0A50238BB214541A.quest_desc: ["Ethylene from your distillation tower polymerizes in a heated vat with air, over a titanium tetrachloride catalyst. Cast the polyethylene into sheets. Insulation and electronics need it.", "", "&6Electronics&r is built on these sheets, and &6Light Metals&r picks the titanium tetrachloride up again for the Kroll process."]
	quest.23206F2F3C607C2C.title: "Hydrogen"
	quest.23206F2F3C607C2C.quest_subtitle: "Water, split"
	quest.23206F2F3C607C2C.quest_desc: ["Run water through an electrode vat. This needs power, so it waits for your first electricity. Airships need it too."]
	quest.1FE85AB58610B959.title: "Liquid Air"
	quest.1FE85AB58610B959.quest_subtitle: "Everything in the sky"
	quest.1FE85AB58610B959.quest_desc: ["Pressurize air with cooling fluid, which you mix from water and ethylene, then distil it into nitrogen, oxygen, argon and more."]
	quest.0776ACF8377E0947.title: "Salt Water and Chlorine"
	quest.0776ACF8377E0947.quest_subtitle: "Salt water, split"
	quest.0776ACF8377E0947.quest_desc: ["Run salt water through an electrode vat. It gives chlorine, hydrogen and caustic soda."]
	quest.0D7BFE9BA7B656E1.title: "Caustic Soda"
	quest.0D7BFE9BA7B656E1.quest_subtitle: "From salt water electrolysis"
	quest.0D7BFE9BA7B656E1.quest_desc: ["Electrolysing salt water gives chlorine, hydrogen and caustic soda. The Bayer process and several others run on it."]
	quest.747B1F410BD783E2.title: "Nitric Acid"
	quest.747B1F410BD783E2.quest_subtitle: "Ammonia, oxidised"
	quest.747B1F410BD783E2.quest_desc: ["Ammonia burnt over a platinum catalyst gives nitrogen dioxide, and water turns it into nitric acid. Platinum, silver and thorium all need it."]
	quest.7286A599149315E4.title: "Nylon"
	quest.7286A599149315E4.quest_subtitle: "Two halves of a polymer"
	quest.7286A599149315E4.quest_desc: ["Nitric acid oxidises cyclohexanol into adipic acid. Hydrogen, ethylene and ammonia over a nickel catalyst give hexamethylenediamine. Mix the two solutions in a vat into nylon salt crystals and crush them.", "", "Superheated compacting melts nylon salt into molten nylon."]
	quest.5B3A1CB7F3C8606C.title: "Nylon Cloth"
	quest.5B3A1CB7F3C8606C.quest_subtitle: "Melt-spun, drawn and woven"
	quest.5B3A1CB7F3C8606C.quest_desc: ["A brass extruder over a molten nylon source and a water quench spins ten filaments per bucket. A rolling mill draws them, which makes them strong, and a coiling machine or a spindle twists them into thread.", "", "Nylon thread works as any string. Sixteen of them weave into nylon cloth on a loom.", "", "&7Airship envelopes are made from nylon cloth."]
	chapter.546908DF1439FA40.title: "Electronics \\& Magnets"
	chapter.546908DF1439FA40.chapter_subtitle: ["Silicon to the circuit board on the top line, resistors, capacitors and the stronger magnets on the bottom one. Together they build the fireproof vat."]
	quest.1CEDB6ABE2820016.title: "Trichlorosilane"
	quest.1CEDB6ABE2820016.quest_subtitle: "Silicon, chlorinated"
	quest.1CEDB6ABE2820016.quest_desc: ["Turn silicon into trichlorosilane, the liquid that refining starts from.", "", "&7Look up trichlorosilane in JEI for the vat recipe."]
	quest.7AE04C072ECDE239.title: "Polysilicon"
	quest.7AE04C072ECDE239.quest_subtitle: "The Siemens process"
	quest.7AE04C072ECDE239.quest_desc: ["Deposit silicon from trichlorosilane and hydrogen onto hot rods: graphite electrodes, at 1100 °C. A steel vat can do it, but it turns 1000 mB of trichlorosilane into a single piece. The fireproof vat is the real reactor and gets four times as much."]
	quest.37863C291329083A.title: "Semiconductors"
	quest.37863C291329083A.quest_subtitle: "Silicon, doped"
	quest.37863C291329083A.quest_desc: ["Mix polysilicon with phosphorus dust for n-type, and with molten boron for p-type. Boron comes from kernite through the bloomery."]
	quest.0876427AC2E90A23.title: "Phosphorite"
	quest.0876427AC2E90A23.quest_subtitle: "For your semiconductors"
	quest.0876427AC2E90A23.quest_desc: ["Crush phosphorite ore into dust. Circuit boards can't be made without it, because phosphorus dopes silicon into n-type semiconductor."]
	quest.4394E18CCEF6A7A2.title: "The Diode"
	quest.4394E18CCEF6A7A2.quest_subtitle: "A P-N junction"
	quest.4394E18CCEF6A7A2.quest_desc: ["A P-N junction with leads, cased in epoxy."]
	quest.1D00170C37DC4C94.title: "The Transistor"
	quest.1D00170C37DC4C94.quest_subtitle: "An n-p-n sandwich"
	quest.1D00170C37DC4C94.quest_desc: ["Copper wire, then n-type, p-type and n-type again, on a polyethylene sheet.", "", "Each craft gives four, and every circuit board takes several."]
	quest.01379EB0C708704C.title: "The Circuit Board"
	quest.01379EB0C708704C.quest_subtitle: "Coated, etched, populated"
	quest.01379EB0C708704C.quest_desc: ["Deploy a gold sheet on an empty board and etch it with sulfuric acid in a vat. Then an assembly loop adds capacitors, resistors and transistors.", "", "The resistors and capacitors come from the line below."]
	quest.70B9444C12F48A8E.title: "The Computer"
	quest.70B9444C12F48A8E.quest_subtitle: "Programmable control"
	quest.70B9444C12F48A8E.quest_desc: ["A ComputerCraft computer, built with mechanical crafters. It can run your factory by script."]
	quest.11EF275C1455EC4E.title: "The Chunk Loader"
	quest.11EF275C1455EC4E.quest_subtitle: "Keep it running"
	quest.11EF275C1455EC4E.quest_desc: ["A chunk loader keeps your machines working while you are far away."]
	quest.7D5A493EDE67E8E5.title: "Silicon Wafers"
	quest.7D5A493EDE67E8E5.quest_subtitle: "Pulled from the melt"
	quest.7D5A493EDE67E8E5.quest_desc: ["Pull a monocrystalline silicon ingot from polysilicon under argon, then cut it into wafers."]
	quest.6454F90D417AA7DE.title: "The Fireproof Chemical Vat"
	quest.6454F90D417AA7DE.quest_subtitle: "Arc furnaces and worse"
	quest.6454F90D417AA7DE.quest_desc: ["A steel chemical vat, a heavy casing, two circuit boards, fireproof bricks and a rubber bar. It opens the arc furnace, high alloy steel and polysilicon.", "", "It is the last of the three vats. &6Ore Processing&r, &6Light Metals&r and &6Rare Metals&r all work in it."]
	quest.04C6B486076D1CEF.title: "Neodymium Magnets"
	quest.04C6B486076D1CEF.quest_subtitle: "The endgame rare earth"
	quest.04C6B486076D1CEF.quest_desc: ["Electrum sheet, ferroboron rods, solder and neodymium powder, vacuumized, pressed, polished and energised.", "", "They are the strongest magnets in the book. The particle accelerator and the best motors need them."]
	quest.608B113AC68F951A.title: "Better Motors"
	quest.608B113AC68F951A.quest_subtitle: "Advanced and reinforced"
	quest.608B113AC68F951A.quest_desc: ["Each motor tier gives more power. Advanced and reinforced motors carry the big machines."]
	task.54CC8D1118ACAF84.title: "Any Motor"
	quest.7EF92D269E88AAE9.title: "The Resistor"
	quest.7EF92D269E88AAE9.quest_subtitle: "Gold wire, wound with constantan"
	quest.7EF92D269E88AAE9.quest_desc: ["Copper and gold wire with glue, pressed and energised, then wound with a constantan spool."]
	quest.068BB6F63983B6F7.title: "The Capacitor"
	quest.068BB6F63983B6F7.quest_subtitle: "Foil and paper"
	quest.068BB6F63983B6F7.quest_desc: ["Aluminium sheet, paper and copper wire on an assembly line, then pressed and energised.", "", "Each run gives two, and about one in ten fails. Circuit boards and the polarizer take them."]
	quest.6D74C28727B21311.title: "The Polarizer"
	quest.6D74C28727B21311.quest_subtitle: "Make your own magnets"
	quest.6D74C28727B21311.quest_desc: ["Brass sheets, capacitors, resistors, a steel casing and a voltmeter. Power it through a converter."]
	quest.4083C43A1E56A5DF.title: "Polarized Magnets"
	quest.4083C43A1E56A5DF.quest_subtitle: "Magnetic alloy, charged"
	quest.4083C43A1E56A5DF.quest_desc: ["Polarize a magnetic alloy ingot.", "", "TFMG's voltmeter and the strong ferrite line both start from these."]
	quest.61F7165D8EE79AE3.title: "Strong Ferrite Magnets"
	quest.61F7165D8EE79AE3.quest_subtitle: "Layered and energised"
	quest.61F7165D8EE79AE3.quest_desc: ["A long assembly on a polarized magnet: hematite, zinc, manganese and pressure, energised at the end."]
	quest.3DFE5F054BCECF9F.title: "Alnico Magnets"
	quest.3DFE5F054BCECF9F.quest_subtitle: "Aluminium, nickel, cobalt"
	quest.3DFE5F054BCECF9F.quest_desc: ["Polarize an alnico core, then fit cobalt rods, press, energise and fill it with chromium."]
	chapter.596C1E6B8A162C9F.title: "Ore Processing"
	chapter.596C1E6B8A162C9F.chapter_subtitle: ["The door to industrial metallurgy: why some ores defeat the forge, crushing, acid leaching and the arc furnace."]
	quest.4646A6CC64DA192A.title: "Mechanic: Ores That Resist Heat"
	quest.4646A6CC64DA192A.quest_subtitle: "Why the forge is not enough"
	quest.4646A6CC64DA192A.quest_desc: ["Bauxite only melts at 1600 °C, and then gives just 2 to 7 mB by grade. Rutile doesn't melt at all, so titanium comes from the bloomery until you build the Kroll line. Magnesite and bertrandite smelt hot and poorly, and spodumene and zircon don't smelt. Each has a proper process in this chapter."]
	quest.7A545AABBC1E148D.title: "Ore in the Basin"
	quest.7A545AABBC1E148D.quest_subtitle: "Melting by machine"
	quest.7A545AABBC1E148D.quest_desc: ["A heated mixer melts ore straight into molten metal, ready for a casting basin."]
	quest.3328BC1F0C80E51E.title: "Iron Powder for the Furnace"
	quest.3328BC1F0C80E51E.quest_subtitle: "Industrial pig iron"
	quest.3328BC1F0C80E51E.quest_desc: ["Iron ore powders and flux go into the industrial blast furnace and come out as molten pig iron, with slag."]
	task.2F133E0643ECC093.title: "Any Powder"
	quest.788DC7B6BD541EEF.title: "Crushing Ore to Powder"
	quest.788DC7B6BD541EEF.quest_subtitle: "The start of every line"
	quest.788DC7B6BD541EEF.quest_desc: ["Crushing wheels turn each ore into its powder: 2, 3, 5 or 7 by grade. Every line here starts from a powder."]
	quest.3FD5728231F2FBFB.title: "Acid Leaching"
	quest.3FD5728231F2FBFB.quest_subtitle: "More metal per ore"
	quest.3FD5728231F2FBFB.quest_desc: ["Ore in a vat of sulfuric acid gives metal dust: five for normal ore, seven for rich, plus a chance of one more. Each dust melts to 5 mB, so leaching yields a little more than melting."]
	quest.0565DB89F4A62FA9.title: "Other Acids"
	quest.0565DB89F4A62FA9.quest_subtitle: "Tin, silver, gold"
	quest.0565DB89F4A62FA9.quest_desc: ["Hydrochloric acid leaches tin and antimony, nitric acid silver, and aqua regia, nitric with hydrochloric, gold and platinum."]
	quest.153D34E7840A527D.title: "The Arc Furnace"
	quest.153D34E7840A527D.quest_subtitle: "Hotter than any forge"
	quest.153D34E7840A527D.quest_desc: ["A fireproof vat of size six with three graphite electrodes, run under argon. Boron, iridium, osmium, niobium, tantalum and titanium melt here, far above any forge.", "", "The arc furnace is not a block of its own. It is a fireproof vat built to that size and fitted with those electrodes, so this step is ticked by hand once yours has run."]
	chapter.6CCAAADA618A6D71.title: "Light Metals"
	chapter.6CCAAADA618A6D71.chapter_subtitle: ["Aluminium by the Bayer and Hall-Heroult processes, titanium by the Kroll process with its magnesium loop, then lithium and beryllium."]
	quest.0B780EE48CD05E58.title: "Bayer Digestion"
	quest.0B780EE48CD05E58.quest_subtitle: "Bauxite in hot caustic soda"
	quest.0B780EE48CD05E58.quest_desc: ["Pressurize four bauxite powder with 500 mB of caustic soda in a heated compressor. You get sodium aluminate solution, and the iron oxides stay behind as red mud."]
	quest.6B87F51D19F89C36.title: "Aluminium Hydroxide"
	quest.6B87F51D19F89C36.quest_subtitle: "Seeded out of the cold liquor"
	quest.6B87F51D19F89C36.quest_desc: ["Cool the sodium aluminate in a steel vat with a freezer. Aluminium hydroxide settles out, and most of the caustic soda comes back.", "", "The freezer is in Energy Sources. It only needs the distillation tower and your first current."]
	quest.6DD6D46FA3B80E2E.title: "Alumina"
	quest.6DD6D46FA3B80E2E.quest_subtitle: "Calcined at 1100 °C"
	quest.6DD6D46FA3B80E2E.quest_desc: ["Heat the hydroxide to 1100 °C and it gives off water, leaving alumina."]
	quest.27C952226E154D04.title: "Cryolite"
	quest.27C952226E154D04.quest_subtitle: "The molten bath"
	quest.27C952226E154D04.quest_desc: ["Mine cryolite. Alumina dissolves in molten cryolite, and nearly all of it survives each batch."]
	quest.1F62C2C534E37F80.title: "The Hall–Héroult Cell"
	quest.1F62C2C534E37F80.quest_subtitle: "Aluminium by electricity"
	quest.1F62C2C534E37F80.quest_desc: ["A firebrick-lined vat of four tanks or more, with two graphite electrodes, at 960 °C and at least 6 A. Three alumina and the cryolite bath give 15 mB of molten aluminium. The carbon electrodes burn away as CO2.", "", "After the long trickle from melting bauxite, this is aluminium by the bucket."]
	quest.2E4797701C350AB6.title: "Magnesium"
	quest.2E4797701C350AB6.quest_subtitle: "Calcined, chlorinated, electrolysed"
	quest.2E4797701C350AB6.quest_desc: ["Heat magnesite powder into magnesia, chlorinate it into molten magnesium chloride, and electrolyse that. Magnesium is the reducing metal for titanium, zirconium, boron and more."]
	quest.5F182F730599A93F.title: "The Kroll Process"
	quest.5F182F730599A93F.quest_subtitle: "TiCl4 and magnesium under argon"
	quest.5F182F730599A93F.quest_desc: ["In a steel vat at 850 °C, 500 mB of titanium tetrachloride, 20 mB of molten magnesium and 50 mB of argon give two crude titanium sponge. The molten magnesium chloride goes back to electrolysis, which closes the loop."]
	quest.67A19D9014F54314.title: "Zirconium Sponge"
	quest.67A19D9014F54314.quest_subtitle: "The titanium line again"
	quest.67A19D9014F54314.quest_desc: ["Zircon follows titanium: carbochlorination to zirconium tetrachloride, Kroll reduction, vacuum. The sponge melts in a forge with bellows."]
	quest.00244F00EDCE135B.title: "Titanium Sponge"
	quest.00244F00EDCE135B.quest_subtitle: "Salt boiled off in vacuum"
	quest.00244F00EDCE135B.quest_desc: ["Vacuum distillation strips the salt left in the crude sponge."]
	quest.075B0E1A415C2324.title: "The Sponge Electrode"
	quest.075B0E1A415C2324.quest_subtitle: "Pressed for remelting"
	quest.075B0E1A415C2324.quest_desc: ["Compact ten titanium sponge into a consumable electrode."]
	quest.691FF0F8B55C859C.title: "Vacuum Arc Remelting"
	quest.691FF0F8B55C859C.quest_subtitle: "Titanium in bulk"
	quest.691FF0F8B55C859C.quest_desc: ["In the arc furnace, an electrode and 150 mB of argon give 100 mB of molten titanium. This is the bulk route: the bloomery stays for small amounts."]
	quest.7835A76AB5CC95DD.title: "Spodumene"
	quest.7835A76AB5CC95DD.quest_subtitle: "Lithium ore, decrepitated"
	quest.7835A76AB5CC95DD.quest_desc: ["Crush spodumene and heat the powder. It cracks into beta spodumene, which acid can attack."]
	quest.2DA56D89F1103A61.title: "Lithium Carbonate"
	quest.2DA56D89F1103A61.quest_subtitle: "Acid roast, then soda ash"
	quest.2DA56D89F1103A61.quest_desc: ["Sulfuric acid turns beta spodumene into lithium sulfate solution, and soda ash precipitates lithium carbonate."]
	quest.213E6442F9704F1C.title: "Lithium"
	quest.213E6442F9704F1C.quest_subtitle: "Electrolysed with sylvite"
	quest.213E6442F9704F1C.quest_desc: ["Hydrochloric acid gives lithium chloride. Electrolyse it with sylvite, which lowers the melting point and is mostly kept."]
	quest.0BE69C0DFB1D1CD7.title: "Beryllium Fluoride"
	quest.0BE69C0DFB1D1CD7.quest_subtitle: "Sulfate, then fluoride"
	quest.0BE69C0DFB1D1CD7.quest_desc: ["Leach bertrandite powder in sulfuric acid, precipitate ammonium fluoroberyllate, and heat it into beryllium fluoride."]
	quest.6595BDDFC4A9B120.title: "Beryllium"
	quest.6595BDDFC4A9B120.quest_subtitle: "Reduced by magnesium"
	quest.6595BDDFC4A9B120.quest_desc: ["Beryllium fluoride and magnesium dust give beryllium dust."]
	chapter.79B9234FD22BE021.title: "Rare Metals"
	chapter.79B9234FD22BE021.chapter_subtitle: ["One short line per metal: tungsten, boron and cobalt from crushed ore, thorium, uranium and the platinum metals from the acids, then niobium and high alloy steel."]
	quest.0EC24BE12B73AB5A.title: "Wolframite Powder"
	quest.0EC24BE12B73AB5A.quest_subtitle: "Tungsten ore, crushed"
	quest.0EC24BE12B73AB5A.quest_desc: ["Crush wolframite. Hot caustic soda will dissolve the tungsten and leave iron and manganese behind as slag."]
	quest.3C63C4144D5CB055.title: "Ammonium Paratungstate"
	quest.3C63C4144D5CB055.quest_subtitle: "Crystallised from the liquor"
	quest.3C63C4144D5CB055.quest_desc: ["Pressurize the powder with caustic soda for sodium tungstate. Then add ammonia and hydrochloric acid in a vat, and APT crystallises out."]
	quest.059A7B28EBA26804.title: "Tungsten Trioxide"
	quest.059A7B28EBA26804.quest_subtitle: "The yellow oxide"
	quest.059A7B28EBA26804.quest_desc: ["Calcining drives the ammonia and water off."]
	quest.0EDC1DB04E8C8910.title: "Tungsten Powder"
	quest.0EDC1DB04E8C8910.quest_subtitle: "Reduced by hydrogen"
	quest.0EDC1DB04E8C8910.quest_desc: ["Four tungsten trioxide and hydrogen in a vat give tungsten powder and steam."]
	quest.46630D0A957C3D9F.title: "Sintered Tungsten"
	quest.46630D0A957C3D9F.quest_subtitle: "Pressed, never cast"
	quest.46630D0A957C3D9F.quest_desc: ["Compact the powder into a green bar, then sinter it under hydrogen by running current through it. Tungsten is never melted in industry."]
	quest.1307B4B36F98D13F.title: "Tungsten Carbide"
	quest.1307B4B36F98D13F.quest_subtitle: "Harder than steel"
	quest.1307B4B36F98D13F.quest_desc: ["Tungsten and carbon fused in the arc furnace. It makes the hardest cutting edges in the pack."]
	quest.5918429AAEA60599.title: "Boric Acid"
	quest.5918429AAEA60599.quest_subtitle: "Kernite in acid"
	quest.5918429AAEA60599.quest_desc: ["Crush kernite and dissolve four powder in sulfuric acid and water. Boric acid crystallises, the sodium sulfate stays in solution."]
	quest.0A33FA09562270D1.title: "Boron Trioxide"
	quest.0A33FA09562270D1.quest_subtitle: "Dehydrated"
	quest.0A33FA09562270D1.quest_desc: ["Heat boric acid and it loses its water."]
	quest.45F3CB3FEC51FF79.title: "Boron"
	quest.45F3CB3FEC51FF79.quest_subtitle: "The Moissan reduction"
	quest.45F3CB3FEC51FF79.quest_desc: ["Two boron trioxide and two magnesium dust give boron dust and magnesia. Melt four dust in the arc furnace under argon."]
	quest.6A481E89873B8E92.title: "Roasted Cobaltite"
	quest.6A481E89873B8E92.quest_subtitle: "Sulfur driven off"
	quest.6A481E89873B8E92.quest_desc: ["Crush cobaltite and roast it with oxygen in a compressor. The sulfur leaves as sulfur dioxide."]
	quest.0C8938FC323F6486.title: "Cobalt Dust"
	quest.0C8938FC323F6486.quest_subtitle: "Leached in acid"
	quest.0C8938FC323F6486.quest_desc: ["Four roasted cobaltite in sulfuric acid give cobalt dust."]
	quest.0E03FB128375F2C2.title: "Rare Earth Hydroxide"
	quest.0E03FB128375F2C2.quest_subtitle: "Monazite in caustic soda"
	quest.0E03FB128375F2C2.quest_desc: ["Crush monazite and pressurize it with hot caustic soda. The phosphate washes away and leaves the hydroxides."]
	quest.241B0504FAF26358.title: "Thoria"
	quest.241B0504FAF26358.quest_subtitle: "Nitrate, then heat"
	quest.241B0504FAF26358.quest_desc: ["Nitric acid dissolves the hydroxides and separates the thorium as its nitrate. Heating it leaves thoria and releases nitrogen dioxide."]
	quest.117B0078F413D8FD.title: "Thorium"
	quest.117B0078F413D8FD.quest_subtitle: "Fluoride, then magnesium"
	quest.117B0078F413D8FD.quest_desc: ["Hydrofluoric acid turns thoria into thorium tetrafluoride, and magnesium reduces it to thorium dust."]
	quest.57FC1EAEE18682E5.title: "Yellowcake"
	quest.57FC1EAEE18682E5.quest_subtitle: "Uranium leached"
	quest.57FC1EAEE18682E5.quest_desc: ["Leach uraninite powder in oxidising sulfuric acid, then precipitate the uranium with ammonia."]
	quest.45B9C13293B69035.title: "Uranium"
	quest.45B9C13293B69035.quest_subtitle: "Fluoride, then magnesium"
	quest.45B9C13293B69035.quest_desc: ["Hot hydrogen and hydrofluoric acid turn yellowcake into uranium tetrafluoride, and magnesium reduces it to uranium dust."]
	quest.6107CEA9B00D4D81.title: "Aqua Regia"
	quest.6107CEA9B00D4D81.quest_subtitle: "Platinum dissolved"
	quest.6107CEA9B00D4D81.quest_desc: ["Nitric and hydrochloric acid together dissolve native platinum into chloroplatinic acid. A quarter of the time, native iridium is left behind as a residue."]
	quest.641B5619DEB33E24.title: "Ammonium Chloroplatinate"
	quest.641B5619DEB33E24.quest_subtitle: "The yellow salt"
	quest.641B5619DEB33E24.quest_desc: ["Ammonia precipitates the platinum as its ammonium salt."]
	quest.74B8E784792154B0.title: "Platinum"
	quest.74B8E784792154B0.quest_subtitle: "From sponge"
	quest.74B8E784792154B0.quest_desc: ["Heat the salt into platinum sponge, which a forge can melt."]
	quest.7B2D7F8FCF6EC37B.title: "Iridium and Osmium"
	quest.7B2D7F8FCF6EC37B.quest_subtitle: "Alkaline fusion"
	quest.7B2D7F8FCF6EC37B.quest_desc: ["Fuse native iridium or osmium powder with saltpeter and caustic soda, then chlorinate. Osmium escapes as volatile osmium tetroxide, and iridium stays as its chloride."]
	quest.4CB4C297EDD81449.title: "Osmium"
	quest.4CB4C297EDD81449.quest_subtitle: "Reduced by hydrogen"
	quest.4CB4C297EDD81449.quest_desc: ["Osmium tetroxide and hydrogen give osmium dust. Melt it in the arc furnace."]
	quest.6621B6FBCB430B6C.title: "Iridium"
	quest.6621B6FBCB430B6C.quest_subtitle: "Salt, then hydrogen"
	quest.6621B6FBCB430B6C.quest_desc: ["Ammonia precipitates ammonium hexachloroiridate, and hydrogen reduces it to iridium dust for the arc furnace."]
	quest.03131E1BAF18DAFE.title: "Niobium"
	quest.03131E1BAF18DAFE.quest_subtitle: "Reduced by aluminium"
	quest.03131E1BAF18DAFE.quest_desc: ["Columbite in hydrofluoric acid, then ammonia, gives niobium hydroxide. Calcine it to the pentoxide and reduce it with aluminium dust. The alumina goes back to the Hall–Héroult cell."]
	quest.7B925EB169B12D6E.title: "High Alloy Steel"
	quest.7B925EB169B12D6E.quest_subtitle: "A recipe with a long list"
	quest.7B925EB169B12D6E.quest_desc: ["Weak steel, chromium, molybdenum and nitrogen, with vanadium, manganese and other metal dusts, in your fireproof vat. Turbine casings are built from it.", "", "This is the last steel in the book. &6Energy Sources&r builds its turbines from it."]
	quest.396ED056A40B4066.title: "The High Alloy Steel Anvil"
	quest.396ED056A40B4066.quest_subtitle: "The last anvil"
	quest.396ED056A40B4066.quest_desc: ["Seven double ingots of high alloy steel."]
	chapter.0E98758845C4493E.title: "Energy Sources"
	chapter.0E98758845C4493E.chapter_subtitle: ["Steam turbines and what to do with their exhaust on the top line, concentrated sunlight in the middle, photovoltaics at the bottom."]
	quest.23A5CFEA457F1F62.title: "The Steam Outlet"
	quest.23A5CFEA457F1F62.quest_subtitle: "A pipe where the shaft would be"
	quest.23A5CFEA457F1F62.quest_desc: ["Put a fluid pipe where an engine's shaft would go. The engine stops turning and pipes out its share of the boiler as Pressurized Steam instead, 10 mB per tick per boiler level."]
	quest.01F2690CE13F7276.title: "Turbine Casing"
	quest.01F2690CE13F7276.quest_subtitle: "A Cr-Mo-V steel shell"
	quest.01F2690CE13F7276.quest_desc: ["Turbine casing is built on high alloy steel sheet, so the turbine waits for your arc furnace."]
	quest.48E81759EDAD81A0.title: "Turbine Rotors"
	quest.48E81759EDAD81A0.quest_subtitle: "The spinning column"
	quest.48E81759EDAD81A0.quest_desc: ["Rotors stack into a column inside the casing. Each layer adds speed and capacity, and burns about 8 mB of steam per tick."]
	quest.0470C401872C7BDE.title: "Stainless Steel Blades"
	quest.0470C401872C7BDE.quest_subtitle: "The first turbine blades"
	quest.0470C401872C7BDE.quest_desc: ["Molybdenum-filled stainless double sheet, curved and polished. They waste part of the steam, but they work."]
	quest.6A60B4068374A0F3.title: "The Steam Turbine"
	quest.6A60B4068374A0F3.quest_subtitle: "A 7x7 tower of power"
	quest.6A60B4068374A0F3.quest_desc: ["Build the casing around the rotor column, fit the blades and pipe Pressurized Steam into the walls. Take rotation from the cap rotor. Goggles on a rotor show its blades, steam and exhaust.", "", "Three things meet here: steam from the outlet, the rotor column in its casing, and the blades.", "", "&7Field guide: Materialism Guide, Tech Progression, The Steam Cycle. To finish, look at a placed turbine rotor."]
	quest.562786D461B228F9.title: "Titanium Blades"
	quest.562786D461B228F9.quest_subtitle: "Full efficiency"
	quest.562786D461B228F9.quest_desc: ["Titanium blades waste no steam. Swap them in once you can make titanium sheet."]
	quest.1761BACEFA463842.title: "Venting"
	quest.1761BACEFA463842.quest_subtitle: "White clouds"
	quest.1761BACEFA463842.quest_desc: ["Spent steam leaves the turbine as Low-Pressure Steam, and a turbine with nowhere to send it stalls. Pipe it to a smokestack or an exhaust: cheap and reliable, but the water is lost."]
	task.7580245FA29B892B.title: "Any Venting"
	quest.72C74CF6B77A4EC0.title: "The Freezer"
	quest.72C74CF6B77A4EC0.quest_subtitle: "A refrigeration unit"
	quest.72C74CF6B77A4EC0.quest_desc: ["A sequenced assembly on a compressor: condenser tubing with aluminium fins pressed on, an expansion valve, an evaporator coil, brazed joints, a motor coil and a power terminal. The circuit is evacuated, then charged with propane from your distillation tower. It runs on electricity through a converter."]
	quest.6E932E4E635F7ED8.title: "Condensing"
	quest.6E932E4E635F7ED8.quest_subtitle: "Close the loop"
	quest.6E932E4E635F7ED8.quest_desc: ["Pipe the exhaust into a steel chemical vat of at least four tanks with a freezer at the bottom. It turns steam back into water for the boiler.", "", "No water is made or lost on the way round: a closed loop gives back every drop the boiler boiled."]
	quest.0BDAA986FBE0468C.title: "The Solar Heater"
	quest.0BDAA986FBE0468C.quest_subtitle: "Sunlight on a pan"
	quest.0BDAA986FBE0468C.quest_desc: ["Glass, copper and aluminium sheets. In full sun it heats what you put in it, and it can even melt rock into lava, which is scarce here: 250 mB per raw rock, 100 mB per cobble."]
	quest.0D49A9D5E9610F2A.title: "Solar Mirrors"
	quest.0D49A9D5E9610F2A.quest_subtitle: "Aimed at one point"
	quest.0D49A9D5E9610F2A.quest_desc: ["Mirrors focus sunlight on a solar power tower."]
	quest.47BC254DB018D7A7.title: "The Kinetic Battery"
	quest.47BC254DB018D7A7.quest_subtitle: "Store rotation in a flywheel"
	quest.47BC254DB018D7A7.quest_desc: ["A steel flywheel in aluminium. It stores rotation when you have too much and gives it back later."]
	quest.57C650E41E1E0E22.title: "The Stirling Engine"
	quest.57C650E41E1E0E22.quest_subtitle: "Heat into rotation"
	quest.57C650E41E1E0E22.quest_desc: ["A heat engine that runs on New Age's heat. It turns any steady heat source into a shaft."]
	quest.16B673F0BC23F7B6.title: "Heat Plates and Pipes"
	quest.16B673F0BC23F7B6.quest_subtitle: "New Age's heat"
	quest.16B673F0BC23F7B6.quest_desc: ["Solar heating plates collect heat, and heat pipes carry it to heaters and Stirling engines."]
	quest.6C28D7A89DD34BB6.title: "The Solar Power Tower"
	quest.6C28D7A89DD34BB6.quest_subtitle: "Concentrated sunlight"
	quest.6C28D7A89DD34BB6.quest_desc: ["A tower surrounded by mirrors. In steam mode it raises Pressurized Steam for your turbines."]
	quest.45B32FA119CF18D9.title: "The Heat Battery"
	quest.45B32FA119CF18D9.quest_subtitle: "Heat for later"
	quest.45B32FA119CF18D9.quest_desc: ["A salt block holds heat for when the sun is down."]
	quest.1C73D637E54DC9A0.title: "Molten Nitrate Salt"
	quest.1C73D637E54DC9A0.quest_subtitle: "Saltpeter, melted"
	quest.1C73D637E54DC9A0.quest_desc: ["Saltpeter melts into molten nitrate salt, 100 mB each, and crystallizes back. It carries and stores heat."]
	quest.63B0B96E5A00B3DF.title: "Photovoltaic Cells"
	quest.63B0B96E5A00B3DF.quest_subtitle: "Sunlight straight to current"
	quest.63B0B96E5A00B3DF.quest_desc: ["Multicrystalline cells cut from polysilicon: boron, a wire saw and several more steps."]
	quest.035116722B0053DB.title: "Photovoltaic Solar Panels"
	quest.035116722B0053DB.quest_subtitle: "Laminated modules"
	quest.035116722B0053DB.quest_desc: ["Cells laminated into a panel. Wire panels into the grid for power with no fuel at all."]
	chapter.44D314E7082F0C66.title: "Nuclear Power"
	chapter.44D314E7082F0C66.chapter_subtitle: ["Fission on the top lines, where thorium and zircaloy meet in the fuel. Fusion on the bottom one, by way of the particle accelerator."]
	quest.62C43B76F4F6A4CD.title: "Zircaloy"
	quest.62C43B76F4F6A4CD.quest_subtitle: "A jacket for fuel"
	quest.62C43B76F4F6A4CD.quest_desc: ["Weld zircaloy sheets at tier V, or compact them with solder."]
	quest.1D137A215FCE90C5.title: "Radioactive Thorium"
	quest.1D137A215FCE90C5.quest_subtitle: "Monazite, then light"
	quest.1D137A215FCE90C5.quest_desc: ["Thorium comes from monazite through the bloomery. Focus a thorium ingot with an optical source to make it radioactive."]
	quest.3FF4FAA28C4BEE22.title: "Nuclear Fuel"
	quest.3FF4FAA28C4BEE22.quest_subtitle: "A dangerous kind of warm"
	quest.3FF4FAA28C4BEE22.quest_desc: ["An assembly on a zircaloy double sheet: radioactive thorium, press, a second sheet, then curve it shut."]
	quest.462F607BA92F02F8.title: "The Fission Reactor"
	quest.462F607BA92F02F8.quest_subtitle: "Rods, casing and vents"
	quest.462F607BA92F02F8.quest_desc: ["Reactor rods hold the fuel. A working reactor puts out more heat than anything else you can build before fusion."]
	quest.07C1B748DB2196E1.title: "Reactor Casing"
	quest.07C1B748DB2196E1.quest_subtitle: "A shielded vessel"
	quest.07C1B748DB2196E1.quest_desc: ["Reactor casing, glass and heat vents form the New Age fission reactor."]
	quest.4C5F894FB1FA887A.title: "Fusion Casing"
	quest.4C5F894FB1FA887A.quest_subtitle: "A double-walled vessel"
	quest.4C5F894FB1FA887A.quest_desc: ["Fusion casing, shielded and armoured with tungsten, plus superconducting coils of Nb3Sn cable."]
	quest.6DCEAAEA3CEBE45E.title: "The Particle Accelerator"
	quest.6DCEAAEA3CEBE45E.quest_subtitle: "A beam line of magnets"
	quest.6DCEAAEA3CEBE45E.quest_desc: ["Accelerator pipe with dipole magnets and an injector with RF power. It breeds tritium and turns thorium into fissile fuel."]
	quest.34B2DEAFB322629F.title: "Tritium"
	quest.34B2DEAFB322629F.quest_subtitle: "Bred in the accelerator"
	quest.34B2DEAFB322629F.quest_desc: ["Spallation neutrons from the particle accelerator breed tritium from lithium, with beryllium multiplying them."]
	quest.2F3C9247D6740D9F.title: "Fuel Capsules"
	quest.2F3C9247D6740D9F.quest_subtitle: "To hold the fuel"
	quest.2F3C9247D6740D9F.quest_desc: ["Empty fuel capsules carry deuterium and tritium into the fusion reactor."]
	quest.28383C431C0F7395.title: "The Fusion Reactor"
	quest.28383C431C0F7395.quest_subtitle: "A star in a box"
	quest.28383C431C0F7395.quest_desc: ["The core needs an advanced computer to control the plasma. Feed it fuel capsules of deuterium and tritium, and it raises steam for your turbines on a scale nothing else matches.", "", "There is nothing beyond this in the book. Everything you learned on the way, from the first knapped stone, is running somewhere in the plant that feeds it."]
	quest.745263529A3AF0E9.title: "Deuterium"
	quest.745263529A3AF0E9.quest_subtitle: "Cryogenic distillation"
	quest.745263529A3AF0E9.quest_desc: ["Distil liquid hydrogen in a TFMG tower: 1000 mB gives 975 mB of liquid hydrogen and 25 mB of deuterium."]
	chapter.47F53FBD6F007B8F.title: "Logistics"
	chapter.47F53FBD6F007B8F.chapter_subtitle: ["Filters, arms and vaults, then packages: a warehouse that sends what you ask for."]
	quest.7D11188E244E11F4.title: "Smart Chutes"
	quest.7D11188E244E11F4.quest_subtitle: "Filtered falls"
	quest.7D11188E244E11F4.quest_desc: ["A smart chute only lets the items you choose drop through."]
	quest.59F47C2BDDDB91A3.title: "The Weighted Ejector"
	quest.59F47C2BDDDB91A3.quest_subtitle: "Throw it over there"
	quest.59F47C2BDDDB91A3.quest_desc: ["An ejector launches items to a target block a few metres away."]
	quest.0C1FFB3703A4DCF8.title: "Brass Funnels and Tunnels"
	quest.0C1FFB3703A4DCF8.quest_subtitle: "Filtering and splitting"
	quest.0C1FFB3703A4DCF8.quest_desc: ["Brass funnels filter what passes, and brass tunnels split belt traffic evenly.", "", "Put a filter in the funnel to choose what passes."]
	quest.51D8E4A505697E76.title: "The Mechanical Arm"
	quest.51D8E4A505697E76.quest_subtitle: "Pick and place"
	quest.51D8E4A505697E76.quest_desc: ["A precision-built arm moves items between any inputs and outputs in its reach.", "", "With the arm in hand, right-click the blocks it should take from and give to before you place it."]
	quest.215A956B553C03C9.title: "Display Links"
	quest.215A956B553C03C9.quest_subtitle: "Show your stock"
	quest.215A956B553C03C9.quest_desc: ["A display link reads a block and writes to a display board or sign."]
	quest.550C7320B76068BA.title: "The Clipboard"
	quest.550C7320B76068BA.quest_subtitle: "Copy settings"
	quest.550C7320B76068BA.quest_desc: ["Write notes, and copy and paste filter and machine settings."]
	quest.1D4B2D722504DEF9.title: "Cardboard"
	quest.1D4B2D722504DEF9.quest_subtitle: "For packages"
	quest.1D4B2D722504DEF9.quest_desc: ["Pulped paper pressed into cardboard. Packages are made of it."]
	quest.4EBC6001522188A9.title: "The Packager"
	quest.4EBC6001522188A9.quest_subtitle: "Pack it up"
	quest.4EBC6001522188A9.quest_desc: ["A packager wraps items into addressed packages.", "", "Place it against a chest or a vault. On a redstone pulse it packs what is inside, and it unpacks any package that arrives."]
	quest.07DD8605854F9197.title: "The Item Vault"
	quest.07DD8605854F9197.quest_subtitle: "Titanium strongroom"
	quest.07DD8605854F9197.quest_desc: ["Two titanium sheets around a chest make bulk storage that grows with every block you add.", "", "Titanium sheet is forged on a tier VI anvil, so this waits for the end of Metallurgy."]
	quest.7CB8A7EE27913BA0.title: "Package Frogports"
	quest.7CB8A7EE27913BA0.quest_subtitle: "The chain of command"
	quest.7CB8A7EE27913BA0.quest_desc: ["Frogports catch and send packages along chain conveyors."]
	quest.67244B7A451853E3.title: "Stock Links and Tickers"
	quest.67244B7A451853E3.quest_subtitle: "Order from your storage"
	quest.67244B7A451853E3.quest_desc: ["A stock link joins packagers into a network, and a stock ticker lets you order from all of them at once."]
	quest.75F34A2180C6AA50.title: "Redstone Requesters"
	quest.75F34A2180C6AA50.quest_subtitle: "Same-day delivery"
	quest.75F34A2180C6AA50.quest_desc: ["A redstone requester orders a fixed delivery every time it gets a signal."]
	quest.48A945D370E7A101.title: "The Factory Gauge"
	quest.48A945D370E7A101.quest_subtitle: "Automation, reinvented"
	quest.48A945D370E7A101.quest_desc: ["Factory gauges keep stock levels topped up by ordering ingredients and crafting automatically.", "", "&7Hold [W] on a gauge. The demonstration is worth the two minutes."]
	chapter.0B6E45EC9BAEBD74.title: "Agriculture"
	chapter.0B6E45EC9BAEBD74.chapter_subtitle: ["Three things beeswax opens at the top, the greenhouse and its irrigation in the middle, farming machines below."]
	quest.734BC64A6432E519.title: "The Mixing Bowl"
	quest.734BC64A6432E519.quest_subtitle: "Doughs and batters"
	quest.734BC64A6432E519.quest_desc: ["Treated lumber and glue. Lumber is treated with beeswax, so bees come first.", "", "Put a spoon in it, add the ingredients and right-click to mix."]
	quest.51ACA9A9E5D81E94.title: "Pizza"
	quest.51ACA9A9E5D81E94.quest_subtitle: "A finished meal"
	quest.51ACA9A9E5D81E94.quest_desc: ["Pizza dough goes through a mechanical mixer, with oil, salt and basil. Top it with cheese and tomato sauce, then bake it."]
	quest.21401596E6D47D78.title: "A Sugar Cookie"
	quest.21401596E6D47D78.quest_subtitle: "Luxury, in small form"
	quest.21401596E6D47D78.quest_desc: ["Bake a cookie. Upper classes care about this kind of thing."]
	quest.7F784F13348A7FB6.title: "Sealed Bricks"
	quest.7F784F13348A7FB6.quest_subtitle: "A cellar that keeps"
	quest.7F784F13348A7FB6.quest_desc: ["Eight stone bricks and beeswax make eight sealed bricks. Build a cellar with them to keep food and age cheese.", "", "&7Field guide: Firmalife, Cellars."]
	quest.4C081C0A270B2583.title: "The Firmalife Vat"
	quest.4C081C0A270B2583.quest_subtitle: "Stainless, for wine and more"
	quest.4C081C0A270B2583.quest_desc: ["Three stainless steel rods and beeswax."]
	quest.35DE7B7B3F365935.title: "The Greenhouse"
	quest.35DE7B7B3F365935.quest_subtitle: "Your own climate"
	quest.35DE7B7B3F365935.quest_desc: ["Greenhouse walls and a climate station let you grow what your region can't. Fruit, spices and cold-hating crops open up here.", "", "&7Field guide: Firmalife, Greenhouse and Climate Station."]
	task.549CF3076557DFFD.title: "Any Greenhouse Wall"
	quest.72DE01EC1C6FA073.title: "Irrigation"
	quest.72DE01EC1C6FA073.quest_subtitle: "Pipes, pumps and sprinklers"
	quest.72DE01EC1C6FA073.quest_desc: ["Copper pipes, a pumping station and sprinklers keep a greenhouse watered without you.", "", "&7Field guide: Firmalife, Irrigation."]
	quest.49C437A7CF85CBB2.title: "The Mechanical Harvester"
	quest.49C437A7CF85CBB2.quest_subtitle: "Harvest on the move"
	quest.49C437A7CF85CBB2.quest_desc: ["Mounted on a moving contraption, harvesters pick crops as they pass and leave the plant in the ground."]
	quest.76D8CA9A9317998B.title: "The Mechanical Plough"
	quest.76D8CA9A9317998B.quest_subtitle: "Tilling on the move"
	quest.76D8CA9A9317998B.quest_desc: ["A plough on a contraption tills soil as it moves."]
	quest.4C58354A63FE06EE.title: "The Seed Drill"
	quest.4C58354A63FE06EE.quest_subtitle: "Sowing behind a horse"
	quest.4C58354A63FE06EE.quest_desc: ["Pulled by a horse, the seed drill sows a row of seeds as it goes."]
	task.2A09D9CCC5B80733.title: "Any Seed Drill"
	chapter.031B7D874776F795.title: "Transport"
	chapter.031B7D874776F795.chapter_subtitle: ["Railways on the top line, with electric traction above them. Airship parts and road vehicles below."]
	quest.3E5A9E3DFCF4EA22.title: "Train Tracks"
	quest.3E5A9E3DFCF4EA22.quest_subtitle: "Stone and steel, pressed"
	quest.3E5A9E3DFCF4EA22.quest_desc: ["A sequenced assembly: two steel rods on a smooth stone, then press. Tracks need the mechanical press."]
	quest.79147D3C025F735F.title: "The Handcar"
	quest.79147D3C025F735F.quest_subtitle: "Rails by muscle"
	quest.79147D3C025F735F.quest_desc: ["Casings, a cogwheel, an aluminium rod and contraption controls, which need an electron tube. It runs on any track."]
	quest.0C6E38DEB042A686.title: "Train Casing"
	quest.0C6E38DEB042A686.quest_subtitle: "Titanium over wood"
	quest.0C6E38DEB042A686.quest_desc: ["Right-click a stripped log with a titanium sheet.", "", "Stations and signals are built on it."]
	quest.192B14FD9C954D1B.title: "Stations and Signals"
	quest.192B14FD9C954D1B.quest_subtitle: "Where trains stop"
	quest.192B14FD9C954D1B.quest_desc: ["A casing and a compass make two stations. A casing and an electron tube make four signals."]
	quest.6F2677DE69AB3FC6.title: "The Traction Motor"
	quest.6F2677DE69AB3FC6.quest_subtitle: "Electric trains"
	quest.6F2677DE69AB3FC6.quest_desc: ["The Electro Energetics electric motor is a heavy series-wound traction motor: titanium housing, field coils, commutator and graphite brushes. It is the motor that works on a train."]
	quest.7F0C78ECD419B56C.title: "Catenary"
	quest.7F0C78ECD419B56C.quest_subtitle: "Overhead line"
	quest.7F0C78ECD419B56C.quest_desc: ["Catenary holders hook onto nearby poles. Connect the overhead wire to the positive terminal, and the negative to a ground rod: the rails and earth carry the return."]
	quest.3499804F8702214E.title: "Pantograph or Contact Shoe"
	quest.3499804F8702214E.quest_subtitle: "Drawing the current"
	quest.3499804F8702214E.quest_desc: ["A pantograph touches the overhead wire, and a contact shoe rides a third rail. A train needs one of them plus electric motors on board."]
	task.04766B6145CA9675.title: "Any Pantograph or Contact Shoe"
	quest.401444CCB5108E24.title: "Terne Plate"
	quest.401444CCB5108E24.quest_subtitle: "Sturdy sheet"
	quest.401444CCB5108E24.quest_desc: ["Coat a steel heavy sheet with 80 mB of lead and 20 mB of tin, press it, then finish it on a belt grinder. Real fuel tanks were made the same way."]
	quest.2BD9C7CE8C074969.title: "Liquid Fuel"
	quest.2BD9C7CE8C074969.quest_subtitle: "A tank on wheels"
	quest.2BD9C7CE8C074969.quest_desc: ["Sturdy sheet goes into the fuel tank, so your locomotives can burn liquid fuel."]
	quest.30A70A42790719CD.title: "Train Schedules"
	quest.30A70A42790719CD.quest_subtitle: "Trains that drive themselves"
	quest.30A70A42790719CD.quest_desc: ["Sturdy sheet and paper make four schedules. Now your trains don't need you aboard."]
	quest.0FAB8C9EE20D8375.title: "Envelopes"
	quest.0FAB8C9EE20D8375.quest_subtitle: "Lift, at last"
	quest.0FAB8C9EE20D8375.quest_desc: ["Nylon cloth stretched over magnesium rods. Envelopes come out white; right-click them with dye to paint them. They give your first airship its body."]
	task.34F2A19437ABC929.title: "Any Hot Air Envelope"
	quest.4B0A9149EAD22D08.title: "Levitite"
	quest.4B0A9149EAD22D08.quest_subtitle: "Filled with hydrogen"
	quest.4B0A9149EAD22D08.quest_desc: ["A sequenced assembly on magnesium sheet, filled with 125 mB of hydrogen."]
	quest.39FA5E67F94C4C89.title: "Off-Road"
	quest.39FA5E67F94C4C89.quest_subtitle: "Tyres and mounts"
	quest.39FA5E67F94C4C89.quest_desc: ["Rubber tyres and a wheel mount put a contraption on the road without rails."]
	quest.4433C839478DCF32.title: "The Propeller Bearing"
	quest.4433C839478DCF32.quest_subtitle: "Thrust"
	quest.4433C839478DCF32.quest_desc: ["A titanium sheet on a brass casing, with steel springs. Fit propellers and you have a flying machine."]
	quest.5A5D0574E0412953.title: "The Adjustable Burner"
	quest.5A5D0574E0412953.quest_subtitle: "Hot air under control"
	quest.5A5D0574E0412953.quest_desc: ["Titanium bars, sheets, a flarestack and a redstone contact."]
	chapter.3E452A52FF041A83.title: "Warfare"
	chapter.3E452A52FF041A83.chapter_subtitle: ["Gunpowder, a cannon and its mount, shot and charges, and the first shot fired."]
	quest.16276DE4884F98A6.title: "Gunpowder"
	quest.16276DE4884F98A6.quest_subtitle: "Saltpeter, sulfur, charcoal"
	quest.16276DE4884F98A6.quest_desc: ["Hand mixing doesn't work: charcoal, sulfur and saltpeter powder go in a mechanical mixer.", "", "Saltpeter is mined as its own mineral and ground on the quern."]
	quest.1AA265D55DB74F4B.title: "A Log Cannon"
	quest.1AA265D55DB74F4B.quest_subtitle: "Crude and honest"
	quest.1AA265D55DB74F4B.quest_desc: ["A chamber from logs and gunpowder. It won't last, but it fires."]
	quest.26F24B81E408D06B.title: "A Wrought Iron Cannon"
	quest.26F24B81E408D06B.quest_subtitle: "Now you mean it"
	quest.26F24B81E408D06B.quest_desc: ["Wrought iron sheets and gunpowder make a real chamber.", "", "A cannon is a row of blocks: an end, chambers, then barrels. A longer barrel shoots further."]
	quest.1DB8DBC7E1F3EF25.title: "The Cannon Mount"
	quest.1DB8DBC7E1F3EF25.quest_subtitle: "Aim is everything"
	quest.1DB8DBC7E1F3EF25.quest_desc: ["Casing, shafts, sheets and gunpowder.", "", "Set the cannon on the mount and give it a redstone signal to assemble it. Shafts on the mount aim it."]
	quest.3FF3EF2E089366FD.title: "The Cannon Loader"
	quest.3FF3EF2E089366FD.quest_subtitle: "Reload from behind"
	quest.3FF3EF2E089366FD.quest_desc: ["Automates what you'd otherwise do with a ram rod."]
	quest.3A02C3AF5EF8A626.title: "A Powder Charge"
	quest.3A02C3AF5EF8A626.quest_subtitle: "Pack it in wool"
	quest.3A02C3AF5EF8A626.quest_desc: ["Packed gunpowder in a bag of wool and yarn. Packing the powder needs a press."]
	quest.47329180A125AF4D.title: "Solid Shot"
	quest.47329180A125AF4D.quest_subtitle: "Iron and wood"
	quest.47329180A125AF4D.quest_desc: ["Four iron ingots, a wooden slab and wrought iron rods."]
	quest.2ECBBE5974A9AE1A.title: "Fire!"
	quest.2ECBBE5974A9AE1A.quest_subtitle: "Test it somewhere empty"
	quest.2ECBBE5974A9AE1A.quest_desc: ["Load a charge and shot, then fire. Point it away from your base.", "", "&7The charge goes in first, then the shot. The ponders of Create Big Cannons show the loading order."]
	quest.13D70522CCB261AB.title: "High Explosive"
	quest.13D70522CCB261AB.quest_subtitle: "The endgame of argument"
	quest.13D70522CCB261AB.quest_desc: ["An HE shell with a fuze. It is heavy on acid and steel, so expect to work for it."]
	chapter.51C2F3F650A42A93.title: "Settlers \\& Society"
	chapter.51C2F3F650A42A93.chapter_subtitle: ["The Leader's Staff, the first settlers and their needs, then workers, specialists, elites, trade and a leader."]
	quest.1FC6CBDDE010ADA1.title: "The Leader's Staff"
	quest.1FC6CBDDE010ADA1.quest_subtitle: "Gold and silver"
	quest.1FC6CBDDE010ADA1.quest_desc: ["Gold ingots and silver rods. It marks you as the one Xoonglins answer to."]
	quest.48BC22C8550CA7C8.title: "Neighbours"
	quest.48BC22C8550CA7C8.quest_subtitle: "For server players"
	quest.48BC22C8550CA7C8.quest_desc: ["On a server, a smith, a farmer and a chemist together move faster than any one of them. Share an anvil, swap goods, or start a team."]
	quest.6C48A50675BC6BEF.title: "First Settlers"
	quest.6C48A50675BC6BEF.quest_subtitle: "Hands before anything"
	quest.6C48A50675BC6BEF.quest_desc: ["Xoonglins of the lowest class settle where their climate suits them. Each culture has its own temperature and rainfall, so your region decides who comes.", "", "&7Field guide: Materialism Guide, Society \\& Settlement has a page for each climate."]
	quest.0120F8322D7DEAE6.title: "A Roof and a Fire"
	quest.0120F8322D7DEAE6.quest_subtitle: "Basic needs first"
	quest.0120F8322D7DEAE6.quest_desc: ["Give them a small home, water and a fire. Check what they ask for: every class lists its needs."]
	quest.2EEBC3F7DC2EDE02.title: "Feed Your People"
	quest.2EEBC3F7DC2EDE02.quest_subtitle: "Flatbread is a start"
	quest.2EEBC3F7DC2EDE02.quest_desc: ["Early classes want simple food and clothing. Later ones want bread, preserves, milk and fuel."]
	quest.6AEC8A0EC4E84285.title: "Workers"
	quest.6AEC8A0EC4E84285.quest_subtitle: "Farmers and fishers"
	quest.6AEC8A0EC4E84285.quest_desc: ["Happy settlers rise to the next class and take on real jobs. Workers produce goods. Remember that nothing here creates matter: crafters use what you give them."]
	quest.572AC44401414CC6.title: "Specialists"
	quest.572AC44401414CC6.quest_subtitle: "Guards and crafters"
	quest.572AC44401414CC6.quest_desc: ["Workplaces, tools and a little ritual. Guards take your armour and weapons, so a forge pays for itself here."]
	quest.64CDB5D474329162.title: "Elites"
	quest.64CDB5D474329162.quest_subtitle: "Priests and master crafters"
	quest.64CDB5D474329162.quest_desc: ["Cheese, aged drink, fine clothes and imported goods. Elites want what your own region can't make."]
	quest.5C2F63EC356843F7.title: "Trade"
	quest.5C2F63EC356843F7.quest_subtitle: "Other climates, other goods"
	quest.5C2F63EC356843F7.quest_desc: ["No culture can feed its elites alone. Found a second settlement in another climate, or trade with a neighbour on your server. A cart road or a railway connects them."]
	quest.25B3AF87D25C1714.title: "A Leader"
	quest.25B3AF87D25C1714.quest_subtitle: "The end of the wealth ladder"
	quest.25B3AF87D25C1714.quest_desc: ["One leader per settlement, and the most expensive needs in the game. Their grand rites use imported luxuries to lift everybody's happiness."]
}
